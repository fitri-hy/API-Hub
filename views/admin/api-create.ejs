<%
pageHead = `
<style>
  @media (max-width: 640px) {
    .api-docs-editor.CodeMirror {
      font-size: 12px;
    }
  }
</style>
`;
%>

<div data-aos="zoom-in" class="card p-5">
  <div class="pb-4 border-b border-gray-200/70 dark:border-gray-800/70">
	<div class="flex items-center gap-4">
		<a href="/admin/apis" class="group flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-white border border-gray-200/70 dark:border-gray-800/70 hover:bg-gray-100 dark:hover:bg-slate-800 dark:bg-slate-900" title="Back to users">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none">
				<path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
			</svg>
		</a>
		<div>
			<h3 class="text-base font-bold">Create New API Service</h3>
			<p class="text-sm">Define the API metadata. Add routes and handlers after creation.</p>
		</div>
	</div>
  </div>

  <form method="POST" action="/admin/apis/create" id="apiCreateForm" class="space-y-4 mt-4">
    <div class="grid grid-cols-1 gap-5">
      <div class="max-w-xs">
        <label for="apiName" class="block font-semibold mb-1.5">
          API Name <span class="text-red-600">*</span>
        </label>
        <input type="text" id="apiName" name="name" required placeholder="eg: User Management API" 
			class="bg-form px-4 py-2 w-full" >
      </div>
      <div class="max-w-xl">
        <label for="description" class="block font-semibold mb-1.5">Description</label>
        <textarea id="description" name="description" rows="3" placeholder="Write a brief description of this API's function..."
			class="bg-form px-4 py-2 w-full"></textarea>
      </div>
    </div>

    <div class="flex flex-wrap gap-4">
      <div>
        <label for="version" class="block font-semibold mb-1.5">Version</label>
        <input type="text" id="version" name="version" value="1.0.0" class="bg-form px-4 py-2 w-fullo">
      </div>
      <div>
        <label for="credit_cost" class="block font-semibold mb-1.5">
          Credit Cost / Request <span class="text-red-600">*</span>
        </label>
        <input type="number" id="credit_cost" name="credit_cost" value="1" min="0" required class="bg-form px-4 py-2 w-full">
      </div>
      <div>
        <label for="rate_limit_per_minute" class="block font-semibold mb-1.5">Rate Limit (req/min)</label>
        <input type="number" id="rate_limit_per_minute" name="rate_limit_per_minute" value="100" min="1" max="500" class="bg-form px-4 py-2 w-full">
      </div>
    </div>
	<div class="flex">
      <div>
        <label for="status" class="block font-semibold mb-1.5">Status</label>
        <select id="status" name="status" class="bg-form px-4 py-2 w-full">
          <option value="draft">Draft</option>
          <option value="active">Active</option>
          <option value="inactive">Inactive</option>
        </select>
      </div>
    </div>

    <div class="flex flex-wrap gap-4 pt-4">
      <label for="auth_required" class="w-sm relative flex items-center justify-between p-4 bg-form">
        <div class="flex items-center gap-2">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-100 dark:bg-indigo-900 text-indigo-600 dark:text-indigo-200">
            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
              <path d="M0 0h24v24H0z" fill="none"></path>
              <g fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.5 7.5L12 11m0 0l-3.5 3.5M12 11l3.5 3.5M12 11l-3.5-3.5"></path>
                <circle cx="12" cy="12" r="10"></circle>
              </g>
            </svg>
          </div>
          <div>
            <span class="block font-semibold">Require API Key</span>
            <span class="block text-sm">The client is required to include an API token.</span>
          </div>
        </div>
        <input type="checkbox" id="auth_required" name="auth_required" value="1" checked class="h-4 w-4 rounded cursor-pointer">
      </label>

      <label for="is_public" class="w-sm relative flex items-center justify-between p-4 bg-form">
        <div class="flex items-center gap-2">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-100 dark:bg-indigo-900 text-indigo-600 dark:text-indigo-200">
            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
              <path d="M0 0h24v24H0z" fill="none"></path>
              <g fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"></circle>
                <path stroke-linecap="round" stroke-linejoin="round" d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </g>
            </svg>
          </div>
          <div>
            <span class="block font-semibold">Public Visibility</span>
            <span class="block text-sm">Display the API in the public directory</span>
          </div>
        </div>
        <input type="checkbox" id="is_public" name="is_public" value="1" checked class="h-4 w-4 rounded cursor-pointer">
      </label>
    </div>

    <div class="flex items-center justify-end gap-4 pt-4 border-t border-gray-200/70 dark:border-gray-800/70">
      <a href="/admin/apis" class="flex items-center gap-1 btn-failed px-4 py-2 rounded-md">
		<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24">
			<path d="M0 0h24v24H0z" fill="none" />
			<g fill="currentColor">
				<path d="M5.53717 19.5302C5.24427 19.8231 4.7694 19.8231 4.47651 19.5302C4.18361 19.2373 4.18361 18.7624 4.47651 18.4696L18.4764 4.46967C18.7693 4.17678 19.2442 4.17678 19.5371 4.46967C19.8299 4.76256 19.8299 5.23744 19.5371 5.53033L5.53717 19.5302Z" />
				<path d="M4.46978 5.53033C4.17689 5.23744 4.17689 4.76256 4.46978 4.46967C4.76268 4.17678 5.23755 4.17678 5.53044 4.46967L19.5303 18.4696C19.8232 18.7624 19.8232 19.2373 19.5303 19.5302C19.2374 19.8231 18.7626 19.8231 18.4697 19.5302L4.46978 5.53033Z" />
			</g>
		</svg>
        Cancel
      </a>
	  <button type="submit" class="flex items-center gap-1 btn-normal px-4 py-2 rounded-md">
		<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24">
			<path d="M0 0h24v24H0z" fill="none" />
			<g fill="none" stroke="currentColor" stroke-width="1.5">
				<path d="M3.46447 20.5355C4.92893 22 7.28595 22 12 22C16.714 22 19.0711 22 20.5355 20.5355C22 19.0711 22 16.714 22 12C22 11.6585 22 11.4878 21.9848 11.3142C21.9142 10.5049 21.586 9.71257 21.0637 9.09034C20.9516 8.95687 20.828 8.83317 20.5806 8.58578L15.4142 3.41944C15.1668 3.17206 15.0431 3.04835 14.9097 2.93631C14.2874 2.414 13.4951 2.08581 12.6858 2.01515C12.5122 2 12.3415 2 12 2C7.28595 2 4.92893 2 3.46447 3.46447C2 4.92893 2 7.28595 2 12C2 16.714 2 19.0711 3.46447 20.5355Z" />
				<path d="M17 22V21C17 19.1144 17 18.1716 16.4142 17.5858C15.8284 17 14.8856 17 13 17H11C9.11438 17 8.17157 17 7.58579 17.5858C7 18.1716 7 19.1144 7 21V22" />
				<path stroke-linecap="round" d="M7 8H13" />
			</g>
		</svg>
        Create
      </button>
    </div>
  </form>
</div>
