<div class="space-y-4">

  <!-- Referral Stats Cards -->
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <!-- Total Referrals -->
    <div class="card flex flex-col justify-between p-5">
      <div class="flex items-start justify-between">
        <div>
          <h6 class="whitespace-nowrap text-xs font-semibold uppercase tracking-wider">Total Referrals</h6>
          <h2 class="mt-2 text-2xl font-bold tracking-tight"><%= helpers.formatNumber(stats.totalReferrals) %></h2>
        </div>
        <div class="flex h-10 w-10 items-center justify-center rounded-md bg-blue-100 dark:bg-blue-900 text-blue-600 dark:text-blue-200">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- Today's Referrals -->
    <div class="card flex flex-col justify-between p-5">
      <div class="flex items-start justify-between">
        <div>
          <h6 class="whitespace-nowrap text-xs font-semibold uppercase tracking-wider">Today</h6>
          <h2 class="mt-2 text-2xl font-bold tracking-tight"><%= helpers.formatNumber(stats.todayReferrals) %></h2>
        </div>
        <div class="flex h-10 w-10 items-center justify-center rounded-md bg-emerald-100 dark:bg-emerald-900 text-emerald-600 dark:text-emerald-200">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- Active Referrers -->
    <div class="card flex flex-col justify-between p-5">
      <div class="flex items-start justify-between">
        <div>
          <h6 class="whitespace-nowrap text-xs font-semibold uppercase tracking-wider">Active Referrers</h6>
          <h2 class="mt-2 text-2xl font-bold tracking-tight"><%= helpers.formatNumber(stats.activeReferrers) %></h2>
        </div>
        <div class="flex h-10 w-10 items-center justify-center rounded-md bg-purple-100 dark:bg-purple-900 text-purple-600 dark:text-purple-200">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- Credits Awarded -->
    <div class="card flex flex-col justify-between p-5">
      <div class="flex items-start justify-between">
        <div>
          <h6 class="whitespace-nowrap text-xs font-semibold uppercase tracking-wider">Credits Awarded</h6>
          <h2 class="mt-2 text-2xl font-bold tracking-tight"><%= helpers.formatNumber(stats.totalCreditsAwarded) %></h2>
        </div>
        <div class="flex h-10 w-10 items-center justify-center rounded-md bg-amber-100 dark:bg-amber-900 text-amber-600 dark:text-amber-200">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Referral Table -->
  <div class="card">
    <div class="p-5">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
		<div>
	      <h3 class="text-sm font-bold">Referral History</h3>
  	      <p class="mt-0.5 text-xs font-medium">Track invited users and earned rewards.</p>
	    </div>
        <form method="GET" action="/admin/referrals" class="flex gap-2">
          <input type="text" name="search" value="<%= filters.search %>" placeholder="Search username or email..."
            class="px-4 py-2 text-sm rounded-md bg-form border border-gray-200/70 dark:border-gray-800/70 focus:outline-none focus:ring-2 focus:ring-blue-500">
          <button type="submit" class="p-2 text-sm rounded-md btn-normal">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </button>
        </form>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200/70 dark:border-gray-800/70">
            <th class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wider">Referrer</th>
            <th class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wider">Referred User</th>
            <th class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wider">Credits</th>
            <th class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wider">Status</th>
            <th class="px-4 py-2 text-left text-xs font-semibold uppercase tracking-wider">Date</th>
          </tr>
        </thead>
        <tbody>
          <% if (referrals.length === 0) { %>
            <tr>
              <td colspan="5" class="px-5 py-12 text-center">
                  <p>No referrals found</p>
                </div>
              </td>
            </tr>
          <% } else { %>
            <% referrals.forEach(function(r) { %>
              <tr class="border-b border-gray-100/70 dark:border-gray-800/50 hover:bg-gray-50/50 dark:hover:bg-gray-900/50">
                <td class="px-4 py-2">
                  <div>
                    <div class="font-medium"><%= r.referrer_name || r.referrer_username %></div>
                    <div class="text-xs"><%= r.referrer_email %></div>
                  </div>
                </td>
                <td class="px-4 py-2">
                  <div>
                    <div class="font-medium"><%= r.referred_name || r.referred_username %></div>
                    <div class="text-xs"><%= r.referred_email %></div>
                  </div>
                </td>
                <td class="px-4 py-2">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-600 dark:bg-emerald-900/20 dark:text-emerald-400 border border-emerald-200/70 dark:border-emerald-500/20">
                    +<%= helpers.formatNumber(r.credits_awarded) %>
                  </span>
                </td>
                <td class="px-4 py-2">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= helpers.statusBadgeClass(r.status) %>">
                    <%= r.status %>
                  </span>
                </td>
                <td class="px-4 py-2">
                  <%= helpers.formatDate(r.created_at, 'datetime') %>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
	<% if (pagination.totalPages > 1) { %>
		<div class="flex items-center justify-between gap-4 border-t border-gray-200/70 dark:border-gray-800/70 mt-2 p-2">
			<p class="text-xs">
				Showing 
				<span class="font-medium"><%= (pagination.currentPage - 1) * pagination.perPage + 1 %>-<%= Math.min(pagination.currentPage * pagination.perPage, pagination.total) %></span>
				from
				<span class="font-medium"><%= pagination.total %></span>
			</p>

			<nav class="flex items-center gap-1">
				<% pagination.pages.forEach(function(p) { %>
					<% if (p === '...') { %>
						<span class="flex h-8 min-w-8 items-center justify-center px-1 text-xs">...</span>
					<% } else { %>
						<a href="?page=<%= p %>&search=<%= filters.search %>&role=<%= filters.role %>&status=<%= filters.status %>"
							class="flex h-6 min-w-6 items-center justify-center rounded p-1 text-xs font-medium
							<%= p === pagination.currentPage
								? 'bg-blue-500 dark:bg-blue-600 text-white'
								: 'bg-gray-200 hover:bg-gray-300 dark:bg-gray-800 dark:hover:bg-gray-700' %>">
							<%= p %>
						</a>
					<% } %>
				<% }); %>
			</nav>
		</div>
	<% } %>
  </div>
</div>
