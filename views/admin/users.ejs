<!-- Search & Filter -->
<div class="card px-4 py-3 mb-4">
	<form method="GET" action="/admin/users" class="flex flex-col lg:flex-row w-full gap-4">
		<div data-aos="zoom-in" class="flex-1 w-full min-w-[200px]">
			<label class="block text-xs font-medium mb-1">Search</label>
			<input type="text" name="search" value="<%= filters.search %>" placeholder="Username, email, name..."
				class="w-full px-4 py-2 bg-form">
		</div>
		<div class="flex flex-wrap items-center items-end gap-4">
		<div data-aos="zoom-in">
			<label class="block text-xs font-medium mb-1">Role</label>
			<select name="role" class="px-4 py-2 bg-form">
				<option value="">All</option>
				<option value="admin" <%= filters.role === 'admin' ? 'selected' : '' %>>Admin</option>
				<option value="user" <%= filters.role === 'user' ? 'selected' : '' %>>User</option>
			</select>
		</div>
      <div data-aos="zoom-in" >
        <label class="block text-xs font-medium mb-1">Status</label>
        <select name="status" class="px-4 py-2 bg-form">
          <option value="">All</option>
          <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
          <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
        </select>
      </div>
	  <div data-aos="zoom-in" class="flex items-center gap-1">
        <button type="submit" class="p-2 rounded-md btn-normal">
		  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24">
			<path d="M0 0h24v24H0z" fill="none" />
			<path fill="none" stroke="currentColor" stroke-width="1.5" d="M19 3H5C3.58579 3 2.87868 3 2.43934 3.4122C2 3.8244 2 4.48782 2 5.81466V6.50448C2 7.54232 2 8.06124 2.2596 8.49142C2.5192 8.9216 2.99347 9.18858 3.94202 9.72255L6.85504 11.3624C7.49146 11.7206 7.80967 11.8998 8.03751 12.0976C8.51199 12.5095 8.80408 12.9935 8.93644 13.5872C9 13.8722 9 14.2058 9 14.8729L9 17.5424C9 18.452 9 18.9067 9.25192 19.2613C9.50385 19.6158 9.95128 19.7907 10.8462 20.1406C12.7248 20.875 13.6641 21.2422 14.3321 20.8244C15 20.4066 15 19.4519 15 17.5424V14.8729C15 14.2058 15 13.8722 15.0636 13.5872C15.1959 12.9935 15.488 12.5095 15.9625 12.0976C16.1903 11.8998 16.5085 11.7206 17.145 11.3624L20.058 9.72255C21.0065 9.18858 21.4808 8.9216 21.7404 8.49142C22 8.06124 22 7.54232 22 6.50448V5.81466C22 4.48782 22 3.8244 21.5607 3.4122C21.1213 3 20.4142 3 19 3Z" />
		  </svg>
	    </button>
		<% if (typeof filters !== 'undefined' && (filters.search || filters.role || filters.status)) { %>
        <a href="/admin/users" class="p-2 rounded-md btn-failed">
		  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24">
			<path d="M0 0h24v24H0z" fill="none" />
			<path fill="currentColor" d="M18.2577 3.50828C18.538 3.62437 18.7207 3.89785 18.7207 4.20119V8.44383C18.7207 8.85805 18.3849 9.19383 17.9707 9.19383H13.728C13.4247 9.19383 13.1512 9.0111 13.0351 8.73085C12.9191 8.45059 12.9832 8.128 13.1977 7.9135L14.8007 6.3105C12.1674 5.20912 9.01606 5.7309 6.87348 7.87348C4.04217 10.7048 4.04217 15.2952 6.87348 18.1265C9.70478 20.9578 14.2952 20.9578 17.1265 18.1265C18.7727 16.4803 19.4622 14.2401 19.1935 12.0937C19.142 11.6827 19.4335 11.3078 19.8445 11.2563C20.2555 11.2049 20.6304 11.4963 20.6819 11.9073C21.0057 14.4934 20.1746 17.1997 18.1872 19.1872C14.7701 22.6043 9.2299 22.6043 5.81282 19.1872C2.39573 15.7701 2.39573 10.2299 5.81282 6.81282C8.55119 4.07444 12.6515 3.5312 15.9309 5.18028L17.4404 3.67086C17.6549 3.45637 17.9774 3.3922 18.2577 3.50828Z" />
		  </svg>
	    </a>
		<% } %>
      </div>
    </form>
  </div>
</div>

<!-- Users Table -->
<div class="card overflow-hidden">
	<div class="overflow-x-auto">
		<table class="w-full">
			<thead>
				<tr data-aos="zoom-in" class="text-xs font-medium uppercase tracking-wider border-b border-gray-200/70 dark:border-gray-800/70">
					<th class="px-6 py-3 text-left">User</th>
					<th class="px-6 py-3 text-center">Credits</th>
					<th class="px-6 py-3 text-center">Package</th>
					<th class="px-6 py-3 text-center">Role</th>
					<th class="px-6 py-3 text-center">Verified</th>
					<th class="px-6 py-3 text-center">Status</th>
					<th class="px-6 py-3 text-left">Joined</th>
					<th class="px-6 py-3 text-right">Actions</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-gray-200/70 dark:divide-gray-800/70">
				<% users.forEach(function(u) { %>
					<tr data-aos="zoom-in" class="table-row-hover">
						<td class="px-4 py-2">
							<div class="flex items-center gap-3">
								<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-orange-200 dark:bg-orange-900">
									<% if (u.avatar) { %>
										<% 
										  let avatarUrl = u.avatar;
										  if (!avatarUrl.startsWith('http') && !avatarUrl.startsWith('/')) {
											  avatarUrl = (avatarUrl.startsWith('uploads/') ? '/' : '/uploads/avatars/') + avatarUrl;
										  }
										%>
										<img src="<%= avatarUrl %>" alt="Avatar" class="h-full w-full object-cover rounded-full">
									<% } else { %>
										<span class="text-sm font-bold text-orange-700 dark:text-orange-200">
											<%= u.full_name ? u.full_name.charAt(0).toUpperCase() : 'U' %>
										</span>
									<% } %>
								</div>
								<div class="min-w-0">
									<h6 class="truncate text-sm font-medium"><%= u.full_name || '-' %></h6>
									<p class="truncate text-xs"><%= u.email %></p>
								</div>
							</div>
						</td>

						<td class="px-4 py-2 text-center text-sm font-medium">
							<%= helpers.formatNumber(u.credit_balance) %>
						</td>

						<td class="px-4 py-2">
							<div class="flex justify-center">
								<span class="inline-flex rounded-full bg-gray-200 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider dark:bg-gray-700">
									<%= u.package_name || 'Basic' %>
								</span>
							</div>
						</td>

						<td class="px-4 py-2">
							<div class="flex justify-center">
								<span class="inline-flex rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider <%= u.role === 'admin' ? 'bg-purple-100 dark:bg-purple-900' : 'bg-blue-100 dark:bg-blue-900' %>">
									<%= u.role %>
								</span>
							</div>
						</td>

						<td class="px-4 py-2">
							<div class="flex items-center justify-center">
								<span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium <%= helpers.verificationBadgeClass(u.is_verified ? 'verified' : (u.hasPendingVerification ? 'pending' : 'unverified')) %>">
									<% if (u.is_verified) { %>
										<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
											<path d="M0 0h24v24H0z" fill="none" />
											<path fill="currentColor" d="M19.965 8.521Q20 8.26 20 8c0-2.379-2.143-4.288-4.521-3.965C14.786 2.802 13.466 2 12 2s-2.786.802-3.479 2.035C6.138 3.712 4 5.621 4 8q0 .26.035.521C2.802 9.215 2 10.535 2 12s.802 2.785 2.035 3.479A4 4 0 0 0 4 16c0 2.379 2.138 4.283 4.521 3.965C9.214 21.198 10.534 22 12 22s2.786-.802 3.479-2.035C17.857 20.283 20 18.379 20 16q0-.26-.035-.521C21.198 14.785 22 13.465 22 12s-.802-2.785-2.035-3.479m-9.01 7.895l-3.667-3.714l1.424-1.404l2.257 2.286l4.327-4.294l1.408 1.42z" />
										</svg>
										Verified
									<% } else if (u.hasPendingVerification) { %>
										<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" class="text-amber-500">
											<path d="M0 0h24v24H0z" fill="none" />
											<path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2m-2 15v-2h2v2zm0-4V7h2v6z" />
										</svg>
										Pending
									<% } else { %>
										Unverified
									<% } %>
								</span>
							</div>
						</td>

						<td class="px-4 py-2">
							<div class="flex items-center justify-center">
								<span class="inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs font-medium <%= u.is_active ? 'bg-emerald-100 dark:bg-emerald-900' : 'bg-rose-100 dark:bg-rose-900' %>">
									<span class="h-1.5 w-1.5 rounded-full <%= u.is_active ? 'bg-emerald-600' : 'bg-rose-600' %>"></span>
									<%= u.is_active ? 'Active' : 'Inactive' %>
								</span>
							</div>
						</td>

						<td class="px-4 py-2 text-xs">
							<%= helpers.formatDate(u.created_at, 'date') %>
						</td>

						<td class="px-4 py-2">
							<div class="flex justify-end">
								<a href="/admin/users/<%= u.uuid %>" class="link flex items-center gap-1">
									Detail
									<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none">
										<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M18 15V6H9"/>
									</svg>
								</a>
							</div>
						</td>
					</tr>
				<% }); %>

				<% if (users.length === 0) { %>
					<tr data-aos="zoom-in">
						<td colspan="8" class="px-6 py-12 text-center text-sm">
							No data found.
						</td>
					</tr>
				<% } %>
			</tbody>
		</table>
	</div>

	<% if (pagination.totalPages > 1) { %>
		<div class="flex items-center justify-between gap-4 border-t border-gray-200/70 dark:border-gray-800/70 mt-2 p-2">
			<p class="text-xs">
				Showing 
				<span class="font-medium"><%= (pagination.currentPage - 1) * pagination.perPage + 1 %>-<%= Math.min(pagination.currentPage * pagination.perPage, pagination.total) %></span>
				from
				<span class="font-medium"><%= pagination.total %></span>
			</p>

			<nav class="flex items-center gap-1">
				<% pagination.pages.forEach(function(p) { %>
					<% if (p === '...') { %>
						<span class="flex h-8 min-w-8 items-center justify-center px-1 text-xs">...</span>
					<% } else { %>
						<a href="?page=<%= p %>&search=<%= filters.search %>&role=<%= filters.role %>&status=<%= filters.status %>"
							class="flex h-6 min-w-6 items-center justify-center rounded p-1 text-xs font-medium
							<%= p === pagination.currentPage
								? 'bg-blue-500 dark:bg-blue-600 text-white'
								: 'bg-gray-200 hover:bg-gray-300 dark:bg-gray-800 dark:hover:bg-gray-700' %>">
							<%= p %>
						</a>
					<% } %>
				<% }); %>
			</nav>
		</div>
	<% } %>
</div>
