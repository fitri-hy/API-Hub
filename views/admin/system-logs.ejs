<div class="card">
	<div class="p-5 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
		<div>
	      <h3 data-aos="zoom-in" class="text-sm font-bold">List Activity</h3>
  	      <p data-aos="zoom-in" class="mt-0.5 text-xs font-medium">View your recent actions and system events.</p>
	    </div>
		<div class="flex items-center gap-2 flex-wrap">
			<form data-aos="zoom-in" method="GET" action="/admin/system-logs" class="flex items-center flex-wrap gap-2 w-full flex-1">
				<select name="action" class="w-full flex-1 bg-form px-3 py-2 text-sm">
				  <option value="">All</option>
				  <% actions.forEach(function(a) { %>
					<option value="<%= a %>" <%= filters.action === a ? 'selected' : '' %>><%= a %></option>
				  <% }); %>
				</select>
				<button type="submit"class="btn-normal p-2 rounded-md">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24">
						<path d="M0 0h24v24H0z" fill="none" />
						<path fill="none" stroke="currentColor" stroke-width="1.5" d="M19 3H5C3.58579 3 2.87868 3 2.43934 3.4122C2 3.8244 2 4.48782 2 5.81466V6.50448C2 7.54232 2 8.06124 2.2596 8.49142C2.5192 8.9216 2.99347 9.18858 3.94202 9.72255L6.85504 11.3624C7.49146 11.7206 7.80967 11.8998 8.03751 12.0976C8.51199 12.5095 8.80408 12.9935 8.93644 13.5872C9 13.8722 9 14.2058 9 14.8729L9 17.5424C9 18.452 9 18.9067 9.25192 19.2613C9.50385 19.6158 9.95128 19.7907 10.8462 20.1406C12.7248 20.875 13.6641 21.2422 14.3321 20.8244C15 20.4066 15 19.4519 15 17.5424V14.8729C15 14.2058 15 13.8722 15.0636 13.5872C15.1959 12.9935 15.488 12.5095 15.9625 12.0976C16.1903 11.8998 16.5085 11.7206 17.145 11.3624L20.058 9.72255C21.0065 9.18858 21.4808 8.9216 21.7404 8.49142C22 8.06124 22 7.54232 22 6.50448V5.81466C22 4.48782 22 3.8244 21.5607 3.4122C21.1213 3 20.4142 3 19 3Z" />
					</svg>
				</button>
			</form>
			<form data-aos="zoom-in" method="POST" action="/admin/system-logs/clear" onsubmit="return confirm('Hapus SEMUA system logs? Tindakan ini tidak bisa dibatalkan.')">
				<button type="submit" class="btn-failed p-2 rounded-md">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24">
						<path d="M0 0h24v24H0z" fill="none" />
						<g fill="none" stroke="currentColor" stroke-width="1.5">
						<path stroke-linecap="round" d="M20.5001 6H3.5" />
						<path stroke-linecap="round" d="M18.8332 8.5L18.3732 15.3991C18.1962 18.054 18.1077 19.3815 17.2427 20.1907C16.3777 21 15.0473 21 12.3865 21H11.6132C8.95235 21 7.62195 21 6.75694 20.1907C5.89194 19.3815 5.80344 18.054 5.62644 15.3991L5.1665 8.5" />
						<path d="M6.5 6C6.55588 6 6.58382 6 6.60915 5.99936C7.43259 5.97849 8.15902 5.45491 8.43922 4.68032C8.44784 4.65649 8.45667 4.62999 8.47434 4.57697L8.57143 4.28571C8.65431 4.03708 8.69575 3.91276 8.75071 3.8072C8.97001 3.38607 9.37574 3.09364 9.84461 3.01877C9.96213 3 10.0932 3 10.3553 3H13.6447C13.9068 3 14.0379 3 14.1554 3.01877C14.6243 3.09364 15.03 3.38607 15.2493 3.8072C15.3043 3.91276 15.3457 4.03708 15.4286 4.28571L15.5257 4.57697C15.5433 4.62992 15.5522 4.65651 15.5608 4.68032C15.841 5.45491 16.5674 5.97849 17.3909 5.99936C17.4162 6 17.4441 6 17.5 6" />
						</g>
					</svg>
				</button>
			</form>
		</div>
	</div>
 <div class="overflow-x-auto">
    <table class="w-full">
      <thead>
        <tr data-aos="zoom-in" class="text-xs font-medium uppercase tracking-wider border-b border-gray-200/70 dark:border-gray-800/70">
          <th class="px-4 py-2 text-left">Time</th>
          <th class="px-4 py-2 text-left">User</th>
          <th class="px-4 py-2 text-left">Action</th>
          <th class="px-4 py-2 text-left">Detail</th>
          <th class="px-4 py-2 text-left">IP</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200/70 dark:divide-gray-800/70">
        <% logs.forEach(function(log) { %>
          <tr data-aos="zoom-in">
            <td class="px-4 py-2 text-xs whitespace-nowrap"><%= helpers.formatDate(log.created_at, 'datetime') %></td>
			<td class="px-4 py-2">
				<div class="flex items-center gap-3">
					<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full overflow-hidden bg-orange-200 dark:bg-orange-900">
						<% if (log.avatar) { %>
							<% 
							  let avatarUrl = log.avatar;
							  if (!avatarUrl.startsWith('http') && !avatarUrl.startsWith('/')) {
								  avatarUrl = (avatarUrl.startsWith('uploads/') ? '/' : '/uploads/avatars/') + avatarUrl;
							  }
							%>
							<img src="<%= avatarUrl %>" alt="Avatar" class="h-full w-full object-cover rounded-full">
						<% } else { %>
							<span class="text-sm font-bold text-orange-700 dark:text-orange-200">
								<%= log.username ? log.username.charAt(0).toUpperCase() : 'S' %>
							</span>
						<% } %>
					</div>
					<div class="min-w-0">
						<div class="text-sm font-medium"><%= log.username || 'System' %></div>
						<% if (log.email) { %><div class="text-[10px] text-gray-500"><%= log.email %></div><% } %>
					</div>
				</div>
			</td>
            <td class="px-4 py-2">
				<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium <%= helpers.statusBadgeClass(
					log.action.includes('delete') ? 'delete' :
					log.action.includes('create') ? 'create' :
					log.action.includes('update') ? 'update' :
					log.action.includes('login') ? 'login' :
					log.action.includes('clear') ? 'clear' : 'draft'
				) %>">
					<%= log.action %>
				</span>
            </td>
			<td class="px-4 py-2 text-xs max-w-xs truncate">
			  <% if (log.details !== null && log.details !== undefined && log.details !== '') { %>

				<%
				  let details = log.details;

				  // Kalau dari database berupa JSON string, parse dulu
				  if (typeof details === 'string') {
					try {
					  details = JSON.parse(details);
					} catch (e) {
					  // Bukan JSON, tetap sebagai string
					}
				  }
				%>

				<% if (details && typeof details === 'object' && !Array.isArray(details)) { %>

				  <% Object.keys(details).forEach(function(k) { %>
					<span class="inline-block font-mono bg-gray-200 dark:bg-gray-800 rounded px-1.5 py-0.5 mr-1 mb-0.5">
					  <%= k %>:
					  <%= typeof details[k] === 'object'
						? JSON.stringify(details[k])
						: details[k] %>
					</span>
				  <% }); %>

				<% } else { %>

				  <%= String(details).substring(0, 80) %>

				<% } %>

			  <% } else { %>
				-
			  <% } %>
			</td>
            <td class="px-4 py-2 text-xs font-mono"><%= log.ip_address || '-' %></td>
          </tr>
        <% }); %>
        <% if (logs.length === 0) { %>
          <tr data-aos="zoom-in"><td colspan="5" class="px-6 py-12 text-sm text-center">No data found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
	<% if (pagination.totalPages > 1) { %>
		<div class="flex items-center justify-between gap-4 border-t border-gray-200/70 dark:border-gray-800/70 mt-2 p-2">
			<p class="text-xs">
				Showing 
				<span class="font-medium"><%= (pagination.currentPage - 1) * pagination.perPage + 1 %>-<%= Math.min(pagination.currentPage * pagination.perPage, pagination.total) %></span>
				from
				<span class="font-medium"><%= pagination.total %></span>
			</p>

			<nav class="flex items-center gap-1">
				<% pagination.pages.forEach(function(p) { %>
					<% if (p === '...') { %>
						<span class="flex h-8 min-w-8 items-center justify-center px-1 text-xs">...</span>
					<% } else { %>
						<a href="?page=<%= p %>&search=<%= filters.search %>&role=<%= filters.role %>&status=<%= filters.status %>"
							class="flex h-6 min-w-6 items-center justify-center rounded p-1 text-xs font-medium
							<%= p === pagination.currentPage
								? 'bg-blue-500 dark:bg-blue-600 text-white'
								: 'bg-gray-200 hover:bg-gray-300 dark:bg-gray-800 dark:hover:bg-gray-700' %>">
							<%= p %>
						</a>
					<% } %>
				<% }); %>
			</nav>
		</div>
	<% } %>
</div>
