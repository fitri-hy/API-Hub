<!-- Transaction Detail -->
<div class="mb-4">
  <a href="/admin/transactions" class="link text-sm flex items-center gap-1">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 19l-7-7 7-7"/></svg>
    Back to Transactions
  </a>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Transaction Info -->
  <div class="lg:col-span-2 space-y-4">
    <div class="card p-5">
      <h3 class="text-sm font-bold mb-4">Transaction #<%= transaction.id %></h3>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Status</label>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium
            <%= transaction.status === 'pending' ? 'bg-yellow-100 text-yellow-700' :
                transaction.status === 'approved' ? 'bg-emerald-100 text-emerald-700' :
                'bg-rose-100 text-rose-700' %>">
            <%= transaction.status.toUpperCase() %>
          </span>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Type</label>
          <span class="text-sm font-medium"><%= transaction.type === 'standard_package' ? 'Standard Package' : 'Custom Package' %></span>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider mb-1">User</label>
          <p class="text-sm"><%= transaction.full_name || transaction.username %></p>
          <p class="text-xs text-gray-500">@<%= transaction.username %> • <%= transaction.email %></p>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Package</label>
          <p class="text-sm"><%= transaction.package_name || 'Custom Package' %></p>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Credits Requested</label>
          <p class="text-lg font-bold text-blue-600"><%= transaction.credits_requested %></p>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Rate Limit</label>
          <p class="text-sm"><%= transaction.rate_limit_per_minute %> requests/minute</p>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Total Price</label>
          <p class="text-lg font-bold"><%= helpers.formatRupiah(transaction.total_price) %></p>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Created</label>
          <p class="text-sm"><%= helpers.formatDate(transaction.created_at, 'datetime') %></p>
        </div>
      </div>

      <% if (transaction.notes) { %>
        <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-800">
          <label class="block text-xs font-semibold uppercase tracking-wider mb-1">User Notes</label>
          <p class="text-sm bg-gray-50 dark:bg-gray-800 p-3 rounded"><%= transaction.notes %></p>
        </div>
      <% } %>

      <% if (transaction.admin_note) { %>
        <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-800">
          <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Admin Note</label>
          <p class="text-sm bg-blue-50 dark:bg-blue-900/20 p-3 rounded"><%= transaction.admin_note %></p>
          <p class="text-xs text-gray-500 mt-1">By: <%= transaction.reviewed_by_name %> at <%= helpers.formatDate(transaction.reviewed_at, 'datetime') %></p>
        </div>
      <% } %>
    </div>

    <!-- Payment Proof -->
    <% if (transaction.payment_proof) { %>
      <div class="card p-5">
        <h3 class="text-sm font-bold mb-4">Payment Proof</h3>
        <div class="flex justify-center">
          <img src="<%= transaction.payment_proof %>" alt="Payment Proof" class="max-w-full max-h-96 rounded-lg border border-gray-200 dark:border-gray-700 cursor-pointer" onclick="window.open(this.src, '_blank')">
        </div>
      </div>
    <% } %>
  </div>

  <!-- Sidebar Actions -->
  <div class="space-y-4">
    <!-- Admin Actions -->
    <% if (transaction.status === 'pending') { %>
      <div class="card p-5">
        <h3 class="text-sm font-bold mb-4">Review Transaction</h3>
        <form id="approveForm" method="POST" action="/admin/transactions/<%= transaction.id %>/approve" class="space-y-3">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Admin Note (Optional)</label>
            <textarea name="admin_note" rows="2" class="w-full bg-form px-3 py-2 text-sm rounded-md" placeholder="Note for this action..."></textarea>
          </div>
          <button type="submit" class="w-full flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-lg text-sm font-medium transition">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
            Approve & Apply
          </button>
        </form>
        <hr class="my-4 border-gray-100 dark:border-gray-800">
        <form id="rejectForm" method="POST" action="/admin/transactions/<%= transaction.id %>/reject" class="space-y-3">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Rejection Reason</label>
            <textarea name="admin_note" rows="2" class="w-full bg-form px-3 py-2 text-sm rounded-md" placeholder="Reason for rejection..."></textarea>
          </div>
          <button type="submit" class="w-full flex items-center justify-center gap-2 bg-rose-600 hover:bg-rose-700 text-white px-4 py-2.5 rounded-lg text-sm font-medium transition">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
            Reject
          </button>
        </form>
      </div>
    <% } else { %>
      <div class="card p-5">
        <h3 class="text-sm font-bold mb-2">Reviewed</h3>
        <p class="text-sm text-gray-600">By: <span class="font-medium"><%= transaction.reviewed_by_name %></span></p>
        <p class="text-xs text-gray-500"><%= helpers.formatDate(transaction.reviewed_at, 'datetime') %></p>
      </div>
    <% } %>

    <!-- Summary -->
    <div class="card p-5">
      <h3 class="text-sm font-bold mb-3">Summary</h3>
      <div class="space-y-2 text-sm">
        <div class="flex justify-between">
          <span class="text-gray-500">Credits</span>
          <span class="font-medium"><%= transaction.credits_requested %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-500">Rate Limit</span>
          <span class="font-medium"><%= transaction.rate_limit_per_minute %>/min</span>
        </div>
        <hr class="border-gray-100 dark:border-gray-800">
        <div class="flex justify-between font-bold">
          <span>Total</span>
          <span><%= helpers.formatRupiah(transaction.total_price) %></span>
        </div>
      </div>
    </div>
  </div>
</div>
