              <input type="checkbox" name="auth_required" <%= api.auth_required ? 'checked' : '' %> class="h-4 w-4 rounded border-gray-300 text-blue-500 focus:ring-blue-500">
              <label class="text-sm text-gray-800">Auth Required</label>
            </div>
            <div class="flex items-center gap-2">
              <input type="checkbox" name="is_public" <%= api.is_public ? 'checked' : '' %> class="h-4 w-4 rounded border-gray-300 text-blue-500 focus:ring-blue-500">
              <label class="text-sm text-gray-800">Public</label>
            </div>
          </div>
        </div>
		<div class="flex items-end justify-end mt-6">
		  <button type="submit" class="flex items-center gap-1 btn-normal px-4 py-2 rounded-md">
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24">
				<path d="M0 0h24v24H0z" fill="none"></path>
				<g fill="none" stroke="currentColor" stroke-width="1.5">
					<path d="M3.46447 20.5355C4.92893 22 7.28595 22 12 22C16.714 22 19.0711 22 20.5355 20.5355C22 19.0711 22 16.714 22 12C22 11.6585 22 11.4878 21.9848 11.3142C21.9142 10.5049 21.586 9.71257 21.0637 9.09034C20.9516 8.95687 20.828 8.83317 20.5806 8.58578L15.4142 3.41944C15.1668 3.17206 15.0431 3.04835 14.9097 2.93631C14.2874 2.414 13.4951 2.08581 12.6858 2.01515C12.5122 2 12.3415 2 12 2C7.28595 2 4.92893 2 3.46447 3.46447C2 4.92893 2 7.28595 2 12C2 16.714 2 19.0711 3.46447 20.5355Z"></path>
					<path d="M17 22V21C17 19.1144 17 18.1716 16.4142 17.5858C15.8284 17 14.8856 17 13 17H11C9.11438 17 8.17157 17 7.58579 17.5858C7 18.1716 7 19.1144 7 21V22"></path>
					<path stroke-linecap="round" d="M7 8H13"></path>
				</g>
			</svg>
			Save Changes
		  </button>
		</div>
	  </form>
    </div>

    <!-- Routes -->
    <div data-aos="zoom-in" class="card p-5">
      <div class="border-b pb-4 border-gray-200/70 dark:border-gray-800/70 flex items-center justify-between">
        <h3 class="text-sm font-semibold">Routes (<%= routes.length %>)</h3>
