<%
pageHead = `
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/base16-light.min.css">
<style>
  .CodeMirror {
    border-radius: 0.375rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 13px;
    line-height: 1.6;
    border: 1px solid #e5e7eb;
    background: #f9fafb;
    color: #374151;
    min-height: 160px;
  }
  .cm-handler .CodeMirror { min-height: 220px; }
  .CodeMirror-gutters { background: transparent; border-right: none; }
</style>
`;

pageScript = `
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/javascript/javascript.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/markdown/markdown.min.js"></script>
<script>
  var editors = {};

  function createEditor(textarea, mode, theme) {
    if (!textarea) return;
    if (textarea.cmReady) {
      if (textarea.cmEditor) {
        textarea.cmEditor.refresh();
      }
      return;
    }
    var ed = CodeMirror.fromTextArea(textarea, {
      mode: mode,
      theme: theme || 'base16-light',
      lineNumbers: true,
      lineWrapping: true,
      tabSize: 2,
      indentUnit: 2,
      autofocus: false
    });
    textarea.cmReady = true;
    textarea.cmEditor = ed;
    editors[textarea.id] = ed;
    setTimeout(function() { ed.refresh(); }, 50);
  }

  window.toggleAddRoute = function() {
    var form = document.getElementById('addRouteForm');
    form.classList.toggle('hidden');
    if (!form.classList.contains('hidden')) {
      createEditor(document.getElementById('newHandlerCode'), 'javascript', 'base16-light');
      createEditor(document.getElementById('newRouteDocs'), 'markdown', 'base16-light');
      createEditor(document.getElementById('newSampleResponse'), 'javascript', 'base16-light');
    }
  };

  window.toggleEditRoute = function(id) {
    var form = document.getElementById('editRoute' + id);
    form.classList.toggle('hidden');
    if (!form.classList.contains('hidden')) {
      createEditor(document.getElementById('handlerCode' + id), 'javascript', 'base16-light');
      createEditor(document.getElementById('routeDocs' + id), 'markdown', 'base16-light');
      createEditor(document.getElementById('sampleResponse' + id), 'javascript', 'base16-light');
    }
  };

  function syncAll() {
    Object.keys(editors).forEach(function(k) {
      var ed = editors[k];
      if (ed && typeof ed.save === 'function') ed.save();
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('form').forEach(function(f) {
      f.addEventListener('submit', function() { syncAll(); });
    });
  });
</script>
`;
%>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
