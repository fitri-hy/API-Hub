						<path d="M17 22V21C17 19.1144 17 18.1716 16.4142 17.5858C15.8284 17 14.8856 17 13 17H11C9.11438 17 8.17157 17 7.58579 17.5858C7 18.1716 7 19.1144 7 21V22"></path>
						<path stroke-linecap="round" d="M7 8H13"></path>
					</g>
				</svg>
				Create Route
			</button>
            <button type="button" onclick="toggleAddRoute()" class="flex items-center gap-1 btn-failed px-4 py-2 rounded-md">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24">
					<path d="M0 0h24v24H0z" fill="none"></path>
					<g fill="currentColor">
						<path d="M5.53717 19.5302C5.24427 19.8231 4.7694 19.8231 4.47651 19.5302C4.18361 19.2373 4.18361 18.7624 4.47651 18.4696L18.4764 4.46967C18.7693 4.17678 19.2442 4.17678 19.5371 4.46967C19.8299 4.76256 19.8299 5.23744 19.5371 5.53033L5.53717 19.5302Z"></path>
						<path d="M4.46978 5.53033C4.17689 5.23744 4.17689 4.76256 4.46978 4.46967C4.76268 4.17678 5.23755 4.17678 5.53044 4.46967L19.5303 18.4696C19.8232 18.7624 19.8232 19.2373 19.5303 19.5302C19.2374 19.8231 18.7626 19.8231 18.4697 19.5302L4.46978 5.53033Z"></path>
					</g>
				</svg>
				Cancel
			</button>
          </div>
        </form>
      </div>

      <!-- Routes List -->
		<div class="divide-y divide-gray-100 dark:divide-gray-800/70">
			<% routes.forEach(function(r) { %>
				<div class="group flex items-center gap-4 px-2 py-2 hover:bg-gray-50/70 dark:hover:bg-gray-800/40">
					<span class="inline-flex w-16 shrink-0 items-center justify-center rounded-md px-2 py-1 text-[10px] font-bold uppercase tracking-wide <%= helpers.methodBadgeClass(r.method) %>">
						<%= r.method %>
					</span>
					<span class="min-w-0 flex-1 truncate font-mono text-xs" title="<%= r.path %>">
						<%= r.path %>
					</span>
					<span class="inline-flex shrink-0 items-center gap-1.5 rounded-full px-2 py-0.5 text-[10px] font-medium <%= helpers.statusBadgeClass(r.is_active ? 'active' : 'inactive') %>">
						<%= r.is_active ? 'On' : 'Off' %>
					</span>
					<div class="flex shrink-0 items-center gap-4">
						<button type="button" onclick="toggleEditRoute('<%= r.id %>')" class="text-xs link">
							Edit
						</button>
						<form method="POST" action="/admin/apis/<%= api.id %>/routes/<%= r.id %>/delete" onsubmit="return confirm('Delete route <%= r.method %> <%= r.path %>?')" class="inline">
							<button type="submit" class="text-xs link-rose">
								Delete
							</button>
						</form>
					</div>
				</div>

				<div id="editRoute<%= r.id %>" class="mx-3 my-3 hidden rounded-xl border border-gray-200/70 bg-gray-50/50 p-5 dark:border-gray-700/70 dark:bg-gray-900/40">
					<form method="POST" action="/admin/apis/<%= api.id %>/routes/<%= r.id %>/edit" class="space-y-4">
						<div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
							<select name="method" required class="rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm outline-none focus:border-blue-500 dark:border-gray-700 dark:bg-gray-900">
								<% ['GET','POST','PUT','DELETE','PATCH'].forEach(function(m){ %>
									<option value="<%= m %>" <%= r.method === m ? 'selected' : '' %>><%= m %></option>
								<% }); %>
							</select>

							<input type="text" name="path" required value="<%= r.path %>" class="col-span-2 rounded-lg border border-gray-200 bg-white px-3 py-2 font-mono text-sm outline-none focus:border-blue-500 dark:border-gray-700 dark:bg-gray-900">
						</div>

						<input type="text" name="description" value="<%= r.description || '' %>" placeholder="Route description" class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm outline-none focus:border-blue-500 dark:border-gray-700 dark:bg-gray-900">

						<div class="cm-handler">
							<label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-400">Service Code Handler</label>
							<textarea name="handler_code" id="handlerCode<%= r.id %>" rows="10" required><%= r.handler_code || '' %></textarea>
							<p class="mt-1.5 text-[11px] text-amber-600 dark:text-amber-400">Sandboxed Node.js. Available: <code>fetch</code>, <code>req</code>, <code>user</code>, <code>api</code>, <code>db</code>, <code>helpers</code>, <code>httpGet(url)</code>. ESM: <code>import('node-fetch')</code>, <code>import('axios')</code>, <code>import('cheerio')</code>, <code>import('dayjs')</code>. Return <code>{ status, data, error }</code>.</p>
						</div>

						<div class="cm-docs">
							<label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-400">Route Documentation (Markdown)</label>
							<textarea name="documentation" id="routeDocs<%= r.id %>" rows="5"><%= r.documentation || '' %></textarea>
						</div>

						<div class="cm-json">
							<label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-400">Sample Response (JSON)</label>
							<textarea name="sample_response" id="sampleResponse<%= r.id %>" rows="4"><%= typeof r.sample_response === 'object' ? JSON.stringify(r.sample_response, null, 2) : (r.sample_response || '') %></textarea>
						</div>

						<label class="flex w-fit cursor-pointer items-center gap-2">
							<input type="checkbox" name="is_active" <%= r.is_active ? 'checked' : '' %> id="active<%= r.id %>" class="h-4 w-4 rounded border-gray-300 text-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-800">
							<span class="text-xs font-medium text-gray-700 dark:text-gray-300">Active</span>
						</label>

						<div class="flex items-center gap-2 border-t border-gray-200/70 pt-3 dark:border-gray-800">
							<button type="submit" class="rounded-lg bg-blue-500 px-4 py-2 text-xs font-semibold text-white hover:bg-blue-600">
								Save Changes
							</button>
							<button type="button" onclick="toggleEditRoute('<%= r.id %>')" class="rounded-lg px-4 py-2 text-xs font-medium hover:bg-gray-100 hover:text-gray-700 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200">
								Cancel
							</button>
						</div>
					</form>
				</div>
			<% }); %>

			<% if (routes.length === 0) { %>
				<div class="px-6 py-10 text-center text-xs dark:text-gray-400">
					There is no route yet. Klik <span class="font-medium">Add Route</span> to add.
				</div>
			<% } %>
		</div>
    </div>
  </div>

  <!-- Sidebar -->
  <div class="space-y-4">
	<div data-aos="zoom-in" class="card p-5">
	  <div class="border-b border-gray-200/70 dark:border-gray-800/70 pb-4 mb-4">
		<h3 class="text-xs font-semibold uppercase tracking-wider">Info</h3>
	  </div>
      <div class="space-y-3 text-sm">
        <div class="flex justify-between"><span>Slug</span><span class="font-mono"><%= api.slug %></span></div>
        <div class="flex justify-between"><span>Base Route</span><span class="font-mono text-xs">/gateway/<%= api.slug %>/*</span></div>
        <div class="flex justify-between"><span>Created</span><span><%= helpers.formatDate(api.created_at, 'short') %></span></div>
      </div>
    </div>
	<div data-aos="zoom-in" class="card p-5">
	  <div class="border-b border-gray-200/70 dark:border-gray-800/70 pb-4 mb-4"><h3 class="text-xs font-semibold uppercase tracking-wider">Stats (30d)</h3></div>
	  <div class="space-y-1.5 text-sm">
		<div class="flex justify-between"><span>Total Requests</span><span class="font-mono"><%= helpers.formatNumber(Number(stats?.overview?.total_requests || 0)) %></span></div>
		<div class="flex justify-between"><span>Success</span><span class="font-mono"><%= helpers.formatNumber(Number(stats?.overview?.successful || 0)) %></span></div>
		<div class="flex justify-between"><span>Failed</span><span class="font-mono"><%= helpers.formatNumber(Number(stats?.overview?.failed || 0)) %></span></div>
		<div class="flex justify-between"><span>Credits Used</span><span class="font-mono"><%= helpers.formatNumber(Number(stats?.overview?.total_credits_used || 0)) %></span></div>
		<div class="flex justify-between"><span>Avg Response</span><span class="font-mono"><%= Math.round(Number(stats?.overview?.avg_response_time || 0)) %>ms</span></div>
		<div class="flex justify-between"><span>Min / Max</span><span class="font-mono"><%= Math.round(Number(stats?.overview?.min_response_time || 0)) %>/<%= Math.round(Number(stats?.overview?.max_response_time || 0)) %>ms</span></div>
	  </div>
		<div class="border-t border-gray-200/70 dark:border-gray-800/70 pt-2 mt-2">
		  <p class="text-sm mb-2">By Method</p>
		  <div class="space-y-1">
			<% if (stats?.methods?.length) { %>
			  <% stats.methods.forEach(function(m) { %>
				<div class="flex items-center justify-between text-xs">
				  <span class="inline-flex px-1.5 py-0.5 rounded text-[9px] font-bold uppercase <%= helpers.methodBadgeClass(m.method) %>"><%= m.method %></span>
				  <div class="flex items-center gap-1"><span class="font-mono"><%= Math.round(Number(m.avg_time || 0)) %>ms</span><span>(<%= helpers.formatNumber(Number(m.count || 0)) %>)</span></div>
				</div>
			  <% }); %>
			<% } else { %>
			  <div class="text-xs">No data</div>
			<% } %>
		  </div>
		</div>

		<div class="border-t border-gray-200/70 dark:border-gray-800/70 pt-2 mt-2">
		  <p class="text-sm mb-2">By Status</p>
		  <div class="space-y-1">
			<% if (stats?.statusCodes?.length) { %>
			  <% stats.statusCodes.forEach(function(s) { %>
				<div class="flex items-center justify-between text-xs">
				  <span class="font-mono <%= Number(s.response_status) >= 200 && Number(s.response_status) < 300 ? 'text-emerald-600' : Number(s.response_status) >= 400 ? 'text-rose-600' : 'text-amber-600' %>"><%= s.response_status %></span>
				  <span><%= helpers.formatNumber(Number(s.count || 0)) %></span>
				</div>
			  <% }); %>
			<% } else { %>
			  <div class="text-xs">No data</div>
			<% } %>
		  </div>
		</div>

		<% if (stats?.topRoutes && stats.topRoutes.length > 0) { %>
		  <div class="border-t border-gray-200/70 dark:border-gray-800/70 pt-2 mt-2">
			<p class="text-sm mb-2">Top Routes</p>
			<div class="space-y-1.5">
			  <% stats.topRoutes.forEach(function(tr) { %>
				<div class="text-xs flex justify-between gap-4">
				  <div class="flex items-center gap-1.5">
					<span class="inline-flex px-1.5 py-0.5 rounded text-[9px] font-bold uppercase <%= helpers.methodBadgeClass(tr.method) %>"><%= tr.method %></span>
					<span class="font-mono truncate"><%= tr.path || '/' %></span>
				  </div>
				  <div class="flex items-center gap-1">
					<span><%= Math.round(tr.avg_time || 0) %>ms</span>
					<span>(<%= helpers.formatNumber(tr.count) %>)</span>
				  </div>
				</div>
			  <% }); %>
			</div>
		  </div>
		<% } %>
	</div>
  </div>
</div>