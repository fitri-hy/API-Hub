<div>
	<div class="flex items-center gap-4 card px-4 py-3 mb-4">
		<a href="/admin/notification" class="group flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-white border border-gray-200/70 dark:border-gray-800/70 hover:bg-gray-100 dark:hover:bg-slate-800 dark:bg-slate-900" title="Back to users">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none">
				<path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</a>
		<div>
		  <h2 class="text-sm font-bold mb-1">Send Push Notification</h2>
		  <p class="text-xs">
			Send a notification message to one or all users
		  </p>
		</div>
	</div>

	<div class="card p-5">
    <form action="/admin/notification/push" method="POST" class="space-y-4">
		
		<div class="md:max-w-xs">
			<label for="recipient" class="block font-semibold mb-1.5">
			  Send To <span class="text-rose-500">*</span>
			</label>
			<select id="recipient" name="recipient" required class="w-full bg-form px-4 py-2">
				<option value="all">All Users</option>
					<optgroup label="Specific User">
					<% if (users && users.length > 0) { %>
					<% users.forEach(function(u) { %>
						<option value="<%= u.uuid %>"><%= u.username %> — <%= u.email %></option>
					<% }); %>
					<% } %>
				</optgroup>
			</select>
		</div>
		<div class="md:max-w-xl">
			<label for="title" class="block font-semibold mb-1.5">
			  Title <span class="text-rose-500">*</span>
			</label>
			<input type="text" id="title" name="title" required maxlength="200"
			  placeholder="e.g. New Feature Available"
			  class="w-full bg-form px-4 py-2">
		</div>

		<div class="md:max-w-xl">
			<label for="message" class="block font-semibold mb-1.5">
			  Message <span class="text-rose-500">*</span>
			</label>
			<textarea id="message" name="message" required rows="4" maxlength="1000"
			  placeholder="Write the notification message here..."
			  class="w-full bg-form px-4 py-2"></textarea>
			<p class="mt-1 text-xs">
			  <span id="char-count">0</span> / 1000 characters
			</p>
		</div>

		<div class="md:max-w-xl">
			<label for="link" class="block font-semibold mb-1.5">
				Link <span class="text-xs font-normal">(optional)</span>
			</label>
			<input type="text" id="link" name="link"
			  placeholder="e.g. /user/packages or https://example.com"
			  class="w-full bg-form px-4 py-2">
			<p class="mt-1 text-xs">
				URL or path that users will open when clicking the notification
			</p>
		</div>

		<div class="md:max-w-xl">
			<label for="image_url" class="block font-semibold mb-1.5">
				Image URL <span class="text-xs font-normal">(optional)</span>
			</label>
			<input type="url" id="image_url" name="image_url"
			  placeholder="e.g. https://example.com/image.jpg"
			  class="w-full bg-form px-4 py-2">
			<p class="mt-1 text-xs">
				Image displayed in the notification (JPG, PNG, GIF, or WebP)
			</p>
		</div>

      <!-- Preview -->
      <div class="rounded-lg border border-gray-200/70 dark:border-gray-800/70 p-4">
        <h4 class="text-xs font-semibold uppercase tracking-wider mb-3">Preview</h4>
        <div class="flex items-start gap-3">
          <div class="shrink-0 flex h-9 w-9 items-center justify-center rounded-full bg-purple-100 dark:bg-purple-900/30 text-purple-500">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <h6 class="text-sm font-semibold" id="preview-title">
              Notification Title
            </h6>
            <p class="text-sm mt-0.5" id="preview-message">
              Your message will appear here...
            </p>
            <div id="preview-image-container" class="hidden mt-2">
              <img id="preview-image" src="" alt="" class="w-auto h-34 object-contain rounded-lg">
            </div>
          </div>
        </div>
      </div>

      <!-- Submit -->
      <div class="flex items-center justify-end gap-4 mt-2">
        <a href="/admin/notification" class="flex items-center gap-1 btn-failed px-4 py-2 rounded-md">
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24">
				<path d="M0 0h24v24H0z" fill="none" />
				<g fill="currentColor">
					<path d="M5.53717 19.5302C5.24427 19.8231 4.7694 19.8231 4.47651 19.5302C4.18361 19.2373 4.18361 18.7624 4.47651 18.4696L18.4764 4.46967C18.7693 4.17678 19.2442 4.17678 19.5371 4.46967C19.8299 4.76256 19.8299 5.23744 19.5371 5.53033L5.53717 19.5302Z" />
					<path d="M4.46978 5.53033C4.17689 5.23744 4.17689 4.76256 4.46978 4.46967C4.76268 4.17678 5.23755 4.17678 5.53044 4.46967L19.5303 18.4696C19.8232 18.7624 19.8232 19.2373 19.5303 19.5302C19.2374 19.8231 18.7626 19.8231 18.4697 19.5302L4.46978 5.53033Z" />
				</g>
			</svg>
			Cancel
        </a>
        <button type="submit" id="submit-btn"
          class="flex items-center gap-1 btn-normal px-4 py-2 rounded-md">
          Send
		  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24">
			<path d="M0 0h24v24H0z" fill="none" />
			<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.714 3.048a.498.498 0 0 0-.683.627l2.843 7.627a2 2 0 0 1 0 1.396l-2.842 7.627a.498.498 0 0 0 .682.627l18-8.5a.5.5 0 0 0 0-.904zM6 12h16" />
		  </svg>
        </button>
      </div>
    </form>
  </div>
</div>

<%
pageScript = `
<script>
document.addEventListener('DOMContentLoaded', function() {
  var titleInput = document.getElementById('title');
  var messageInput = document.getElementById('message');
  var imageUrlInput = document.getElementById('image_url');
  var recipientSelect = document.getElementById('recipient');
  var previewTitle = document.getElementById('preview-title');
  var previewMessage = document.getElementById('preview-message');
  var previewImage = document.getElementById('preview-image');
  var previewImageContainer = document.getElementById('preview-image-container');
  var charCount = document.getElementById('char-count');
  var submitBtn = document.getElementById('submit-btn');

  // Live preview
  titleInput.addEventListener('input', function() {
    previewTitle.textContent = this.value || 'Notification Title';
  });
  messageInput.addEventListener('input', function() {
    previewMessage.textContent = this.value || 'Your message will appear here...';
    charCount.textContent = this.value.length;
  });

  // Image URL preview
  imageUrlInput.addEventListener('input', function() {
    var url = this.value.trim();

    if (url) {
      previewImage.src = url;
      previewImageContainer.classList.remove('hidden');

      previewImage.onerror = function() {
        previewImageContainer.classList.add('hidden');
      };

      previewImage.onload = function() {
        previewImageContainer.classList.remove('hidden');
      };
    } else {
      previewImage.src = '';
      previewImageContainer.classList.add('hidden');
    }
  });

  // Submit loading state
  var form = submitBtn.closest('form');
  form.addEventListener('submit', function() {
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<svg class="animate-spin" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M0 0h24v24H0z" fill="none" /><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9a9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" /></g></svg> Sending...';
  });
});
</script>
`;
%>
