<div class="mb-4 grid grid-cols-1 gap-4 lg:grid-cols-2">
	<!-- Status Code Distribution -->
	<div class="card p-5">
		<div class="mb-4 flex items-center justify-between">
			<div>
				<h3 class="text-sm font-semibold tracking-tight">Status Code Distribution</h3>
				<p class="mt-1 text-xs">Request distribution by response status</p>
			</div>
		</div>
		<% if (statusStats.length > 0) { %>
			<div class="space-y-4">
				<% var maxCount = statusStats[0].count; %>
				<% statusStats.forEach(function(s) { %>
					<% var pct = (s.count / maxCount * 100); %>
					<% var statusClass =
						s.response_status >= 200 && s.response_status < 300
							? 'bg-emerald-500 text-emerald-600 bg-emerald-50 dark:bg-emerald-500/10 dark:text-emerald-400'
							: s.response_status >= 400 && s.response_status < 500
							? 'bg-yellow-500 text-yellow-600 bg-yellow-50 dark:bg-yellow-500/10 dark:text-yellow-400'
							: s.response_status >= 500
							? 'bg-rose-500 text-rose-600 bg-rose-50 dark:bg-rose-500/10 dark:text-rose-400'
							: 'bg-gray-500 text-gray-600 bg-gray-50 dark:bg-gray-800 dark:text-gray-400';
					%>
					<div class="group">
						<div class="mb-2 flex items-center justify-between gap-3">
							<div class="flex items-center gap-2">
								<span class="inline-flex min-w-12 items-center justify-center rounded-md px-2 py-1 text-[10px] font-bold <%= statusClass.split(' ').slice(1).join(' ') %>">
									<%= s.response_status %>
								</span>
								<span class="text-xs text-gray-500 dark:text-gray-400">
									<%= s.response_status >= 200 && s.response_status < 300 ? 'Success' :
										s.response_status >= 400 && s.response_status < 500 ? 'Client Error' :
										s.response_status >= 500 ? 'Server Error' : 'Other' %>
								</span>
							</div>
							<span class="text-xs font-semibold">
								<%= helpers.formatNumber(s.count) %>
							</span>
						</div>
						<div class="h-1.5 w-full overflow-hidden rounded-full bg-gray-100 dark:bg-gray-800">
							<div
								class="h-full rounded-full <%= statusClass.split(' ')[0] %>"
								style="width: <%= pct %>%"
							></div>
						</div>
					</div>
				<% }); %>
			</div>
		<% } else { %>
			<div class="flex min-h-40 flex-col items-center justify-center text-center">
				<p class="text-xs font-medium">No data available</p>
				<p class="mt-1 text-[11px]">The data will appear here.</p>
			</div>
		<% } %>
	</div>

	<!-- Credit Transactions -->
	<div class="card p-5">
		<div class="mb-4">
			<h3 class="text-sm font-semibold tracking-tight">Credit Transactions</h3>
			<p class="mt-1 text-xs">Credit activity over the last 30 days</p>
		</div>
		<% if (creditTxStats.length > 0) { %>
			<div class="space-y-2">
				<% var maxTotal = Math.max(...creditTxStats.map(t => Math.abs(Number(t.total)))); %>
				<% creditTxStats.forEach(function(tx) { %>
					<% var pct = maxTotal > 0 ? (Math.abs(Number(tx.total)) / maxTotal * 100) : 0; %>
					<% var typeClass =
						tx.type === 'add' ? 'bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400' :
						tx.type === 'deduct' ? 'bg-rose-50 text-rose-600 dark:bg-rose-500/10 dark:text-rose-400' :
						tx.type === 'purchase' ? 'bg-blue-50 text-blue-600 dark:bg-blue-500/10 dark:text-blue-400' :
						tx.type === 'bonus' ? 'bg-purple-50 text-purple-600 dark:bg-purple-500/10 dark:text-purple-400' :
						tx.type === 'refund' ? 'bg-yellow-50 text-yellow-600 dark:bg-yellow-500/10 dark:text-yellow-400' :
						'bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400';
					%>
					<div class="dark:border-gray-800">
						<div class="mb-1 flex items-center justify-between gap-1">
							<span class="inline-flex text-[10px] font-bold uppercase <%= typeClass %>">
								<%= tx.type === 'add' ? 'Add' :
									tx.type === 'deduct' ? 'Deduct' :
									tx.type === 'purchase' ? 'Purchase' :
									tx.type === 'bonus' ? 'Bonus' :
									tx.type === 'refund' ? 'Refund' :
