<%
pageScript = `
<script>
	(() => {
		const faq = document.getElementById('referral-faq');

		if (!faq) return;

		const items = [...faq.querySelectorAll('.faq-item')];

		const setTransition = (answer) => {
			answer.style.overflow = 'hidden';
			answer.style.transition = 'grid-template-rows 350ms ease, opacity 250ms ease';
		};

		const closeItem = (item) => {
			const trigger = item.querySelector('.faq-trigger');
			const answer = item.querySelector('.faq-answer');
			const icon = item.querySelector('.faq-icon');

			if (!answer) return;

			trigger.setAttribute('aria-expanded', 'false');
			setTransition(answer);
			answer.style.gridTemplateRows = '0fr';
			answer.style.opacity = '0';
			icon.style.transition = 'transform 300ms ease, background-color 300ms ease, color 300ms ease';
			icon.style.transform = 'rotate(0deg)';
			icon.classList.remove('bg-rose-500/10', 'text-rose-500');
		};

		const openItem = (item) => {
			const trigger = item.querySelector('.faq-trigger');
			const answer = item.querySelector('.faq-answer');
			const icon = item.querySelector('.faq-icon');

			if (!answer) return;

			trigger.setAttribute('aria-expanded', 'true');
			setTransition(answer);
			answer.style.gridTemplateRows = '1fr';
			answer.style.opacity = '1';
			icon.style.transition = 'transform 300ms ease, background-color 300ms ease, color 300ms ease';
			icon.style.transform = 'rotate(45deg)';
			icon.classList.add('bg-rose-500/10', 'text-rose-500');
		};

		items.forEach((item) => {
			const trigger = item.querySelector('.faq-trigger');
			trigger.addEventListener('click', () => {
				const isOpen = trigger.getAttribute('aria-expanded') === 'true';
				items.forEach((other) => { if (other !== item) closeItem(other); });
				if (isOpen) closeItem(item); else openItem(item);
			});
		});
	})();
</script>
`;
%>
