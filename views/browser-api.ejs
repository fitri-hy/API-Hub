<section class="container mx-auto px-4 py-12 lg:px-12">
	<div class="mx-auto max-w-sm text-center">
		<span class="inline-flex items-center rounded-full border border-blue-200/20 bg-blue-100/50 px-3 py-1 text-xs font-semibold text-blue-600 dark:border-blue-700/20 dark:bg-blue-950/50 dark:text-sky-400">Developer APIs</span>
		<h2 class="text-center text-3xl font-black tracking-tighter">
			<span class="font-serif font-normal italic">Explore Our APIs</span>
		</h2>
		<p class="text-center">Browse available APIs and explore their endpoints, documentation, and usage details.</p>
	</div>

	<form method="GET" action="/browser-apis" class="w-full max-w-sm mt-8">
		<div class="flex gap-2">
			<input type="search" name="search" value="<%= filters.search %>" placeholder="Search APIs..." class="w-full bg-form px-4 py-2">
			<button type="submit" class="btn-normal p-2 rounded-md">
				<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24">
					<path d="M0 0h24v24H0z" fill="none" />
					<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2" d="m21 21l-4.486-4.494M19 10.5a8.5 8.5 0 1 1-17 0a8.5 8.5 0 0 1 17 0Z" />
				</svg>
			</button>
		</div>
	</form>

	<% if (apis && apis.length > 0) { %>
		<div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
			<% apis.forEach(api => { %>
				<a href="/browser-apis/<%= api.slug %>" class="group hover:scale-105 hover:transition hover:duration-300 card p-5 hover:shadow-sm flex flex-col justify-between gap-4">
					<div>
						<div class="flex items-start justify-between gap-4">
							<div>
								<h2 class="text-xl group-hover:text-blue-500 dark:group-hover:text-blue-400 text-lg font-bold"><%= api.name %></h2>
							</div>
							<div class="flex items-center gap-2 text-sm">
								<span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= helpers.statusBadgeClass(api.status) %>">
									<%= api.status ? api.status.charAt(0).toUpperCase() + api.status.slice(1) : 'Draft' %>
								</span>
								<span class="rounded-full px-2.5 py-1 text-xs font-semibold bg-blue-100/30 dark:bg-blue-950/70 border border-blue-200/70 dark:border-blue-900/70 text-blue-600 dark:text-blue-400">
									v<%= api.version %>
								</span>
							</div>
						</div>
						<p class="mt-4 line-clamp-2 overflow-hidden">
							<%= api.description || 'No description available.' %>
						</p>
					</div>
					<div class="flex items-center justify-between gap-4 border-t border-gray-200/60 pt-4 dark:border-gray-800/60">
						<div class="flex items-center gap-2.5">
							<div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-100/50 dark:bg-blue-950/50 border border-blue-100/70 dark:border-blue-950/70 text-blue-500">
								<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
									<path d="M0 0h24v24H0z" fill="none" />
									<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5">
										<path d="M9 12a3 3 0 1 0 6 0 3 3 0 1 0 -6 0" />
										<path d="M12 3v6" />
										<path d="M9.5 14.5 5 19" />
										<path d="M14.5 14.5 19 19" />
									</g>
								</svg>
							</div>
							<div>
								<p class="text-black dark:text-white text-[10px] font-medium uppercase tracking-wider">Endpoints</p>
								<p class="text-sm font-semibold"><%= api.routes.length %></p>
							</div>
						</div>
						<div class="flex items-center gap-2.5">
							<div class="flex h-8 w-8 items-center justify-center rounded-lg bg-purple-100/50 dark:bg-purple-950/50 border border-purple-100/70 dark:border-purple-950/70 text-purple-500">
								<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
									<path d="M0 0h24v24H0z" fill="none" />
									<path fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 1 1-18 0a9 9 0 0 1 18 0Z" />
									<path fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="2" d="M8.464 12.707a1 1 0 0 1 0-1.414l2.829-2.829a1 1 0 0 1 1.414 0l2.829 2.829a1 1 0 0 1 0 1.414l-2.829 2.829a1 1 0 0 1-1.414 0z" />
								</svg>
							</div>
							<div class="text-right">
								<p class="text-black dark:text-white text-[10px] font-medium uppercase tracking-wider">Cost</p>
								<p class="text-sm font-semibold"><%= api.credit_cost %> <span class="text-xs font-medium">cr/req</span></p>
							</div>
						</div>
					</div>
				</a>
			<% }) %>
		</div>

		<% if (pagination.totalPages > 1) { %>
			<div class="mt-8 flex items-center justify-between gap-4 border-t border-gray-200/70 p-2 dark:border-gray-800/70">
				<p class="text-xs">
					Showing <span class="font-medium"><%= (pagination.currentPage - 1) * pagination.perPage + 1 %>-<%= Math.min(pagination.currentPage * pagination.perPage, pagination.total) %></span>
					from <span class="font-medium"><%= pagination.total %></span>
				</p>
				<nav class="flex items-center gap-1">
					<% pagination.pages.forEach(function(p) { %>
						<% if (p === '...') { %>
							<span class="flex h-8 min-w-8 items-center justify-center px-1 text-xs">...</span>
						<% } else { %>
							<a href="?page=<%= p %>&search=<%= encodeURIComponent(filters.search) %>" class="flex h-8 min-w-8 items-center justify-center rounded p-1 text-xs font-medium <%= p === pagination.currentPage ? 'bg-blue-500 text-white dark:bg-blue-600' : 'bg-gray-200 hover:bg-gray-300 dark:bg-gray-800 dark:hover:bg-gray-700' %>"><%= p %></a>
						<% } %>
					<% }); %>
				</nav>
			</div>
		<% } %>
	<% } else { %>
		<div class="flex items-center mt-8">
			<p class="text-center max-w-sm mx-auto"><%= filters.search ? 'No APIs found matching your search.' : 'No APIs available.' %></p>
		</div>
	<% } %>
</section>