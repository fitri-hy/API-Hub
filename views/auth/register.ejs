<section class="flex-1 h-full grid grid-cols-1 lg:grid-cols-2">
	<div class="hidden relative lg:flex flex-col gap-12 justify-between h-full lg:col-span-1 overflow-hidden bg-gradient-to-br from-indigo-50 via-blue-50 to-purple-100 dark:from-indigo-950/40 dark:via-blue-950/40 dark:to-purple-950/40">
		<div class="absolute -top-20 -right-20 w-80 h-80 rounded-full blur-3xl pointer-events-none bg-blue-300/40 dark:bg-blue-900/20"></div>
		<div class="absolute -bottom-20 -left-20 w-80 h-80 rounded-full blur-3xl pointer-events-none bg-purple-300/40 dark:bg-purple-900/20"></div>

        <a href="/" class="flex items-center gap-4 px-6 lg:px-20 pt-6 lg:pt-20">
			<% if (typeof site_logo !== 'undefined' && site_logo) { %>
				<img data-aos="zoom-in" class="h-12 w-12 rounded-full object-cover" src="<%= site_logo %>" alt="<%= title || appname || 'My App' %>" />
			<% } else { %>
				<img data-aos="zoom-in" class="h-12 w-12 rounded-full object-cover" src="/images/logo.webp" alt="<%= title || 'My App' %>" />
			<% } %>
			<div>
				<h1 data-aos="zoom-in" class="text-xl font-black tracking-tight">
					<%= appname || 'My App' %>
				</h1>
				<p data-aos="zoom-in">
					One Key. Infinite Endpoints.
				</p>
			</div>
        </a>
		<div class="relative z-10 flex flex-col items-center lg:center-start mx-auto lg:mx-0 max-w-2xl px-6 lg:px-20">
			<h1 data-aos="zoom-in" class="text-center text-4xl font-black tracking-tighter text-blank dark:text-white sm:text-6xl lg:text-left">
				<span class="font-serif font-normal italic">
					Join
				</span>
				<span class="bg-gradient-to-r from-sky-600 to-blue-600 bg-clip-text font-bold text-transparent dark:from-sky-400 dark:to-blue-400">
					Developer
				</span>
				<span class="font-serif font-normal italic">
					Console
				</span>
			</h1>
            <p data-aos="zoom-in" class="mt-4">
                Create your account to manage API keys, monitor usage, and keep track of your requests in one place.
            </p>
        </div>
		<%- include('../partials/public-footer') %>
	</div>
	<div class="relative flex flex-col items-center justify-center h-full lg:col-span-1 w-full bg-white dark:bg-slate-950 p-6 lg:p-12">
		<div class="absolute top-4 right-4">
			<button data-aos="zoom-in" type="button" id="theme-toggle" aria-label="Toggle theme" class="relative flex items-center justify-center text-amber-500 h-8 w-8 rounded-full hover:bg-slate-200/60 dark:hover:bg-slate-700/60">
				<svg id="theme-sun" xmlns="http://www.w3.org/2000/svg" class="absolute h-6 w-6 scale-100 rotate-0 transition-all duration-300 dark:scale-0 dark:-rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
				  <circle cx="12" cy="12" r="4" />
				  <path stroke-linecap="round" d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" />
				</svg>
				<svg id="theme-moon" xmlns="http://www.w3.org/2000/svg" class="absolute h-6 w-6 scale-0 rotate-90 transition-all duration-300 dark:scale-100 dark:rotate-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
				  <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
				</svg>
			</button>
		</div>
		<a href="/" class="lg:hidden flex items-center mb-4">
			<% if (typeof site_logo !== 'undefined' && site_logo) { %>
				<img data-aos="zoom-in" class="h-20 w-20 rounded-full object-cover" src="<%= site_logo %>" alt="<%= title || appname || 'My App' %>" />
			<% } else { %>
				<img data-aos="zoom-in" class="h-20 w-20 rounded-full object-cover" src="/images/logo.webp" alt="<%= title || 'My App' %>" />
			<% } %>
        </a>
		<div class="flex flex-col items-center text-center w-full space-y-1">
			<h2 data-aos="zoom-in" class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">
				Create Your Account
			</h2>
			<p data-aos="zoom-in">
				Enter your details below to get started.
			</p>
		</div>
		<div class="w-full flex flex-col mt-12">
			<form method="POST" action="/auth/register">
				<div data-aos="zoom-in" class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
					<div class="w-full flex flex-col gap-1.5 group">
						<label for="fullName" class="block text-[11px] font-semibold uppercase tracking-wider group-focus-within:text-blue-500">Full Name</label>
						<div class="flex gap-2.5 items-center">
							<svg class="w-5 h-5 group-focus-within:text-blue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.654 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
							</svg>
							<input type="text" id="fullName" name="fullName"
								class="w-full bg-transparent outline-none border-b-2 border-gray-400 dark:border-gray-600 focus:border-blue-500 py-2"
								placeholder="John Doe" autocomplete="name">
						</div>
					</div>
				</div>
				<div data-aos="zoom-in" class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
					<div class="w-full flex flex-col gap-1.5 group">
						<label for="username" class="block text-[11px] font-semibold uppercase tracking-wider group-focus-within:text-blue-500">Username</label>
						<div class="flex gap-2.5 items-center">
							<svg class="w-5 h-5 group-focus-within:text-blue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
							</svg>
							<input type="text" id="username" name="username" required
								class="w-full bg-transparent outline-none border-b-2 border-gray-400 dark:border-gray-600 focus:border-blue-500 py-2"
								placeholder="johndoe" autocomplete="username">
						</div>
					</div>
					<div class="w-full flex flex-col gap-1.5 group">
						<label for="email" class="block text-[11px] font-semibold uppercase tracking-wider group-focus-within:text-blue-500">Email</label>
						<div class="flex gap-2.5 items-center">
							<svg class="w-5 h-5 group-focus-within:text-blue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/>
							</svg>
							<input type="email" id="email" name="email" required
								class="w-full bg-transparent outline-none border-b-2 border-gray-400 dark:border-gray-600 focus:border-blue-500 py-2"
								placeholder="johndoe@mail.com" autocomplete="email">
						</div>
					</div>
				</div>
				<div data-aos="zoom-in" class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
					<div class="w-full flex flex-col gap-1.5 group">
						<label for="password" class="block text-[11px] font-semibold uppercase tracking-wider group-focus-within:text-blue-500">Password</label>
						<div class="flex gap-2.5 items-center relative">
							<svg class="w-5 h-5 group-focus-within:text-blue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
							</svg>
							<input type="password" id="password" name="password" required minlength="6"
								class="w-full bg-transparent outline-none border-b-2 border-gray-400 dark:border-gray-600 focus:border-blue-500 py-2"
								placeholder="Min. 6 characters" autocomplete="new-password">
							<button type="button" onclick="togglePassword('password', 'eye-icon-1')" class="absolute right-1 bottom-2.5 focus:outline-none">
								<svg id="eye-icon-1" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
								</svg>
							</button>
						</div>
					</div>
					<div class="w-full flex flex-col gap-1.5 group">
						<label for="confirmPassword" class="block text-[11px] font-semibold uppercase tracking-wider group-focus-within:text-blue-500">Confirm</label>
						<div class="flex gap-2.5 items-center relative">
							<svg class="w-5 h-5 group-focus-within:text-blue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
							</svg>
							<input type="password" id="confirmPassword" name="confirmPassword" required
								class="w-full bg-transparent outline-none border-b-2 border-gray-400 dark:border-gray-600 focus:border-blue-500 py-2"
								placeholder="Repeat password" autocomplete="new-password">
							<button type="button" onclick="togglePassword('confirmPassword', 'eye-icon-2')" class="absolute right-1 bottom-2.5 focus:outline-none">
								<svg id="eye-icon-2" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
								</svg>
							</button>
						</div>
					</div>
				</div>
				<% if (typeof referralEnabled !== 'undefined' && referralEnabled) { %>
					<div data-aos="zoom-in" class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
						<div class="flex flex-col gap-1.5 group">
							<label for="referral_code" class="block text-[11px] font-semibold uppercase tracking-wider group-focus-within:text-blue-500">Referral Code <span class="font-normal normal-case">(Optional)</span></label>
							<div class="flex gap-2.5 items-center">
								<svg class="w-5 h-5 group-focus-within:text-blue-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
								</svg>
								<input type="text" id="referral_code" name="referral_code"
									class="w-full bg-transparent outline-none border-b-2 border-gray-400 dark:border-gray-600 focus:border-blue-500 py-2"
									placeholder="e.g. ABCD1234" autocomplete="off" value="<%= typeof referralCode !== 'undefined' ? referralCode : '' %>">
							</div>
						</div>
					</div>
				<% } %>
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
					<% if (typeof captchaEnabled !== 'undefined' && captchaEnabled) { %>
						<div data-aos="zoom-in" class="flex flex-col gap-2">
							<label class="block text-[11px] font-semibold uppercase tracking-wider group-focus-within:text-blue-500">Security</label>
							<div class="flex items-center w-full gap-4 justify-between px-4 py-3 rounded-md bg-gradient-to-br from-blue-50 via-slate-100 to-sky-50 dark:from-blue-950/50 dark:via-slate-800/70 dark:to-sky-950/50 border border-gray-200/70 dark:border-gray-800/70">
								<div class="flex items-center gap-3">
									<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400">
										<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
										</svg>
									</div>
									<div class="flex flex-col">
										<h6 class="text-xs font-bold text-slate-900 dark:text-white">Verify you are human</h6>
										<span class="text-[11px] font-medium text-slate-500 dark:text-slate-400 mt-0.5">
											Solve: <span class="font-extrabold text-blue-600 dark:text-blue-400 px-1 py-0.5 rounded bg-blue-500/10"><%= captchaA %> + <%= captchaB %></span>
										</span>
									</div>
								</div>
								<input type="number" name="captchaAnswer" required
									class="w-18 bg-form p-2 text-center text-xs"
									placeholder="?" autocomplete="off">
							</div>
						</div>
					<% } %>
				</div>
				
				<% if (typeof turnstileEnabled !== 'undefined' && turnstileEnabled) { %>
				<div data-aos="zoom-in" class="w-full flex flex-col gap-2 group mt-4 items-center">
					<div id="turnstile-container"></div>
					<input type="hidden" name="cf-turnstile-response" id="cf-turnstile-response">
				</div>
				<% } %>

				<div class="w-full flex flex-col gap-1.5 group mt-6 max-w-xs mx-auto">
					<button data-aos="zoom-in" type="submit" class="w-full btn-primary">
						REGISTER
					</button>
				</div>
			</form>
			<div data-aos="zoom-in" class="w-full flex items-center gap-1.5 group mt-6">
				<div class="flex-grow border-t border-gray-300 dark:border-gray-700"></div>
				<span class="flex-shrink mx-4 text-xs text-gray-500 dark:text-gray-400">OR</span>
				<div class="flex-grow border-t border-gray-300 dark:border-gray-700"></div>
			</div>
			<div class="w-full flex items-center justify-center gap-4 group mt-6">
				<a data-aos="zoom-in" href="/auth/google" class="w-12 h-12 flex items-center justify-center gap-1 bg-white border border-gray-200/70 rounded hover:bg-slate-100 dark:bg-slate-900 dark:hover:bg-slate-800 dark:border-gray-700/70" title="Login with Google">
					<svg class="w-5 h-5" viewBox="0 0 24 24"><path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.8 14.8 1 12 1 7.4 1 3.5 3.6 1.6 7.4l3.7 2.9C6.2 7.3 8.9 5 12 5z"/><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.8z"/><path fill="#FBBC05" d="M5.3 14.7c-.2-.7-.4-1.5-.4-2.7s.2-2 .4-2.7L1.6 6.4C.6 8.4 0 10.7 0 13s.6 4.6 1.6 6.6l3.7-2.9z"/><path fill="#34A853" d="M12 23c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3.1 0-5.8-2.3-6.7-5.3L1.6 15c1.9 3.8 5.8 8 10.4 8z"/></svg>
				</a>
			</div>
			<p data-aos="zoom-in" class="mt-6 text-center text-sm">
				Already have an account?
				<a href="/auth/login" class="text-xs font-medium link">LOGIN</a>
			</p>
		</div>

	</div>
</section>

<%
pageScript = `
<script>
  function togglePassword() {
    const passwordInput = document.getElementById('password');
    const eyeIcon = document.getElementById('eye-icon');
    
    if (passwordInput.type === 'password') {
      passwordInput.type = 'text';
      eyeIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />';
    } else {
      passwordInput.type = 'password';
      eyeIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />';
    }
  }
</script>

<script>
  window.onloadTurnstileCallback = function () {
      if (document.getElementById('turnstile-container')) {
          turnstile.render('#turnstile-container', {
              sitekey: '${siteKey}',
              theme: 'auto', // Otomatis menyesuaikan Light/Dark mode
              callback: function (token) {
                  document.getElementById('cf-turnstile-response').value = token;
              },
          });
      }
  };
</script>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onloadTurnstileCallback" async defer></script>
`;
%>