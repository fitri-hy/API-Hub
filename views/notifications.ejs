<div>

	<div class="flex flex-col md:flex-row md:items-center md:justify-between card px-4 py-3 mb-4 gap-4">
		<div>
			<h2 data-aos="zoom-in" class="text-sm font-bold mb-1">Notifications</h2>
			<p class="text-xs">
				<% if (unreadCount > 0) { %>
				  You have <span class="font-semibold text-blue-600 dark:text-blue-400"><%= unreadCount %></span> unread notification<%= unreadCount !== 1 ? 's' : '' %>
				<% } else { %>
				  No unread notifications
				<% } %>
			</p>
		</div>
		<div class="flex items-center gap-2">
			<% if (typeof userData !== 'undefined' && userData && userData.role === 'admin') { %>
			<a data-aos="zoom-in" href="/admin/push-notification" class="w-full md:w-auto flex justify-center items-center gap-2 text-xs md:text-sm btn-normal px-3 py-2 rounded-md text-white">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24">
					<path d="M0 0h24v24H0z" fill="none" />
					<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.268 21a2 2 0 0 0 3.464 0M15 8h6m-3-3v6m2.002 3.464a9 9 0 0 0 .738.863A1 1 0 0 1 20 17H4a1 1 0 0 1-.74-1.673C4.59 13.956 6 12.499 6 8a6 6 0 0 1 8.75-5.332" />
				</svg>
				Push
			</a>
			<% } %>
			<% if (unreadCount > 0) { %>
			<button data-aos="zoom-in" id="notif-page-mark-all" class="w-full md:w-auto flex justify-center items-center gap-2 text-xs md:text-sm btn-normal px-3 py-2 rounded-md text-white">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24">
					<path d="M0 0h24v24H0z" fill="none" />
					<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5h8m-8 7h8m-8 7h8M3 17l2 2l4-4M3 7l2 2l4-4" />
				</svg>
			  Mark all
			</button>
			<% } %>
			<button data-aos="zoom-in" id="notif-page-clear-all" class="w-full md:w-auto flex justify-center items-center gap-2 text-xs md:text-sm btn-failed px-3 py-2 rounded-md text-white">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24">
					<path d="M0 0h24v24H0z" fill="none" />
					<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 11v6m4-6v6m5-11v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
				</svg>
				Clear all
			</button>
		</div>
	</div>

	<!-- Filter Tabs -->
	<div class="flex items-center gap-1 mb-4 p-0.5 card rounded-md w-fit">
		<a data-aos="zoom-in" href="<%= basePath %>/notification" class="px-3 py-1.5 text-sm font-medium rounded-md
		  <%= typeof currentFilter === 'undefined' || !currentFilter ? 'bg-blue-600 dark:blue-500 text-white' : 'hover:text-blue-500 dark:hover:text-blue-400' %>">
		  All
		</a>
		<a data-aos="zoom-in" href="<%= basePath %>/notification?unread=1" class="px-3 py-1.5 text-sm font-medium rounded-md
			<%= typeof currentFilter !== 'undefined' && currentFilter === 'unread' ? 'bg-blue-600 dark:blue-500 text-white' : 'hover:text-blue-500 dark:hover:text-blue-400' %>">
			Unread <% if (unreadCount > 0) { %><span class="ml-1 inline-flex items-center justify-center min-w-[18px] h-[18px] px-1 text-[8px] font-bold text-white bg-rose-500 rounded-full"><%= unreadCount %></span><% } %>
		</a>
	</div>

	<!-- Notifications List -->
	<div class="card border border-gray-200/70 dark:border-gray-700/70 overflow-hidden">
		<% if (notifications.length === 0) { %>
			<div class="px-6 py-16 text-center">
				<h3 data-aos="zoom-in" class="text-lg font-semibold mb-1">No notifications</h3>
				<p data-aos="zoom-in" class="text-sm">You're all caught up! New notifications will appear here.</p>
			</div>
		<% } else { %>
		<div class="bg-gray-100/90 dark:bg-slate-950/70 divide-y divide-gray-200/70 dark:divide-gray-700/70">
			<% notifications.forEach(function(n) { %>
			  <div data-aos="zoom-in" class="notification-row flex items-center gap-3 px-4 py-3 
				<%= n.type === 'admin_push' ? 'bg-gray-100/90 dark:bg-slate-950/70 cursor-pointer' : '' %>
				<%= !n.is_read ? 'bg-white dark:bg-slate-900/50' : '' %>"
				data-id="<%= n.id %>" data-link="<%= n.type === 'admin_push' ? (n.link || '') : '' %>" data-type="<%= n.type %>">
				<!-- Icon -->
				<div class="shrink-0">
				  <% const iconColor = {
					'new_user': 'text-blue-500',
					'transaction_approved': 'text-emerald-500',
					'transaction_rejected': 'text-rose-500',
					'transaction_pending': 'text-amber-500',
					'credit_add': 'text-emerald-500',
					'credit_deduct': 'text-rose-500',
					'verification_approved': 'text-blue-500',
					'verification_rejected': 'text-rose-500',
					'verification_pending': 'text-amber-500',
					'system_alert': 'text-orange-500',
					'admin_push': 'text-purple-500',
					'payment_proof_uploaded': 'text-cyan-500',
					'profile_updated': 'text-teal-500',
					'api_key_limit_warning': 'text-amber-500',
					'package_changed': 'text-indigo-500'
				  }; %>
				  <div class="flex h-9 w-9 lg:h-12 lg:w-12 items-center justify-center rounded-full
					<%= iconColor[n.type] || 'text-gray-500' %>
					<%= ['transaction_approved', 'credit_add', 'verification_approved', 'new_user', 'profile_updated'].includes(n.type)
					  ? 'bg-emerald-100 dark:bg-emerald-900/30'
					  : ['transaction_rejected', 'credit_deduct', 'verification_rejected', 'system_alert'].includes(n.type)
						? 'bg-rose-100 dark:bg-rose-900/30'
						: ['transaction_pending', 'verification_pending', 'api_key_limit_warning'].includes(n.type)
						  ? 'bg-amber-100 dark:bg-amber-900/30'
						  : ['admin_push'].includes(n.type)
							? 'bg-purple-100 dark:bg-purple-900/30'
							: 'bg-gray-100 dark:bg-gray-800'
					%>">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 lg:h-6 lg:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					  <% if (n.type === 'new_user') { %>
						<path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
					  <% } else if (n.type === 'transaction_approved') { %>
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
					  <% } else if (n.type === 'transaction_rejected') { %>
						<path stroke-linecap="round" stroke-linejoin="round" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
					  <% } else if (n.type === 'transaction_pending') { %>
						<path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
					  <% } else if (n.type === 'credit_add') { %>
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6"/>
					  <% } else if (n.type === 'credit_deduct') { %>
						<path stroke-linecap="round" stroke-linejoin="round" d="M18 12H6"/>
					  <% } else if (n.type === 'verification_approved') { %>
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138z"/>
					  <% } else if (n.type === 'verification_rejected') { %>
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
					  <% } else if (n.type === 'admin_push') { %>
						<path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>
					  <% } else if (n.type === 'system_alert') { %>
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
					  <% } else if (n.type === 'payment_proof_uploaded') { %>
						<path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
					  <% } else if (n.type === 'profile_updated') { %>
						<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
					  <% } else if (n.type === 'api_key_limit_warning') { %>
						<path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
					  <% } else if (n.type === 'package_changed') { %>
						<path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
					  <% } else if (n.type === 'low_credit_warning') { %>
						<path stroke-linecap="round" stroke-linejoin="round" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"/>
					  <% } else if (n.type === 'credit_exhausted') { %>
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
					  <% } else if (n.type === 'package_expiring') { %>
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
					  <% } else if (n.type === 'package_expired') { %>
						<path stroke-linecap="round" stroke-linejoin="round" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
					  <% } else if (n.type === 'new_login') { %>
						<path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
					  <% } else if (n.type === 'system_maintenance') { %>
						<path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
					  <% } else { %>
						<path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
					  <% } %>
					</svg>
				  </div>
				</div>
				<!-- Content -->
				<div class="flex-1 min-w-0">
				  <div class="flex items-start justify-between gap-2">
					<div class="min-w-0">
					  <h6 class="flex items-center gap-2 text-sm font-semibold">
						<%= n.title %>
						<% if (!n.is_read) { %>
							<div class="relative flex h-2 w-2 items-center justify-center">
							  <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-rose-500 opacity-75"></span>
							  <span class="relative inline-flex h-2 w-2 opacity-60 rounded-full bg-rose-500"></span>
							</div>
						<% } %>
					  </h6>
					  <p class="text-sm mt-0.5"><%= n.message %></p>
					  <% if (n.image_url) { %>
						<div class="mt-2 overflow-hidden">
						  <img src="<%= n.image_url %>" alt="" class="w-auto h-34 object-contain rounded-lg" onerror="this.parentElement.remove()">
						</div>
					  <% } %>
					</div>
					<button class="notif-delete-btn shrink-0 p-1 text-rose-500 rounded-full hover:bg-gray-200/70 dark:hover:bg-gray-800/70" data-id="<%= n.id %>" title="Delete">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">
							<path d="M0 0h24v24H0z" fill="none" />
							<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 6L6 18M6 6l12 12" />
						</svg>
					</button>
				  </div>
				  <div class="flex items-center gap-3 mt-1.5">
					<span class="text-xs flex items-center gap-1">
						<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
							<path d="M0 0h24v24H0z" fill="none" />
							<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
								<circle cx="12" cy="12" r="10" />
								<path d="M12 6v6l4 2" />
							</g>
						</svg>
						<%= helpers.timeAgo(n.created_at) %>
					</span>
					<% if (n.link && n.type === 'admin_push') { %>
					  <a href="<%= n.link %>" class="text-xs font-medium link flex items-center gap-1">
						View
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">
							<path d="M0 0h24v24H0z" fill="none" />
							<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h10v10M7 17L17 7" />
						</svg>
					  </a>
					<% } %>
				  </div>
				</div>
			  </div>
			<% }); %>
		</div>

		<% if (pagination && pagination.totalPages > 1) { %>
        <div class="flex items-center justify-between gap-4 border-t border-gray-200/70 dark:border-gray-800/70 mt-2 p-2">
          <p data-aos="zoom-in" class="text-xs">
            Showing
            <span class="font-medium"><%= (pagination.currentPage - 1) * 20 + 1 %>-<%= Math.min(pagination.currentPage * 20, pagination.total) %></span>
            from
            <span class="font-medium"><%= pagination.total %></span>
          </p>
          <nav data-aos="zoom-in" class="flex items-center gap-1">
            <% pagination.pages.forEach(function(p) { %>
              <% if (p === '...') { %>
                <span class="flex h-8 min-w-8 items-center justify-center px-1 text-xs">...</span>
              <% } else { %>
                <a href="<%= basePath %>/notification?page=<%= p %><%= currentFilter === 'unread' ? '&unread=1' : '' %>"
                   class="flex h-6 min-w-6 items-center justify-center rounded p-1 text-xs font-medium
                   <%= p === pagination.currentPage
                     ? 'bg-blue-500 dark:bg-blue-600 text-white'
                     : 'bg-gray-200 hover:bg-gray-300 dark:bg-gray-800 dark:hover:bg-gray-700' %>">
                  <%= p %>
                </a>
              <% } %>
            <% }); %>
          </nav>
        </div>
		<% } %>
    <% } %>
  </div>
</div>

<%
pageScript = `
<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.notification-row').forEach(function(row) {
    row.addEventListener('click', function(e) {
      if (e.target.closest('.notif-delete-btn')) return;
      var type = this.dataset.type;
      var link = this.dataset.link;
      if (type !== 'admin_push') return;
      var id = this.dataset.id;
      var unread = this.classList.contains('bg-blue-50/30') || this.classList.contains('dark:bg-blue-950/10');
      if (unread) {
        fetch('/notifications/mark-read/' + id, { method: 'POST' })
          .then(function(r) { return r.json(); })
          .then(function() {
            if (link) window.location.href = link;
            else location.reload();
          });
      } else if (link) {
        window.location.href = link;
      }
    });
  });

  document.querySelectorAll('.notif-delete-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      var id = this.dataset.id;
      fetch('/notifications/' + id, { method: 'DELETE' }).then(function() { location.reload(); });
    });
  });

  var markAll = document.getElementById('notif-page-mark-all');
  if (markAll) {
    markAll.addEventListener('click', function() {
      fetch('/notifications/mark-all-read', { method: 'POST' }).then(function() { location.reload(); });
    });
  }

  var clearAll = document.getElementById('notif-page-clear-all');
  if (clearAll) {
    clearAll.addEventListener('click', function() {
      if (confirm('Delete all notifications? This cannot be undone.')) {
        fetch('/notifications', { method: 'DELETE' }).then(function() { location.reload(); });
      }
    });
  }
});
</script>
`;
%>
