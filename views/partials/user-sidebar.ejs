	<div class="shrink-0 border-t border-gray-200/70 dark:border-gray-800/70 p-4 flex gap-4 justify-between items-center px-2">
		<div class="flex flex-1 items-center gap-3">
			<div class="relative flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-orange-200 dark:bg-orange-900">
				<% const currentUser = typeof user !== 'undefined' && user ? user : userData; %>
                <% if (currentUser && currentUser.avatar) { %>
                    <img src="<%= currentUser.avatar %>" alt="Avatar" class="h-full w-full object-cover rounded-full">
                <% } else { %>
                    <span class="text-sm font-bold text-orange-700 dark:text-orange-200">
                        <%= currentUser && currentUser.full_name ? currentUser.full_name.charAt(0).toUpperCase() : 'A' %>
                    </span>
                <% } %>
				<% if (currentUser && currentUser.is_verified) { %>
					<div class="absolute -top-1 -right-1 bg-white dark:bg-slate-900 rounded-full">
						<span class="text-blue-500 flex-shrink-0">
							<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
								<path d="M0 0h24v24H0z" fill="none" />
								<path fill="currentColor" d="M19.965 8.521Q20 8.26 20 8c0-2.379-2.143-4.288-4.521-3.965C14.786 2.802 13.466 2 12 2s-2.786.802-3.479 2.035C6.138 3.712 4 5.621 4 8q0 .26.035.521C2.802 9.215 2 10.535 2 12s.802 2.785 2.035 3.479A4 4 0 0 0 4 16c0 2.379 2.138 4.283 4.521 3.965C9.214 21.198 10.534 22 12 22s2.786-.802 3.479-2.035C17.857 20.283 20 18.379 20 16q0-.26-.035-.521C21.198 14.785 22 13.465 22 12s-.802-2.785-2.035-3.479m-9.01 7.895l-3.667-3.714l1.424-1.404l2.257 2.286l4.327-4.294l1.408 1.42z" />
							</svg>
						</span>
					</div>
				<% } %>
			</div>
			<div class="hidden leading-tight sm:block">
				<h3 class="truncate text-sm font-medium"><%= typeof user !== 'undefined' && user ? user.full_name || user.full_name : 'Admin' %></h3>
				<p class="text-xs">@<%= typeof user !== 'undefined' && user ? user.username || user.username : '-' %></p>
			</div>
		</div>
		<a href="/auth/logout" title="Logout" class="rounded-md p-1 hover:bg-rose-500 dark:hover:bg-rose-800 hover:text-white">
