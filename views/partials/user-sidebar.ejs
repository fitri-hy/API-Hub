<aside id="sidebar" class="fixed inset-y-0 left-0 z-50 flex w-64 -translate-x-full md:translate-x-0 flex-col transition-transform duration-300 ease-in-out border-r border-gray-200/70 dark:border-gray-800/70 bg-white dark:bg-slate-900 md:bg-white/60 md:dark:bg-slate-900/60">
