<% if (typeof flash !== 'undefined') { %>
  <div class="fixed bottom-5 right-5 z-50 flex flex-col gap-3 pointer-events-none">
    
    <% if (flash.error && flash.error.length > 0) { %>
      <% flash.error.forEach(function(err) { %>
        <div class="flash-alert pointer-events-auto shadow-lg transition-opacity duration-500 rounded-md bg-red-50 border border-red-200/70 p-3 flex items-center gap-2">
          <svg class="h-5 w-5 text-red-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
          </svg>
          <p class="text-sm text-red-700"><%= err %></p>
        </div>
      <% }) %>
    <% } %>

    <% if (flash.success && flash.success.length > 0) { %>
      <% flash.success.forEach(function(msg) { %>
        <div class="flash-alert pointer-events-auto shadow-lg transition-opacity duration-500 rounded-md bg-green-50 border border-green-200/70 p-3 flex items-center gap-2">
          <svg class="h-5 w-5 text-green-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <p class="text-sm text-green-700"><%= msg %></p>
        </div>
      <% }) %>
    <% } %>

  </div>
<% } %>