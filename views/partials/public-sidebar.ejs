<div id="public-sidebar-overlay" class="fixed inset-0 z-[50] hidden bg-black/50 lg:hidden"></div>

<aside id="public-sidebar" class="lg:hidden fixed inset-y-0 left-0 z-[60] flex w-72 -translate-x-full flex-col bg-white shadow-xl transition-transform duration-300 dark:bg-slate-950">
	<div class="flex h-16 shrink-0 items-center justify-between border-b border-slate-200 px-5 dark:border-slate-800">
		<a href="/" class="flex items-center gap-2">
			<% if (typeof site_logo !== 'undefined' && site_logo) { %>
				<img class="h-8 w-8 rounded-full object-cover" src="<%= site_logo %>" alt="<%= title || appname || 'My App' %>" />
			<% } else { %>
				<img class="h-8 w-8 rounded-full object-cover" src="/images/logo.webp" alt="<%= title || 'My App' %>" />
			<% } %>
			<h1 class="text-xl font-black tracking-tight">
			  <%= appname || 'My App' %>
			</h1>
		</a>
		<button type="button" data-public-sidebar-close class="flex h-9 w-9 items-center justify-center rounded-lg lg:hidden text-rose-500">
			<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24">
				<path d="M0 0h24v24H0z" fill="none" />
				<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m18 18l-6-6m0 0L6 6m6 6l6-6m-6 6l-6 6" />
			</svg>
		</button>
	</div>

	<nav class="text-lg flex flex-col gap-1 px-4 py-6">
		<a href="/" class="navlink link-hover" data-path="/">
			Home
		</a>
		<a href="/browser-apis" class="navlink link-hover" data-path="/browser-apis">
			Bowser APIs
		</a>
		<a href="/referral" class="navlink link-hover" data-path="/referral">
			Referral
		</a>
		<a href="/about" class="navlink link-hover" data-path="/about">
			About
		</a>
	</nav>
</aside>