<header class="sticky top-0 z-30 flex items-center justify-between gap-6 p-4 bg-header">
	
	<div class="flex items-center gap-2">
		<button id="sidebar-toggle" type="button" class="md:hidden relative flex items-center justify-center p-2 rounded-md hover:bg-slate-200/60 dark:hover:bg-slate-700/60" aria-label="Open menu">
			<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
			</svg>
		</button>
		<div class="md:hidden h-8 w-px bg-gray-200/70 dark:bg-gray-700/70 sm:block"></div>
		<div class="flex min-w-0 items-center">
			<div class="min-w-0">
				<h1 class="truncate font-bold tracking-tight text-lg"><%= title || 'Dashboard' %></h1>
			</div>
		</div>
	</div>
	
	<div class="ml-auto flex items-center gap-3">
		<%- include('notification-dropdown') %>
		<div class="flex items-center gap-2.5">
			<div class="relative flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-orange-200 dark:bg-orange-900">
				<% const currentUser = typeof user !== 'undefined' && user ? user : userData; %>
                <% if (currentUser && currentUser.avatar) { %>
                    <img src="<%= currentUser.avatar %>" alt="Avatar" class="h-full w-full object-cover rounded-full">
                <% } else { %>
                    <span class="text-sm font-bold text-orange-700 dark:text-orange-200">
                        <%= currentUser && currentUser.full_name ? currentUser.full_name.charAt(0).toUpperCase() : 'A' %>
                    </span>
                <% } %>
				<% if (currentUser && currentUser.is_verified) { %>
					<div class="absolute -top-1 -right-1 bg-white dark:bg-slate-900 rounded-full">
						<span class="text-blue-500 flex-shrink-0">
							<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
								<path d="M0 0h24v24H0z" fill="none" />
								<path fill="currentColor" d="M19.965 8.521Q20 8.26 20 8c0-2.379-2.143-4.288-4.521-3.965C14.786 2.802 13.466 2 12 2s-2.786.802-3.479 2.035C6.138 3.712 4 5.621 4 8q0 .26.035.521C2.802 9.215 2 10.535 2 12s.802 2.785 2.035 3.479A4 4 0 0 0 4 16c0 2.379 2.138 4.283 4.521 3.965C9.214 21.198 10.534 22 12 22s2.786-.802 3.479-2.035C17.857 20.283 20 18.379 20 16q0-.26-.035-.521C21.198 14.785 22 13.465 22 12s-.802-2.785-2.035-3.479m-9.01 7.895l-3.667-3.714l1.424-1.404l2.257 2.286l4.327-4.294l1.408 1.42z" />
							</svg>
						</span>
					</div>
				<% } %>
			</div>
			<div class="hidden leading-tight sm:block">
				<h6 class="max-w-28 truncate text-sm font-semibold"><%= typeof user !== 'undefined' && user ? user.full_name || user.full_name : 'Admin' %></h6>
				<p class="text-xs">@<%= typeof user !== 'undefined' && user ? user.username || user.username : '-' %></p>
			</div>
		</div>
		<button type="button" id="theme-toggle" aria-label="Toggle theme" class="relative flex items-center justify-center text-amber-500 h-8 w-8 rounded-full hover:bg-slate-200/60 dark:hover:bg-slate-700/60">
			<svg id="theme-sun" xmlns="http://www.w3.org/2000/svg" class="absolute h-6 w-6 scale-100 rotate-0 transition-all duration-300 dark:scale-0 dark:-rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
				<circle cx="12" cy="12" r="4" />
				<path stroke-linecap="round" d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" />
			</svg>
			<svg id="theme-moon" xmlns="http://www.w3.org/2000/svg" class="absolute h-6 w-6 scale-0 rotate-90 transition-all duration-300 dark:scale-100 dark:rotate-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
				<path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
			</svg>
		</button>
	</div>
	
</header>