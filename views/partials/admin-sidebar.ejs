<aside id="sidebar" class="fixed inset-y-0 left-0 z-50 flex w-64 -translate-x-full md:translate-x-0 flex-col transition-transform duration-300 ease-in-out border-r border-gray-200/70 dark:border-gray-800/70 bg-white dark:bg-slate-900 md:bg-white/60 md:dark:bg-slate-900/60">
	<button type="button" data-sidebar-close class="md:hidden absolute z-10 top-2 right-2 rounded-full p-1.5 hover:bg-slate-200/60 dark:hover:bg-slate-700/60 text-rose-500" aria-label="close menu">
		<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
		</svg>
	</button>
	<div class="flex items-center gap-2 p-4">
		<img class="h-10 w-10 rounded-full object-cover" src="<%= site_logo %>" alt="API Hub" />
		<h1 class="text-2xl font-extrabold tracking-tight uppercase font-sans antialiased">
			<%= appname %>
		</h1>
	</div>
	<nav class="flex-1 space-y-1 overflow-y-auto px-3 py-4 text-base">
		<% if (isAuthenticated && user.role !== 'user') { %>
			<a href="/user/dashboard" class="mb-6 flex items-center gap-2 p-2.5 rounded-md group bg-gradient-to-br from-indigo-50 to-purple-50 dark:from-indigo-500/10 dark:to-purple-500/10 border border-indigo-100/60 dark:border-indigo-500/10 hover:from-indigo-100 hover:to-purple-100 dark:hover:from-indigo-500/15 dark:hover:to-purple-500/15gap-3 rounded px-3 py-2.5">
				<div class="w-9 h-9 rounded-lg flex items-center justify-center bg-white dark:bg-gray-800 shrink-0">
					<svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
				</div>
				<div class="flex-1 min-w-0">
					<div class="text-sm font-semibold text-gray-800 dark:text-white truncate">Access Client Area</div>
					<div class="text-xs text-gray-500 dark:text-gray-400 truncate">Switch to client dashboard</div>
				</div>
				<svg class="w-4 h-4 text-gray-400 group-hover:text-indigo-500 group-hover:translate-x-1 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
			</a>
		<% } %>

		<a href="/admin/dashboard" data-path="/admin/dashboard" class="sidebar-link group flex items-center gap-3 rounded px-3 py-2.5 font-medium text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-100 hover:bg-blue-100/70 dark:hover:bg-blue-950/70 hover:font-semibold">
			<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24">
				<path d="M0 0h24v24H0z" fill="none" />
				<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
					<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8" />
					<path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
				</g>
			</svg>
			Dashboard
		</a>

		<p class="px-3 pt-5 pb-1.5 text-[10px] font-bold uppercase tracking-wider">Content</p>

		<a href="/admin/apis" data-path="/admin/apis" class="sidebar-link flex items-center gap-3 rounded px-3 py-2.5 font-medium text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-100 hover:bg-blue-100/70 dark:hover:bg-blue-950/70 hover:font-semibold">
			<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24">
				<path d="M0 0h24v24H0z" fill="none" />
				<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 2v6.292a7 7 0 1 0 4 0V2M5 15h14M8.5 2h7" />
			</svg>
			APIs
		</a>

		<a href="/admin/packages" data-path="/admin/packages" class="sidebar-link flex items-center gap-3 rounded px-3 py-2.5 font-medium text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-100 hover:bg-blue-100/70 dark:hover:bg-blue-950/70 hover:font-semibold">
			<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24">
				<path d="M0 0h24v24H0z" fill="none" />
				<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v6m4.76-6a2 2 0 0 1 1.8 1.1l2.23 4.479a2 2 0 0 1 .21.891V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9.472a2 2 0 0 1 .211-.894L5.45 4.1A2 2 0 0 1 7.24 3zM3.054 9.013h17.893" />
			</svg>
			Packages
		</a>

		<p class="px-3 pt-5 pb-1.5 text-[10px] font-bold uppercase tracking-wider">Management</p>

		<a href="/admin/transactions" data-path="/admin/transactions" class="sidebar-link flex items-center gap-3 rounded px-3 py-2.5 font-medium text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-100 hover:bg-blue-100/70 dark:hover:bg-blue-950/70 hover:font-semibold">
			<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24">
				<path d="M0 0h24v24H0z" fill="none" />
				<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
					<path d="M2.048 18.566A2 2 0 0 0 4 21h16a2 2 0 0 0 1.952-2.434l-2-9A2 2 0 0 0 18 8H6a2 2 0 0 0-1.952 1.566z" />
					<path d="M8 11V6a4 4 0 0 1 8 0v5" />
				</g>
			</svg>
			Transactions
		</a>

		<a href="/admin/credit-logs" data-path="/admin/credit-logs" class="sidebar-link flex items-center gap-3 rounded px-3 py-2.5 font-medium text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-100 hover:bg-blue-100/70 dark:hover:bg-blue-950/70 hover:font-semibold">
			<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24">
				<path d="M0 0h24v24H0z" fill="none" />
				<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
					<path d="M12 17V7m4 1h-6a2 2 0 0 0 0 4h4a2 2 0 0 1 0 4H8" />
					<path d="M4 3a1 1 0 0 1 1-1a1.3 1.3 0 0 1 .7.2l.933.6a1.3 1.3 0 0 0 1.4 0l.934-.6a1.3 1.3 0 0 1 1.4 0l.933.6a1.3 1.3 0 0 0 1.4 0l.933-.6a1.3 1.3 0 0 1 1.4 0l.934.6a1.3 1.3 0 0 0 1.4 0l.933-.6A1.3 1.3 0 0 1 19 2a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1a1.3 1.3 0 0 1-.7-.2l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.934.6a1.3 1.3 0 0 1-1.4 0l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-1.4 0l-.934-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-.7.2a1 1 0 0 1-1-1z" />
				</g>
			</svg>
			Credit Logs
		</a>

		<a href="/admin/logs" data-path="/admin/logs" class="sidebar-link flex items-center gap-3 rounded px-3 py-2.5 font-medium text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-100 hover:bg-blue-100/70 dark:hover:bg-blue-950/70 hover:font-semibold">
			<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24">
				<path d="M0 0h24v24H0z" fill="none" />
				<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16H8m6-8H8m8 4H8M4 3a1 1 0 0 1 1-1a1.3 1.3 0 0 1 .7.2l.933.6a1.3 1.3 0 0 0 1.4 0l.934-.6a1.3 1.3 0 0 1 1.4 0l.933.6a1.3 1.3 0 0 0 1.4 0l.933-.6a1.3 1.3 0 0 1 1.4 0l.934.6a1.3 1.3 0 0 0 1.4 0l.933-.6A1.3 1.3 0 0 1 19 2a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1a1.3 1.3 0 0 1-.7-.2l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.934.6a1.3 1.3 0 0 1-1.4 0l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-1.4 0l-.934-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-.7.2a1 1 0 0 1-1-1z" />
			</svg>
			API Logs
		</a>

		<a href="/admin/referrals" data-path="/admin/referrals" class="sidebar-link flex items-center gap-3 rounded px-3 py-2.5 font-medium text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-100 hover:bg-blue-100/70 dark:hover:bg-blue-950/70 hover:font-semibold">
			<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24">
				<path d="M0 0h24v24H0z" fill="none" />
				<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
					<path d="m2 9l3-3l3 3" />
					<path d="M13 18H7a2 2 0 0 1-2-2V6m17 9l-3 3l-3-3" />
					<path d="M11 6h6a2 2 0 0 1 2 2v10" />
				</g>
			</svg>
			Referrals
		</a>

		<a href="/admin/users" data-path="/admin/users" class="sidebar-link flex items-center gap-3 rounded px-3 py-2.5 font-medium text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-100 hover:bg-blue-100/70 dark:hover:bg-blue-950/70 hover:font-semibold">
			<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24">
				<path d="M0 0h24v24H0z" fill="none" />
				<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
					<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
					<circle cx="12" cy="7" r="4" />
				</g>
			</svg>
			Users
		</a>

		<% if (typeof notificationsEnabled === 'undefined' || notificationsEnabled) { %>
		<p class="px-3 pt-5 pb-1.5 text-[10px] font-bold uppercase tracking-wider">Notifications</p>

		<a href="/admin/notification" data-path="/admin/notification" class="sidebar-link flex items-center gap-3 rounded px-3 py-2.5 font-medium text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-100 hover:bg-blue-100/70 dark:hover:bg-blue-950/70 hover:font-semibold">
			<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24">
				<path d="M0 0h24v24H0z" fill="none" />
				<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.268 21a2 2 0 0 0 3.464 0m-10.47-5.674A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326" />
			</svg>
			Notifications
		</a>

		<a href="/admin/push-notification" data-path="/admin/push-notification" class="sidebar-link flex items-center gap-3 rounded px-3 py-2.5 font-medium text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-100 hover:bg-blue-100/70 dark:hover:bg-blue-950/70 hover:font-semibold">
			<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24">
				<path d="M0 0h24v24H0z" fill="none" />
				<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.268 21a2 2 0 0 0 3.464 0M15 8h6m-3-3v6m2.002 3.464a9 9 0 0 0 .738.863A1 1 0 0 1 20 17H4a1 1 0 0 1-.74-1.673C4.59 13.956 6 12.499 6 8a6 6 0 0 1 8.75-5.332" />
			</svg>
			Push Notification
		</a>
		<% } %>

		<p class="px-3 pt-5 pb-1.5 text-[10px] font-bold uppercase tracking-wider">System</p>

		<a href="/admin/system-logs" data-path="/admin/system-logs" class="sidebar-link flex items-center gap-3 rounded px-3 py-2.5 font-medium text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-100 hover:bg-blue-100/70 dark:hover:bg-blue-950/70 hover:font-semibold">
			<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24">
				<path d="M0 0h24v24H0z" fill="none" />
				<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h1m-1 7h1m-1 7h1M8 5h1m-1 7h1m-1 7h1m4-14h8m-8 7h8m-8 7h8" />
			</svg>
			System Logs
		</a>

		<a href="/admin/settings" data-path="/admin/settings" class="sidebar-link flex items-center gap-3 rounded px-3 py-2.5 font-medium text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-100 hover:bg-blue-100/70 dark:hover:bg-blue-950/70 hover:font-semibold">
			<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24">
				<path d="M0 0h24v24H0z" fill="none" />
				<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
					<path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0a2.34 2.34 0 0 0 3.319 1.915a2.34 2.34 0 0 1 2.33 4.033a2.34 2.34 0 0 0 0 3.831a2.34 2.34 0 0 1-2.33 4.033a2.34 2.34 0 0 0-3.319 1.915a2.34 2.34 0 0 1-4.659 0a2.34 2.34 0 0 0-3.32-1.915a2.34 2.34 0 0 1-2.33-4.033a2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915" />
					<circle cx="12" cy="12" r="3" />
				</g>
			</svg>
			Settings
		</a>
	</nav>

	<div class="shrink-0 border-t border-gray-200/70 dark:border-gray-800/70 p-4 flex gap-4 justify-between items-center px-2">
		<div class="flex flex-1 items-center gap-3">
			<div class="relative flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-orange-200 dark:bg-orange-900">
				<% const currentUser = typeof user !== 'undefined' && user ? user : userData; %>
                <% if (currentUser && currentUser.avatar) { %>
                    <img src="<%= currentUser.avatar %>" alt="Avatar" class="h-full w-full object-cover rounded-full">
                <% } else { %>
                    <span class="text-sm font-bold text-orange-700 dark:text-orange-200">
                        <%= currentUser && currentUser.full_name ? currentUser.full_name.charAt(0).toUpperCase() : 'A' %>
                    </span>
                <% } %>
				<% if (currentUser && currentUser.is_verified) { %>
					<div class="absolute -top-1 -right-1 bg-white dark:bg-slate-900 rounded-full">
						<span class="text-blue-500 flex-shrink-0">
							<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
								<path d="M0 0h24v24H0z" fill="none" />
								<path fill="currentColor" d="M19.965 8.521Q20 8.26 20 8c0-2.379-2.143-4.288-4.521-3.965C14.786 2.802 13.466 2 12 2s-2.786.802-3.479 2.035C6.138 3.712 4 5.621 4 8q0 .26.035.521C2.802 9.215 2 10.535 2 12s.802 2.785 2.035 3.479A4 4 0 0 0 4 16c0 2.379 2.138 4.283 4.521 3.965C9.214 21.198 10.534 22 12 22s2.786-.802 3.479-2.035C17.857 20.283 20 18.379 20 16q0-.26-.035-.521C21.198 14.785 22 13.465 22 12s-.802-2.785-2.035-3.479m-9.01 7.895l-3.667-3.714l1.424-1.404l2.257 2.286l4.327-4.294l1.408 1.42z" />
							</svg>
						</span>
					</div>
				<% } %>
			</div>
			<div class="hidden leading-tight sm:block">
				<h3 class="truncate text-sm font-medium"><%= typeof user !== 'undefined' && user ? user.full_name || user.full_name : 'Admin' %></h3>
				<p class="text-xs">@<%= typeof user !== 'undefined' && user ? user.username || user.username : '-' %></p>
			</div>
		</div>
		<a href="/auth/logout" title="Logout" class="rounded-md p-1 hover:bg-rose-500 dark:hover:bg-rose-800 hover:text-white">
			<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24">
				<path d="M0 0h24v24H0z" fill="none" />
				<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h6m10 0l-9 9m3-9h6v6" />
			</svg>
		</a>
