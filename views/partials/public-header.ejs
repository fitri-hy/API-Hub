<header class="sticky w-full top-0 z-50 bg-header">
	<div class="container mx-auto flex items-center justify-between gap-9 p-4">
		<div class="flex items-center gap-2">
			<button data-aos="zoom-in" id="public-sidebar-toggle" type="button" class="flex h-9 w-9 items-center justify-center rounded-lg lg:hidden">
				<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
			</button>
			<a data-aos="zoom-in" href="/" class="flex items-center gap-2">
				<% if (typeof site_logo !== 'undefined' && site_logo) { %>
					<img class="h-8 w-8 rounded-full object-cover" src="<%= site_logo %>" alt="<%= title || appname || 'My App' %>" />
				<% } else { %>
					<img class="h-8 w-8 rounded-full object-cover" src="/images/logo.webp" alt="<%= title || 'My App' %>" />
				<% } %>
				<h1 class="text-xl font-black tracking-tight">
				  <%= appname || 'My App' %>
				</h1>
			</a>
		</div>
		<div class="flex items-center gap-6">
			<nav class="hidden lg:flex items-center gap-6">
				<a data-aos="zoom-in" href="/" class="navlink link-hover" data-path="/">
					Home
				</a>
				<a data-aos="zoom-in" href="/browser-apis" class="navlink link-hover" data-path="/browser-apis">
					Bowser APIs
				</a>
				<a data-aos="zoom-in" href="/referral" class="navlink link-hover" data-path="/referral">
					Referral
				</a>
				<a data-aos="zoom-in" href="/about" class="navlink link-hover" data-path="/about">
					About
				</a>
			</nav>
			<div data-aos="zoom-in" class="hidden lg:flex h-6 w-px bg-gray-200/70 dark:bg-gray-700/70"></div>
			<div class="flex items-center gap-2 text-gray-800 dark:text-gray-200">
				<button data-aos="zoom-in" type="button" id="theme-toggle" aria-label="Toggle theme" class="relative flex items-center justify-center text-amber-500 h-8 w-8 rounded-full hover:bg-slate-200/60 dark:hover:bg-slate-700/60">
					<svg id="theme-sun" xmlns="http://www.w3.org/2000/svg" class="absolute h-6 w-6 scale-100 rotate-0 transition-all duration-300 dark:scale-0 dark:-rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
					  <circle cx="12" cy="12" r="4" />
					  <path stroke-linecap="round" d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" />
					</svg>
					<svg id="theme-moon" xmlns="http://www.w3.org/2000/svg" class="absolute h-6 w-6 scale-0 rotate-90 transition-all duration-300 dark:scale-100 dark:rotate-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
					  <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
					</svg>
				</button>
				<% if (isAuthenticated) { %>
				<a data-aos="zoom-in" href="<%= userRole === 'admin' ? '/admin/dashboard' : 'user/dashboard' %>" class="rounded-full p-1.5 hover:bg-slate-200/60 dark:hover:bg-slate-700/60">
					<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 32 32">
						<path d="M0 0h32v32H0z" fill="none" />
						<path fill="currentColor" d="M4 20v2h4.586L2 28.586L3.414 30L10 23.414V28h2v-8zm20 1h2v5h-2zm-4-5h2v10h-2zm-4 2h2v8h-2z" />
						<path fill="currentColor" d="M28 2H4a2 2 0 0 0-2 2v12h2v-3h24.001l.001 15H16v2h12a2.003 2.003 0 0 0 2-2V4a2 2 0 0 0-2-2m-16 9H4V4h8Zm2 0V4h14v7Z" />
					</svg>
				</a>
				<% } else { %>
				<a data-aos="zoom-in" href="/auth/login" class="rounded-full p-1.5 hover:bg-slate-200/60 dark:hover:bg-slate-700/60">
					<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 1024 1024">
						<path d="M0 0h1024v1024H0z" fill="none" />
						<path fill="currentColor" d="M521.7 82c-152.5-.4-286.7 78.5-363.4 197.7c-3.4 5.3.4 12.3 6.7 12.3h70.3c4.8 0 9.3-2.1 12.3-5.8c7-8.5 14.5-16.7 22.4-24.5c32.6-32.5 70.5-58.1 112.7-75.9c43.6-18.4 90-27.8 137.9-27.8s94.3 9.3 137.9 27.8c42.2 17.8 80.1 43.4 112.7 75.9s58.1 70.4 76 112.5C865.7 417.8 875 464.1 875 512s-9.4 94.2-27.8 137.8c-17.8 42.1-43.4 80-76 112.5s-70.5 58.1-112.7 75.9A352.8 352.8 0 0 1 520.6 866c-47.9 0-94.3-9.4-137.9-27.8A353.8 353.8 0 0 1 270 762.3c-7.9-7.9-15.3-16.1-22.4-24.5c-3-3.7-7.6-5.8-12.3-5.8H165c-6.3 0-10.2 7-6.7 12.3C234.9 863.2 368.5 942 520.6 942c236.2 0 428-190.1 430.4-425.6C953.4 277.1 761.3 82.6 521.7 82M395.02 624v-76h-314c-4.4 0-8-3.6-8-8v-56c0-4.4 3.6-8 8-8h314v-76c0-6.7 7.8-10.5 13-6.3l141.9 112a8 8 0 0 1 0 12.6l-141.9 112c-5.2 4.1-13 .4-13-6.3" />
					</svg>
				</a>
				<% } %>
			</div>
		</div>
	</div>
</header>