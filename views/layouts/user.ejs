<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <%- include('../partials/head') %>
  
  <% if (typeof pageHead !== 'undefined' && pageHead) { %>
    <%- pageHead %>
    <% pageHead = undefined; %>
  <% } %>
</head>

<body class="bg min-h-screen select-none">
	<div class="min-h-screen">
		<div id="sidebar-overlay" class="fixed inset-0 z-40 hidden bg-black/50 md:hidden"></div>
		<%- include('../partials/user-sidebar') %>
		<div class="w-full min-h-screen md:pl-64">
			<%- include('../partials/user-header.ejs') %>
			<main class="min-h-[calc(100vh-4rem)] p-4">
				<%- body %>
			</main>
		</div>
	</div>
	<%- include('../partials/flash.ejs') %>
	<script src="/js/script.js"></script>
	<script src="/socket.io/socket.io.js"></script>
	<script src="/js/notifications.js"></script>
	<% if (typeof pageScript !== 'undefined' && pageScript) { %>
		<%- pageScript %>
		<% pageScript = undefined; %>
	<% } %>
</body>
</html>
