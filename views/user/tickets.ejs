<div class="flex items-center justify-between card px-4 py-3 mb-4 gap-4">
	<div>
		<h2 class="text-sm font-bold mb-1">My Help Center</h2>
		<p class="text-xs">
			Manage webhook your support tickets
		</p>
	</div>
	<div class="flex items-center gap-4">
		<a href="/user/tickets/create" class="flex items-center gap-1 btn-normal text-sm px-2 py-2 md:px-4 md:py-2 rounded-md">
			<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path></svg>
			<span class="hidden md:flex">Create Ticket</span>
		</a>
	</div>
</div>

<!-- Stats -->
<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
  <div data-aos="zoom-in" class="card p-4">
    <h4 class="text-[10px] font-semibold uppercase tracking-wider">Total</h4>
    <p class="text-2xl font-bold mt-1"><%= helpers.formatNumber(stats.total) %></p>
  </div>
  <div data-aos="zoom-in" class="card p-4">
    <div class="flex items-center gap-2">
      <div class="w-2 h-2 rounded-full bg-blue-500"></div>
      <h4 class="text-[10px] font-semibold uppercase tracking-wider">Open</h4>
    </div>
    <p class="text-2xl font-bold mt-1"><%= helpers.formatNumber(stats.open) %></p>
  </div>
  <div data-aos="zoom-in" class="card p-4">
    <div class="flex items-center gap-2">
      <div class="w-2 h-2 rounded-full bg-emerald-500"></div>
      <h4 class="text-[10px] font-semibold uppercase tracking-wider">Resolved</h4>
    </div>
    <p class="text-2xl font-bold mt-1"><%= helpers.formatNumber(stats.resolved) %></p>
  </div>
  <div data-aos="zoom-in" class="card p-4">
    <div class="flex items-center gap-2">
      <div class="w-2 h-2 rounded-full bg-gray-400"></div>
      <h4 class="text-[10px] font-semibold uppercase tracking-wider">Closed</h4>
    </div>
    <p class="text-2xl font-bold mt-1"><%= helpers.formatNumber(stats.closed) %></p>
  </div>
</div>

<!-- Filters -->
<div data-aos="zoom-in" class="card mb-4">
  <form method="GET" action="/user/tickets" class="p-4 flex flex-wrap gap-3 items-end">
    <div class="flex-1 min-w-[200px]">
      <label class="block text-xs font-semibold mb-1">Search</label>
      <input type="text" name="search" value="<%= filters.search || '' %>" placeholder="Search by subject or ticket #..." class="text-sm bg-form px-4 py-2 w-full">
    </div>
    <div class="w-[150px]">
      <label class="block text-xs font-semibold mb-1">Status</label>
      <select name="status" class="text-sm bg-form px-4 py-2 w-full">
        <option value="">All Status</option>
        <option value="open" <%= filters.status === 'open' ? 'selected' : '' %>>Open</option>
        <option value="in_progress" <%= filters.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
        <option value="waiting_reply" <%= filters.status === 'waiting_reply' ? 'selected' : '' %>>Waiting Reply</option>
        <option value="resolved" <%= filters.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
        <option value="closed" <%= filters.status === 'closed' ? 'selected' : '' %>>Closed</option>
      </select>
    </div>
    <div class="w-[150px]">
      <label class="block text-xs font-semibold mb-1">Category</label>
      <select name="category" class="text-sm bg-form px-4 py-2 w-full">
        <option value="">All Categories</option>
        <option value="technical" <%= filters.category === 'technical' ? 'selected' : '' %>>Technical</option>
        <option value="feature_request" <%= filters.category === 'feature_request' ? 'selected' : '' %>>Feature Request</option>
        <option value="bug_report" <%= filters.category === 'bug_report' ? 'selected' : '' %>>Bug Report</option>
        <option value="billing" <%= filters.category === 'billing' ? 'selected' : '' %>>Billing</option>
        <option value="account" <%= filters.category === 'account' ? 'selected' : '' %>>Account</option>
        <option value="api_issue" <%= filters.category === 'api_issue' ? 'selected' : '' %>>API Issue</option>
        <option value="other" <%= filters.category === 'other' ? 'selected' : '' %>>Other</option>
      </select>
    </div>
		<button type="submit" class="p-2 rounded-md btn-normal">
			<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24">
				<path d="M0 0h24v24H0z" fill="none"></path>
				<path fill="none" stroke="currentColor" stroke-width="1.5" d="M19 3H5C3.58579 3 2.87868 3 2.43934 3.4122C2 3.8244 2 4.48782 2 5.81466V6.50448C2 7.54232 2 8.06124 2.2596 8.49142C2.5192 8.9216 2.99347 9.18858 3.94202 9.72255L6.85504 11.3624C7.49146 11.7206 7.80967 11.8998 8.03751 12.0976C8.51199 12.5095 8.80408 12.9935 8.93644 13.5872C9 13.8722 9 14.2058 9 14.8729L9 17.5424C9 18.452 9 18.9067 9.25192 19.2613C9.50385 19.6158 9.95128 19.7907 10.8462 20.1406C12.7248 20.875 13.6641 21.2422 14.3321 20.8244C15 20.4066 15 19.4519 15 17.5424V14.8729C15 14.2058 15 13.8722 15.0636 13.5872C15.1959 12.9935 15.488 12.5095 15.9625 12.0976C16.1903 11.8998 16.5085 11.7206 17.145 11.3624L20.058 9.72255C21.0065 9.18858 21.4808 8.9216 21.7404 8.49142C22 8.06124 22 7.54232 22 6.50448V5.81466C22 4.48782 22 3.8244 21.5607 3.4122C21.1213 3 20.4142 3 19 3Z"></path>
			</svg>
		</button>
	</form>
</div>

<!-- Tickets List -->
<div data-aos="zoom-in" class="card">
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead>
        <tr class="text-xs font-medium uppercase tracking-wider border-b border-gray-200/70 dark:border-gray-800/70">
          <th class="px-4 py-3 text-left">Ticket</th>
          <th class="px-4 py-3 text-left">Subject</th>
          <th class="px-4 py-3 text-center">Category</th>
          <th class="px-4 py-3 text-center">Priority</th>
          <th class="px-4 py-3 text-center">Status</th>
          <th class="px-4 py-3 text-center">Replies</th>
          <th class="px-4 py-3 text-right">Updated</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200/70 dark:divide-gray-800/70">
        <% if (tickets && tickets.length > 0) { %>
          <% tickets.forEach(function(ticket) { %>
            <tr class="hover:bg-gray-100 dark:hover:bg-gray-800/30 cursor-pointer" onclick="window.location='/admin/tickets/<%= ticket.id %>'">
              <td class="px-4 py-3">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-mono font-semibold text-blue-600 dark:text-blue-400"><%= ticket.ticket_number %></span>
                  <% if (ticket.unread_count > 0) { %>
                    <span class="flex h-4 w-4 items-center justify-center rounded-full bg-rose-500 text-[9px] font-bold text-white"><%= ticket.unread_count %></span>
                  <% } %>
                </div>
              </td>
              <td class="px-4 py-3">
                <span class="text-sm font-medium truncate max-w-[250px] block"><%= ticket.subject %></span>
              </td>
              <td class="px-4 py-3 text-center">
                <span class="text-[10px] font-semibold uppercase"><%= SupportTicket.getCategoryLabel(ticket.category) %></span>
              </td>
              <td class="px-4 py-3 text-center">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold <%= SupportTicket.getPriorityColor(ticket.priority) %>">
                  <%= SupportTicket.getPriorityLabel(ticket.priority) %>
                </span>
              </td>
              <td class="px-4 py-3 text-center">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold <%= SupportTicket.getStatusColor(ticket.status) %>">
                  <%= SupportTicket.getStatusLabel(ticket.status) %>
                </span>
              </td>
              <td class="px-4 py-3 text-center">
                <span class="text-sm font-medium"><%= ticket.message_count || 0 %></span>
              </td>
              <td class="px-4 py-3 text-right">
                <span class="text-xs whitespace-nowrap"><%= helpers.timeAgo(ticket.updated_at) %></span>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="7" class="px-6 py-12 text-center">
              <div class="flex flex-col items-center">
                  <p class="text-sm font-medium">No tickets yet</p>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

	<% if (pagination.totalPages > 1) { %>
		<div class="flex items-center justify-between gap-4 border-t border-gray-200/70 dark:border-gray-800/70 mt-2 p-2">
			<p class="text-xs">
				Showing 
				<span class="font-medium"><%= (pagination.currentPage - 1) * pagination.perPage + 1 %>-<%= Math.min(pagination.currentPage * pagination.perPage, pagination.total) %></span>
				from
				<span class="font-medium"><%= pagination.total %></span>
			</p>

			<nav class="flex items-center gap-1">
				<% pagination.pages.forEach(function(p) { %>
					<% if (p === '...') { %>
						<span class="flex h-8 min-w-8 items-center justify-center px-1 text-xs">...</span>
					<% } else { %>
						<a href="?page=<%= p %>&search=<%= filters.search %>&role=<%= filters.role %>&status=<%= filters.status %>"
							class="flex h-6 min-w-6 items-center justify-center rounded p-1 text-xs font-medium
							<%= p === pagination.currentPage
								? 'bg-blue-500 dark:bg-blue-600 text-white'
								: 'bg-gray-200 hover:bg-gray-300 dark:bg-gray-800 dark:hover:bg-gray-700' %>">
							<%= p %>
						</a>
					<% } %>
				<% }); %>
			</nav>
		</div>
	<% } %>
</div>
