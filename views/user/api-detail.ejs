<%
  const apiRoutes = routes || [];
  const gatewayUrl = (typeof baseUrl !== 'undefined' ? baseUrl : '') + (api.base_route || '/gateway/' + api.slug);
%>

<!-- API Info -->
<div class="card p-5 mb-4">
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-4 pb-4 border-b border-gray-200/70 dark:border-gray-800/70">
	<div class="flex items-center gap-4">
		<a data-aos="zoom-in" href="/user/browse-apis" class="group flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-white border border-gray-200/70 dark:border-gray-800/70 hover:bg-gray-100 dark:hover:bg-slate-800 dark:bg-slate-900" title="Back to users">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none">
				<path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</a>
		<div>
			<h3 data-aos="zoom-in" class="text-sm font-bold mb-1"><%= api.name %></h3>
			<p data-aos="zoom-in" class="text-xs">/<%= api.slug %></p>
		</div>
	</div>
    <span data-aos="zoom-in" class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-medium <%= helpers.statusBadgeClass(api.status === 'active' ? 'active' : 'inactive') %>">
      <%= api.status %>
    </span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
    <div data-aos="zoom-in">
      <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Base Route</label>
      <code class="text-sm block truncate select-text"><%= api.base_route || '-' %></code>
    </div>
    <div data-aos="zoom-in">
      <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Version</label>
      <span class="text-sm"><%= api.version || '-' %></span>
    </div>
    <div data-aos="zoom-in">
      <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Credit Cost</label>
      <span class="text-sm font-semibold"><%= api.credit_cost || 0 %>cr/request</span>
    </div>
  </div>
  
  <% if (api.description) { %>
	<div class="flex">
		<p data-aos="zoom-in" class="text-sm border-l-4 border-blue-500 p-2 rounded-r-md bg-gray-200/70 dark:bg-gray-800/70">
			<%= api.description || 'No description provided' %>
		</p>
	</div>
  <% } %>
</div>

<!-- Routes -->
<div class="space-y-3">
  <% if (apiRoutes.length > 0) { %>
    <% apiRoutes.forEach(function(route) { %>
      <div data-aos="zoom-in" class="card overflow-hidden select-text">
        <div class="route-toggle flex items-center gap-3 px-4 py-2 cursor-pointer hover:bg-gray-50/70 dark:hover:bg-gray-800/40 transition-colors" onclick="toggleRouteDoc(this)">
          <span class="inline-flex shrink-0 items-center justify-center rounded-md px-2 py-1 text-[10px] font-bold uppercase tracking-wide
            <%= route.method === 'GET' ? 'bg-emerald-50 text-emerald-600 border border-emerald-200/70 dark:bg-emerald-500/10 dark:text-emerald-400 dark:border-emerald-500/20' :
                route.method === 'POST' ? 'bg-blue-50 text-blue-600 border border-blue-200/70 dark:bg-blue-500/10 dark:text-blue-400 dark:border-blue-500/20' :
                route.method === 'PUT' ? 'bg-yellow-50 text-yellow-600 border border-yellow-200/70 dark:bg-yellow-500/10 dark:text-yellow-400 dark:border-yellow-500/20' :
                route.method === 'DELETE' ? 'bg-rose-50 text-rose-600 border border-rose-200/70 dark:bg-rose-500/10 dark:text-rose-400 dark:border-rose-500/20' :
                'bg-purple-50 text-purple-600 border border-purple-200/70 dark:bg-purple-500/10 dark:text-purple-400 dark:border-purple-500/20' %>">
            <%= route.method %>
          </span>
          <span class="font-mono text-xs font-medium">
            <%= route.path %>
          </span>
          <svg class="ml-auto shrink-0 w-4 h-4 text-gray-400 transition-transform route-arrow" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </div>

        <div class="route-doc-body hidden p-5 border-t border-gray-200/70 dark:border-gray-800/70">
		  <!--
		  <label class="block text-xs font-semibold uppercase tracking-wider mb-4">Description</label>
          <% if (route.description) { %>
            <div class="px-5">
				<p class="text-sm border-l-4 border-blue-500 p-2 bg-gray-200/70 dark:bg-gray-800/70">
					<%= route.description || 'No description provided' %>
				</p>
            </div>
          <% } %>
		  -->
		  <label class="block font-semibold uppercase tracking-wider mb-4">Documentation</label>
          <% if (route.documentation) { %>
            <div class="px-5">
              <div class="prose dark:prose-invert max-w-6xl route-documentation">
                <%- marked.parse(route.documentation) %>
              </div>
            </div>
          <% } else { %>
            <div class="p-5">
              <p class="text-xs">No documentation available for this route.</p>
            </div>
          <% } %>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <div class="card p-8 text-center">
      <p data-aos="zoom-in" class="text-sm">No routes available.</p>
    </div>
  <% } %>
</div>

<% 
  pageScript = `
	<script>
	function toggleRouteDoc(el) {
	  const body = el.nextElementSibling;
	  const arrow = el.querySelector('.route-arrow');
	  body.classList.toggle('hidden');
	  if (arrow) arrow.style.transform = body.classList.contains('hidden') ? '' : 'rotate(180deg)';
	}
	</script>
`;
%>