<div class="max-w-lg mx-auto space-y-6 pt-16">

  <!-- Header -->
  <div class="text-center space-y-2">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-blue-100 dark:bg-blue-900/30">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
      </svg>
    </div>
    <h2 class="text-xl font-bold">Verify Your Email</h2>
    <p class="text-sm">
      We'll send a 6-digit verification code to your email address.
    </p>
  </div>

  <% if (!smtpConfigured) { %>
    <!-- SMTP Not Configured -->
    <div data-aos="zoom-in" class="card p-5">
      <div class="flex items-start gap-3.5 p-4 bg-amber-50/80 dark:bg-amber-950/40 rounded-md border border-amber-200/30 dark:border-amber-900/30">
        <div class="p-2 bg-amber-500 text-white rounded-lg shrink-0">
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24">
				<path d="M0 0h24v24H0z" fill="none" />
				<path fill="currentColor" d="M19 9.09V6c0-.55-.45-1-1-1h-3.09L12.7 2.79a.996.996 0 0 0-1.41 0L9.08 5H5.99c-.55 0-1 .45-1 1v3.09L2.78 11.3a.996.996 0 0 0 0 1.41l2.21 2.21v3.09c0 .55.45 1 1 1h3.09l2.21 2.21c.2.2.45.29.71.29s.51-.1.71-.29l2.21-2.21h3.09c.55 0 1-.45 1-1v-3.09l2.21-2.21a.996.996 0 0 0 0-1.41l-2.21-2.21Zm-1.71 4.71a1 1 0 0 0-.29.71v2.5h-2.5c-.27 0-.52.11-.71.29L12 19.09l-1.79-1.79a1 1 0 0 0-.71-.29H7v-2.5c0-.27-.11-.52-.29-.71l-1.79-1.79l1.79-1.79A1 1 0 0 0 7 9.51v-2.5h2.5c.27 0 .52-.11.71-.29L12 4.93l1.79 1.79c.19.19.44.29.71.29H17v2.5c0 .27.11.52.29.71l1.79 1.79z" />
				<path fill="currentColor" d="m11 12.59l-1.29-1.3l-1.42 1.42l2.71 2.7l4.71-4.7l-1.42-1.42z" />
			</svg>
        </div>
        <div class="space-y-1">
          <p class="text-sm font-bold">Email verification is not configured</p>
          <p class="text-xs">The administrator has not set up SMTP email settings yet. Please contact admin to enable email verification.</p>
        </div>
      </div>
    </div>

  <% } else if (activeOtp) { %>
    <!-- OTP Already Sent — Enter Code -->
    <div data-aos="zoom-in" class="card p-5 space-y-4">
      <div class="flex items-start gap-3.5 p-4 bg-blue-50/80 dark:bg-blue-950/40 rounded-md border border-blue-200/30 dark:border-blue-900/30">
        <div class="p-2 bg-blue-500 text-white rounded-lg shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y1="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>
          </svg>
        </div>
        <div class="space-y-1">
          <p class="text-sm font-bold">Enter verification code</p>
          <p class="text-xs">A 6-digit code has been sent to your email. It expires in 10 minutes.</p>
        </div>
      </div>

      <form id="verifyForm" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-1.5">Verification Code</label>
          <input type="text" id="otpInput" name="otp" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code"
            placeholder="000000"
            class="w-full px-4 py-3 text-center text-2xl font-mono font-bold tracking-[0.5em] bg-form border border-gray-200 dark:border-gray-800 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
            required autofocus>
          <p class="text-[11px] mt-1.5 text-center">Check your inbox (and spam folder)</p>
        </div>
        <button type="submit" id="verifyBtn" class="mx-auto flex items-center justify-center gap-2 btn-normal px-4 py-2.5 rounded-md text-sm font-semibold">
          <span class="btn-label">Verify Email</span>
          <svg class="btn-spinner hidden animate-spin" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 11-6.219-8.56"/></svg>
        </button>
      </form>

      <div class="text-center">
        <button type="button" id="resendBtn" onclick="sendOtp()" class="text-xs link font-medium">
          Resend Code
        </button>
      </div>
    </div>

  <% } else { %>
    <!-- No OTP sent yet — Send Code -->
    <div data-aos="zoom-in" class="card p-5 space-y-4">
      <form id="sendForm" class="space-y-6">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-1.5">Email Address</label>
          <input type="email" value="<%= userData.email %>" disabled
            class="w-full px-4 py-3 text-sm bg-form cursor-not-allowed">
          <p class="text-[11px] mt-1.5">We'll send the verification code to this email</p>
        </div>
        <button type="submit" id="sendBtn" class="mx-auto flex items-center justify-center gap-2 btn-normal px-4 py-2.5 rounded-md text-sm font-semibold">
          <span class="btn-label">Send Verification Code</span>
          <svg class="btn-spinner hidden animate-spin" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 11-6.219-8.56"/></svg>
        </button>
      </form>
    </div>
  <% } %>

  <div class="flex items-center justify-center">
    <a href="/user/profile" class="flex items-center gap-2 text-sm link font-medium">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">
        <path d="M0 0h24v24H0z" fill="none" />
        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m12 19l-7-7l7-7m7 7H5" />
      </svg>
      Back to Profile
    </a>
  </div>
</div>

<%
pageScript = `
<script>
(function() {
  const btnLabels = {};
  document.querySelectorAll('.btn-label').forEach(el => {
    const id = el.closest('button').id;
    btnLabels[id] = el.textContent;
  });

  function showFlash(type, message) {
    let container = document.getElementById('verifyFlashContainer');
    if (!container) {
      container = document.createElement('div');
      container.id = 'verifyFlashContainer';
      container.className = 'fixed bottom-5 right-5 z-50 flex flex-col gap-3 pointer-events-none';
      document.body.appendChild(container);
    }
    const isErr = type === 'error';
    const el = document.createElement('div');
    el.className = 'pointer-events-auto shadow-lg transition-opacity duration-500 rounded-md p-3 flex items-center gap-2 '
      + (isErr ? 'bg-red-50 border border-red-200/70' : 'bg-green-50 border border-green-200/70');
    el.innerHTML = (isErr
      ? '<svg class="h-5 w-5 text-red-400 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>'
      : '<svg class="h-5 w-5 text-green-400 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>')
      + '<p class="text-sm ' + (isErr ? 'text-red-700' : 'text-green-700') + '">' + message + '</p>';
    container.appendChild(el);
    setTimeout(() => { el.style.opacity = '0'; }, 4000);
    setTimeout(() => { el.remove(); }, 4500);
  }

  function setLoading(btnId, loading) {
    const btn = document.getElementById(btnId);
    if (!btn) return;
    const label = btn.querySelector('.btn-label');
    const spinner = btn.querySelector('.btn-spinner');
    btn.disabled = loading;
    if (label) label.textContent = loading ? 'Please wait...' : (btnLabels[btnId] || 'Submit');
    if (spinner) spinner.classList.toggle('hidden', !loading);
  }

  async function sendOtp(btnId) {
    setLoading(btnId, true);
    try {
      const res = await fetch('/user/verify-email/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
      });
      const data = await res.json();
      showFlash(data.success ? 'success' : 'error', data.message);
      if (data.success && !data.verified) setTimeout(() => location.reload(), 1000);
    } catch (err) {
      showFlash('error', 'Request failed: ' + err.message);
    }
    setLoading(btnId, false);
  }

  async function verifyOtp() {
    setLoading('verifyBtn', true);
    const otp = document.getElementById('otpInput').value.trim();
    if (!otp || otp.length !== 6) {
      showFlash('error', 'Please enter a valid 6-digit code');
      setLoading('verifyBtn', false);
      return;
    }
    try {
      const res = await fetch('/user/verify-email/verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ otp })
      });
      const data = await res.json();
      showFlash(data.success ? 'success' : 'error', data.message);
      if (data.success) setTimeout(() => { window.location.href = '/user/profile'; }, 1000);
    } catch (err) {
      showFlash('error', 'Request failed: ' + err.message);
    }
    setLoading('verifyBtn', false);
  }

  // Expose to global for onclick handlers
  window.sendOtp = function() { sendOtp('sendBtn'); };

  // Send form
  const sendForm = document.getElementById('sendForm');
  if (sendForm) {
    sendForm.addEventListener('submit', function(e) {
      e.preventDefault();
      sendOtp('sendBtn');
    });
  }

  // Verify form
  const verifyForm = document.getElementById('verifyForm');
  if (verifyForm) {
    verifyForm.addEventListener('submit', function(e) {
      e.preventDefault();
      verifyOtp();
    });
  }
})();
</script>
`;
%>