<!-- Checkout Page -->
<div class="mb-4">
  <a href="/user/credits" class="link text-sm flex items-center gap-1">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 19l-7-7 7-7"/></svg>
    Back to Credits
  </a>
</div>

<div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
  <!-- Left: Payment Method Selection -->
  <div class="lg:col-span-3 space-y-4">
    <!-- Order Summary Card -->
    <div data-aos="zoom-in" class="card p-5">
      <h3 class="text-sm font-bold mb-4">Order Summary</h3>
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium"><%= order.package_name %></p>
            <% if (order.package_description) { %>
              <p class="text-xs mt-0.5"><%= order.package_description %></p>
            <% } %>
          </div>
          <span class="text-xs px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 font-medium">
            <%= order.type === 'standard_package' ? 'Standard' : 'Custom' %>
          </span>
        </div>
        <hr class="border-gray-100 dark:border-gray-800">
        <div class="flex justify-between text-sm">
          <span>Credits</span>
          <span class="font-medium"><%= helpers.formatNumber(order.credits_requested) %></span>
        </div>
        <div class="flex justify-between text-sm">
          <span>Rate Limit</span>
          <span class="font-medium"><%= order.rate_limit_per_minute %>/min</span>
        </div>
        <% if (order.notes) { %>
          <div class="flex justify-between text-sm">
            <span>Notes</span>
            <span class="font-medium text-right max-w-[60%] text-xs"><%= order.notes %></span>
          </div>
        <% } %>
        <hr class="border-gray-100 dark:border-gray-800">
        <div class="flex justify-between font-bold text-base">
          <span>Total</span>
          <span class="text-blue-600 dark:text-blue-400"><%= helpers.formatRupiah(order.total_price) %></span>
        </div>
      </div>
    </div>

    <!-- Payment Method Selection -->
    <div data-aos="zoom-in" class="card p-5">
      <h3 class="text-sm font-bold mb-4">Select Payment Method</h3>
      <div class="grid grid-cols-2 gap-3 mb-4">
        <% if (paymentMethods.transferEnabled) { %>
          <label id="label-transfer" class="method-card flex flex-col items-center gap-2 p-4 rounded-xl border-2 cursor-pointer transition-all duration-200 border-blue-500 bg-blue-50 dark:bg-blue-900/20 shadow-sm shadow-blue-500/10" onclick="selectMethod('transfer')">
            <div class="w-12 h-12 rounded-full bg-blue-100 dark:bg-blue-800/50 flex items-center justify-center">
              <svg class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"/>
              </svg>
            </div>
            <span class="text-sm font-semibold">Bank Transfer</span>
            <span class="text-[10px]">Manual transfer</span>
          </label>
        <% } %>

        <% if (paymentMethods.qrisEnabled) { %>
          <label id="label-qris" class="method-card flex flex-col items-center gap-2 p-4 rounded-xl border-2 cursor-pointer transition-all duration-200 <%= !paymentMethods.transferEnabled ? 'border-emerald-500 bg-emerald-50 dark:bg-emerald-900/20 shadow-sm shadow-emerald-500/10' : 'border-gray-200 dark:border-gray-800 hover:border-gray-300 dark:hover:border-gray-700' %>" onclick="selectMethod('qris')">
            <div class="w-12 h-12 rounded-full bg-emerald-100 dark:bg-emerald-800/50 flex items-center justify-center">
              <svg class="w-6 h-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 013.75 9.375v-4.5zM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 01-1.125-1.125v-4.5zM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0113.5 9.375v-4.5z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 6.75h.75v.75h-.75v-.75zM6.75 16.5h.75v.75h-.75v-.75zM16.5 6.75h.75v.75h-.75v-.75zM13.5 13.5h.75v.75h-.75v-.75zM13.5 19.5h.75v.75h-.75v-.75zM19.5 13.5h.75v.75h-.75v-.75zM19.5 19.5h.75v.75h-.75v-.75zM16.5 16.5h.75v.75h-.75v-.75z"/>
              </svg>
            </div>
            <span class="text-sm font-semibold">QRIS</span>
            <span class="text-[10px]">Scan &amp; pay</span>
          </label>
        <% } %>
      </div>

      <!-- Payment Instructions: Bank Transfer -->
      <div id="instructions-transfer" class="payment-instructions rounded-xl p-4 space-y-3 border border-blue-100 dark:border-blue-900/30 bg-blue-50/50 dark:bg-blue-900/10">
        <div class="flex items-center gap-2 mb-2">
          <div class="w-2 h-2 rounded-full bg-blue-500"></div>
          <span class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-400">Bank Transfer Instructions</span>
        </div>
        <div class="bg-white dark:bg-gray-900 rounded-lg p-4 border border-blue-100 dark:border-blue-800/30">
          <p class="text-lg font-bold font-mono tracking-wide"><%= bankInfo.bankAccountNumber %></p>
          <p class="text-sm font-medium mt-1"><%= bankInfo.bankName %></p>
          <p class="text-xs"><%= bankInfo.bankAccountName %></p>
        </div>
        <ol class="text-xs space-y-1.5 list-decimal list-inside">
          <li>Transfer exactly <strong><%= helpers.formatRupiah(order.total_price) %></strong></li>
          <li>Upload your payment proof below</li>
          <li>Click Confirm Purchase</li>
          <li>Wait for admin approval</li>
        </ol>
      </div>

      <!-- Payment Instructions: QRIS -->
      <div id="instructions-qris" class="payment-instructions rounded-xl p-4 space-y-3 border border-emerald-100 dark:border-emerald-900/30 bg-emerald-50/50 dark:bg-emerald-900/10 hidden">
        <div class="flex items-center gap-2 mb-2">
          <div class="w-2 h-2 rounded-full bg-emerald-500"></div>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">QRIS Instructions</span>
        </div>
        <div class="bg-white dark:bg-gray-900 rounded-lg p-4 border border-emerald-100 dark:border-emerald-800/30 text-center">
          <% if (qrisImage) { %>
            <img src="<%= qrisImage %>" alt="QRIS QR Code" class="mx-auto max-w-[220px] rounded-lg border border-gray-200 dark:border-gray-700 mb-3">
          <% } else { %>
            <div class="w-[220px] h-[220px] mx-auto bg-gray-100 dark:bg-gray-800 rounded-lg flex items-center justify-center mb-3">
              <span class="text-xs">QRIS image not uploaded yet</span>
            </div>
          <% } %>
          <p class="text-xs">Scan QRIS to pay</p>
        </div>
        <ol class="text-xs space-y-1.5 list-decimal list-inside">
          <li>Open your mobile banking / e-wallet app</li>
          <li>Scan the QRIS code above</li>
          <li>Pay exactly <strong><%= helpers.formatRupiah(order.total_price) %></strong></li>
          <li>Upload your payment proof below</li>
          <li>Click Confirm Purchase</li>
          <li>Wait for admin approval</li>
        </ol>
      </div>
    </div>
  </div>

  <!-- Right: Confirm Button -->
  <div class="lg:col-span-2">
    <div data-aos="zoom-in" class="card p-5 lg:sticky lg:top-24">
      <h3 class="text-sm font-bold mb-4">Confirm Purchase</h3>
      
      <!-- Summary -->
      <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4 mb-4">
        <div class="flex justify-between text-sm mb-2">
          <span>Package</span>
          <span class="font-medium"><%= order.package_name %></span>
        </div>
        <div class="flex justify-between text-sm mb-2">
          <span>Credits</span>
          <span class="font-medium"><%= helpers.formatNumber(order.credits_requested) %></span>
        </div>
        <div class="flex justify-between text-sm mb-3">
          <span>Payment</span>
          <span id="selectedMethodLabel" class="font-medium flex items-center gap-1">
            <% if (paymentMethods.transferEnabled) { %>
              <span class="w-2 h-2 rounded-full bg-blue-500"></span> Transfer
            <% } else { %>
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span> QRIS
            <% } %>
          </span>
        </div>
        <hr class="border-gray-200 dark:border-gray-700 mb-3">
        <div class="flex justify-between font-bold text-lg">
          <span>Total</span>
          <span class="text-blue-600 dark:text-blue-400"><%= helpers.formatRupiah(order.total_price) %></span>
        </div>
      </div>

      <!-- Purchase Form -->
      <form method="POST" action="/user/credits/purchase" id="purchaseForm" enctype="multipart/form-data">
        <input type="hidden" name="type" value="<%= order.type %>">
        <input type="hidden" name="package_id" value="<%= order.package_id || '' %>">
        <input type="hidden" name="credits" value="<%= order.credits_requested %>">
        <input type="hidden" name="rate_limit" value="<%= order.rate_limit_per_minute %>">
        <input type="hidden" name="notes" value="<%= order.notes %>">
        <input type="hidden" name="payment_method" id="selectedMethod" value="<%= paymentMethods.transferEnabled ? 'transfer' : 'qris' %>">

        <!-- Payment Proof Upload (Required) -->
        <div class="mb-4">
          <label class="block text-xs font-semibold uppercase tracking-wider mb-1.5">Payment Proof <span class="text-red-500">*</span></label>
          <div id="proofDropZone" class="relative border-2 border-dashed border-gray-300 dark:border-gray-700 rounded-lg p-4 text-center cursor-pointer hover:border-blue-400 dark:hover:border-blue-500 transition-colors">
            <input type="file" name="payment_proof" id="proofInput" accept="image/jpeg,image/png,image/gif,image/webp" required class="hidden" onchange="handleProofPreview(this)">
            <div id="proofPlaceholder">
              <svg class="mx-auto h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/>
              </svg>
              <p class="text-xs mt-1">Click to upload screenshot</p>
              <p class="text-[10px]">JPG, PNG, GIF, WEBP (max 2MB)</p>
            </div>
            <div id="proofPreview" class="hidden">
              <img id="proofImg" src="" alt="Preview" class="mx-auto max-h-32 rounded-lg">
              <p id="proofFileName" class="text-xs mt-1"></p>
              <button type="button" onclick="removeProof(event)" class="text-xs text-red-500 hover:text-red-700 mt-1">Remove</button>
            </div>
          </div>
        </div>
        
        <button type="submit" id="submitBtn" class="w-full btn-normal px-4 py-3 rounded-lg text-sm font-semibold flex items-center justify-center gap-2">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Confirm Purchase
        </button>
        <p class="text-[10px] text-center mt-3">Payment proof is required. Upload your transfer/QRIS screenshot.</p>
      </form>
    </div>
  </div>
</div>
<%
pageScript = `
<script>
let selectedMethod = '${paymentMethods.transferEnabled ? "transfer" : "qris"}';

// Drop zone
document.getElementById('proofDropZone').addEventListener('click', () => document.getElementById('proofInput').click());
document.getElementById('proofDropZone').addEventListener('dragover', e => { e.preventDefault(); e.currentTarget.classList.add('border-blue-400'); });
document.getElementById('proofDropZone').addEventListener('dragleave', e => { e.currentTarget.classList.remove('border-blue-400'); });
document.getElementById('proofDropZone').addEventListener('drop', e => {
  e.preventDefault();
  e.currentTarget.classList.remove('border-blue-400');
  const file = e.dataTransfer.files[0];
  if (file && file.type.startsWith('image/')) {
    const input = document.getElementById('proofInput');
    const dt = new DataTransfer();
    dt.items.add(file);
    input.files = dt.files;
    handleProofPreview(input);
  }
});

function handleProofPreview(input) {
  const file = input.files[0];
  if (!file) return;
  if (file.size > 2 * 1024 * 1024) {
    alert('File too large. Max 2MB.');
    input.value = '';
    return;
  }
  const reader = new FileReader();
  reader.onload = e => {
    document.getElementById('proofImg').src = e.target.result;
    document.getElementById('proofFileName').textContent = file.name;
    document.getElementById('proofPlaceholder').classList.add('hidden');
    document.getElementById('proofPreview').classList.remove('hidden');
  };
  reader.readAsDataURL(file);
}

function removeProof(e) {
  e.stopPropagation();
  document.getElementById('proofInput').value = '';
  document.getElementById('proofPlaceholder').classList.remove('hidden');
  document.getElementById('proofPreview').classList.add('hidden');
}

// Form submit validation
document.getElementById('purchaseForm').addEventListener('submit', function(e) {
  const fileInput = document.getElementById('proofInput');
  if (!fileInput.files || !fileInput.files[0]) {
    e.preventDefault();
    alert('Please upload your payment proof before confirming.');
    document.getElementById('proofDropZone').classList.add('border-red-400');
    setTimeout(() => document.getElementById('proofDropZone').classList.remove('border-red-400'), 2000);
    return;
  }
  const btn = document.getElementById('submitBtn');
  btn.disabled = true;
  btn.innerHTML = '<svg class="animate-spin h-5 w-5" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg> Processing...';
});

function selectMethod(method) {
  selectedMethod = method;
  const selectedInput = document.getElementById('selectedMethod');
  if (selectedInput) selectedInput.value = method;
  
  // Elements
  const transferLabel = document.getElementById('label-transfer');
  const qrisLabel = document.getElementById('label-qris');
  const transferInstr = document.getElementById('instructions-transfer');
  const qrisInstr = document.getElementById('instructions-qris');
  const methodLabel = document.getElementById('selectedMethodLabel');
  
  // Style classes
  const activeTransferClass = 'method-card flex flex-col items-center gap-2 p-4 rounded-xl border-2 cursor-pointer transition-all duration-200 border-blue-500 bg-blue-50 dark:bg-blue-900/20 shadow-sm shadow-blue-500/10';
  const activeQrisClass = 'method-card flex flex-col items-center gap-2 p-4 rounded-xl border-2 cursor-pointer transition-all duration-200 border-emerald-500 bg-emerald-50 dark:bg-emerald-900/20 shadow-sm shadow-emerald-500/10';
  const inactiveClass = 'method-card flex flex-col items-center gap-2 p-4 rounded-xl border-2 cursor-pointer transition-all duration-200 border-gray-200 dark:border-gray-800 hover:border-gray-300 dark:hover:border-gray-700';

  if (transferLabel) {
    transferLabel.className = method === 'transfer' ? activeTransferClass : inactiveClass;
  }
  
  if (qrisLabel) {
    qrisLabel.className = method === 'qris' ? activeQrisClass : inactiveClass;
  }
  
  // Toggle instructions
  if (transferInstr) transferInstr.classList.toggle('hidden', method !== 'transfer');
  if (qrisInstr) qrisInstr.classList.toggle('hidden', method !== 'qris');
  
  // Update summary label
  if (methodLabel) {
    const isTransfer = method === 'transfer';
    const dotColor = isTransfer ? 'bg-blue-500' : 'bg-emerald-500';
    const text = isTransfer ? 'Transfer' : 'QRIS';
    methodLabel.innerHTML = '<span class="w-2 h-2 rounded-full ' + dotColor + '"></span> ' + text;
  }
}
</script>
`;
%>