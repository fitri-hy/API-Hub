<!-- Request Logs -->
<div class="card">
  <div class="p-5 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
    <h3 data-aos="zoom-in" class="text-sm font-bold">Request Logs</h3>
    <form data-aos="zoom-in" method="GET" action="/user/logs" class="w-full lg:w-auto flex items-center gap-2">
      <select name="api_id" class="w-full lg:w-full bg-form px-3 py-2 text-sm">
        <option value="">All APIs</option>
        <% if (availableApis && availableApis.length > 0) { %>
          <% availableApis.forEach(function(api) { %>
            <option value="<%= api.id %>" <%= filters.apiId == api.id ? 'selected' : '' %>><%= api.name %></option>
          <% }); %>
        <% } %>
      </select>
      <select name="status" class="w-full lg:w-auto bg-form px-3 py-2 text-sm">
        <option value="">All Status</option>
        <option value="success" <%= filters.status === 'success' ? 'selected' : '' %>>Success</option>
        <option value="error" <%= filters.status === 'error' ? 'selected' : '' %>>Error</option>
      </select>
      <button type="submit" class="btn-normal p-2 rounded-md">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24">
          <path d="M0 0h24v24H0z" fill="none" />
          <path fill="none" stroke="currentColor" stroke-width="1.5" d="M19 3H5C3.58579 3 2.87868 3 2.43934 3.4122C2 3.8244 2 4.48782 2 5.81466V6.50448C2 7.54232 2 8.06124 2.2596 8.49142C2.5192 8.9216 2.99347 9.18858 3.94202 9.72255L6.85504 11.3624C7.49146 11.7206 7.80967 11.8998 8.03751 12.0976C8.51199 12.5095 8.80408 12.9935 8.93644 13.5872C9 13.8722 9 14.2058 9 14.8729L9 17.5424C9 18.452 9 18.9067 9.25192 19.2613C9.50385 19.6158 9.95128 19.7907 10.8462 20.1406C12.7248 20.875 13.6641 21.2422 14.3321 20.8244C15 20.4066 15 19.4519 15 17.5424V14.8729C15 14.2058 15 13.8722 15.0636 13.5872C15.1959 12.9935 15.488 12.5095 15.9625 12.0976C16.1903 11.8998 16.5085 11.7206 17.145 11.3624L20.058 9.72255C21.0065 9.18858 21.4808 8.9216 21.7404 8.49142C22 8.06124 22 7.54232 22 6.50448V5.81466C22 4.48782 22 3.8244 21.5607 3.4122C21.1213 3 20.4142 3 19 3Z" />
        </svg>
      </button>
      <% if (filters.apiId || filters.status) { %>
        <a href="/user/logs" class="btn-failed p-2 rounded-md">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24">
            <path d="M0 0h24v24H0z" fill="none" />
            <path fill="currentColor" d="M18.2577 3.50828C18.538 3.62437 18.7207 3.89785 18.7207 4.20119V8.44383C18.7207 8.85805 18.3849 9.19383 17.9707 9.19383H13.728C13.4247 9.19383 13.1512 9.0111 13.0351 8.73085C12.9191 8.45059 12.9832 8.128 13.1977 7.9135L14.8007 6.3105C12.1674 5.20912 9.01606 5.7309 6.87348 7.87348C4.04217 10.7048 4.04217 15.2952 6.87348 18.1265C9.70478 20.9578 14.2952 20.9578 17.1265 18.1265C18.7727 16.4803 19.4622 14.2401 19.1935 12.0937C19.142 11.6827 19.4335 11.3078 19.8445 11.2563C20.2555 11.2049 20.6304 11.4963 20.6819 11.9073C21.0057 14.4934 20.1746 17.1997 18.1872 19.1872C14.7701 22.6043 9.2299 22.6043 5.81282 19.1872C2.39573 15.7701 2.39573 10.2299 5.81282 6.81282C8.55119 4.07444 12.6515 3.5312 15.9309 5.18028L17.4404 3.67086C17.6549 3.45637 17.9774 3.3922 18.2577 3.50828Z" />
          </svg>
        </a>
      <% } %>
    </form>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead>
        <tr data-aos="zoom-in" class="text-xs font-medium uppercase tracking-wider border-b border-gray-200/70 dark:border-gray-800/70">
          <th class="px-4 py-2 text-left">API</th>
          <th class="px-4 py-2 text-center">Method</th>
          <th class="px-4 py-2 text-left">Path</th>
          <th class="px-4 py-2 text-center">Status</th>
          <th class="px-4 py-2 text-right">Time</th>
          <th class="px-4 py-2 text-right">Duration</th>
          <th class="px-4 py-2 text-right">Credits</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200/70 dark:divide-gray-800/70">
        <% if (logs && logs.length > 0) { %>
          <% logs.forEach(function(log) { %>
            <tr data-aos="zoom-in">
              <td class="px-4 py-2">
                <h6 class="text-sm"><%= log.api_name || '-' %></h6>
                <% if (log.api_slug) { %><div class="text-[10px] font-mono">/<%= log.api_slug %></div><% } %>
              </td>
              <td class="px-4 py-2 text-center">
                <span class="text-[10px] font-bold uppercase
                  <%= log.method === 'GET' ? 'text-emerald-500' :
                      log.method === 'POST' ? 'text-blue-500' :
                      log.method === 'PUT' ? 'text-yellow-500' :
                      log.method === 'DELETE' ? 'text-rose-500' :
                      log.method === 'PATCH' ? 'text-purple-500' :
                      '' %>"><%= log.method %></span>
              </td>
              <td class="px-4 py-2 text-xs font-mono max-w-[200px] truncate"><%= log.path %></td>
              <td class="px-4 py-2 text-center">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium <%= helpers.statusBadgeClass(
                  log.response_status >= 200 && log.response_status < 300 ? 'success' :
                  log.response_status >= 400 ? 'error' : 'pending'
                ) %>">
                  <%= log.response_status %>
                </span>
              </td>
              <td class="px-4 py-2 text-xs text-right whitespace-nowrap"><%= helpers.formatDate(log.created_at, 'datetime') %></td>
              <td class="px-4 py-2 text-xs text-right
                <%= log.response_time_ms > 1000 ? 'text-rose-500 font-medium' :
                    log.response_time_ms > 500 ? 'text-amber-500 font-medium' :
                    'text-emerald-500 font-medium' %>"><%= log.response_time_ms || '-' %>ms</td>
              <td class="px-4 py-2 text-xs text-right"><%= log.credit_cost || 0 %></td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr data-aos="zoom-in"><td colspan="7" class="px-6 py-12 text-sm text-center">No logs found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <!-- Pagination Component -->
  <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
      <div class="flex items-center justify-between gap-4 border-t border-gray-200/70 dark:border-gray-800/70 mt-4 pt-3">
          <p class="text-xs text-gray-500">
              Showing 
              <span class="font-medium text-gray-700 dark:text-gray-300"><%= (pagination.currentPage - 1) * pagination.perPage + 1 %>-<%= Math.min(pagination.currentPage * pagination.perPage, pagination.total) %></span>
              from
              <span class="font-medium text-gray-700 dark:text-gray-300"><%= pagination.total %></span>
          </p>

          <nav class="flex items-center gap-1">
              <% pagination.pages.forEach(function(p) { %>
                  <% if (p === '...') { %>
                      <span class="flex h-8 min-w-8 items-center justify-center px-1 text-xs text-gray-400">...</span>
                  <% } else { %>
                      <a href="?page=<%= p %>"
                          class="flex h-6 min-w-6 items-center justify-center rounded p-1 text-xs font-medium
                          <%= p === pagination.currentPage
                              ? 'bg-blue-500 dark:bg-blue-600 text-white'
                              : 'bg-gray-200 hover:bg-gray-300 dark:bg-gray-800 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300' %>">
                          <%= p %>
                      </a>
                  <% } %>
              <% }); %>
          </nav>
      </div>
  <% } %>
</div>
