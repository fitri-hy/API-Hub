<!-- Transaction Detail -->
<div class="mb-4">
  <a href="/user/transactions" class="link text-sm flex items-center gap-1">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 19l-7-7 7-7"/></svg>
    Back to Transactions
  </a>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Transaction Info -->
  <div class="lg:col-span-2 space-y-4">
    <div class="card p-5">
      <h3 class="text-sm font-bold mb-4">Transaction #<%= transaction.id %></h3>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Status</label>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium
            <%= transaction.status === 'pending' ? 'bg-yellow-100 text-yellow-700' :
                transaction.status === 'approved' ? 'bg-emerald-100 text-emerald-700' :
                'bg-rose-100 text-rose-700' %>">
            <%= transaction.status.toUpperCase() %>
          </span>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Type</label>
          <span class="text-sm font-medium"><%= transaction.type === 'standard_package' ? 'Standard Package' : 'Custom Package' %></span>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Credits</label>
          <p class="text-lg font-bold text-blue-600"><%= transaction.credits_requested %></p>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Rate Limit</label>
          <p class="text-sm"><%= transaction.rate_limit_per_minute %> requests/minute</p>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Total Price</label>
          <p class="text-lg font-bold"><%= helpers.formatRupiah(transaction.total_price) %></p>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Created</label>
          <p class="text-sm"><%= helpers.formatDate(transaction.created_at, 'datetime') %></p>
        </div>
      </div>

      <% if (transaction.notes) { %>
        <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-800">
          <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Your Note</label>
          <p class="text-sm bg-gray-50 dark:bg-gray-800 p-3 rounded"><%= transaction.notes %></p>
        </div>
      <% } %>

      <% if (transaction.admin_note) { %>
        <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-800">
          <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Admin Note</label>
          <p class="text-sm bg-blue-50 dark:bg-blue-900/20 p-3 rounded"><%= transaction.admin_note %></p>
        </div>
      <% } %>
    </div>

    <!-- Payment Proof -->
    <div class="card p-5">
      <h3 class="text-sm font-bold mb-4">Payment Proof</h3>
      <% if (transaction.payment_proof) { %>
        <div class="flex justify-center">
          <img src="<%= transaction.payment_proof %>" alt="Payment Proof" class="max-w-full max-h-96 rounded-lg border border-gray-200 dark:border-gray-700">
        </div>
      <% } else if (transaction.status === 'pending') { %>
        <form method="POST" action="/user/transactions/<%= transaction.id %>/upload-proof" enctype="multipart/form-data" class="space-y-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider mb-1.5">Upload Payment Proof</label>
            <input type="file" name="payment_proof" accept="image/*" required class="w-full bg-form px-4 py-2 text-sm file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
            <p class="text-[10px] mt-1">Format: JPG, PNG, GIF, WebP. Max 2MB.</p>
          </div>
          <button type="submit" class="btn-normal px-4 py-2 rounded-md text-sm">Upload Proof</button>
        </form>
      <% } else { %>
        <p class="text-sm text-gray-500 text-center py-4">No payment proof uploaded.</p>
      <% } %>
    </div>
  </div>

  <!-- Sidebar -->
  <div class="space-y-4">
    <!-- Payment Instructions -->
    <% if (transaction.status === 'pending') { %>
      <div class="card p-5">
        <h3 class="text-sm font-bold mb-3">Payment Instructions</h3>
        <div class="space-y-3 text-sm">
          <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded">
            <p class="font-medium"><%= bankInfo.bankName %></p>
            <p class="text-lg font-bold font-mono"><%= bankInfo.bankAccountNumber %></p>
            <p class="text-xs text-gray-500"><%= bankInfo.bankAccountName %></p>
          </div>
          <div class="text-xs text-gray-600 dark:text-gray-400 space-y-1">
            <p>1. Transfer exactly <strong><%= helpers.formatRupiah(transaction.total_price) %></strong></p>
            <p>2. Upload payment proof above</p>
            <p>3. Wait for admin approval</p>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Summary -->
    <div class="card p-5">
      <h3 class="text-sm font-bold mb-3">Summary</h3>
      <div class="space-y-2 text-sm">
        <div class="flex justify-between">
          <span class="text-gray-500">Credits</span>
          <span class="font-medium"><%= transaction.credits_requested %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-500">Rate Limit</span>
          <span class="font-medium"><%= transaction.rate_limit_per_minute %>/min</span>
        </div>
        <hr class="border-gray-100 dark:border-gray-800">
        <div class="flex justify-between font-bold">
          <span>Total</span>
          <span><%= helpers.formatRupiah(transaction.total_price) %></span>
        </div>
      </div>
    </div>
  </div>
</div>
