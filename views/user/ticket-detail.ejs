	<div class="flex items-center gap-4 card px-4 py-3 mb-4">
		<a href="/user/tickets" class="group flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-white border border-gray-200/70 dark:border-gray-800/70 hover:bg-gray-100 dark:hover:bg-slate-800 dark:bg-slate-900" title="Back to users">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none">
				<path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</a>
		<div>
		  <h2 class="text-sm font-bold mb-1"><%= ticket.subject %></h2>
		  <div class="flex items-center gap-2 mt-1 flex-wrap">
			<span class="text-xs font-mono text-blue-600 dark:text-blue-400"><%= ticket.ticket_number %></span>
			<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold <%= SupportTicket.getStatusColor(ticket.status) %>">
			  <%= SupportTicket.getStatusLabel(ticket.status) %>
			</span>
			<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold <%= SupportTicket.getPriorityColor(ticket.priority) %>">
			  <%= SupportTicket.getPriorityLabel(ticket.priority) %>
			</span>
			<span class="text-[10px] font-semibold uppercase"><%= SupportTicket.getCategoryLabel(ticket.category) %></span>
		  </div>
		</div>
	</div>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-4">
  <!-- Conversation -->
  <div class="lg:col-span-3 space-y-4">
    <!-- User Info Card -->
    <div class="card p-4">
      <div class="flex items-center gap-3">
        <div class="relative flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-orange-200 dark:bg-orange-900">
          <% if (ticket.avatar) { %>
            <img src="<%= ticket.avatar %>" alt="" class="h-full w-full object-cover rounded-full">
          <% } else { %>
            <span class="text-sm font-bold text-orange-700 dark:text-orange-200"><%= (ticket.full_name || ticket.username || 'U').charAt(0).toUpperCase() %></span>
          <% } %>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold truncate"><%= ticket.full_name || ticket.username %></p>
          <p class="text-xs truncate">@<%= ticket.username %> &middot; <%= ticket.email %></p>
        </div>
        <a href="/admin/users/<%= ticket.user_uuid || '' %>" class="text-xs text-blue-600 hover:underline">View Profile</a>
      </div>
    </div>

    <!-- Messages -->
    <div class="card">
      <div class="p-4 border-b border-gray-200/70 dark:border-gray-800/70">
        <h3 class="text-sm font-bold">Conversation</h3>
      </div>
		<div class="max-h-[500px] overflow-y-auto space-y-4 p-4">
		  <% if (messages && messages.length > 0) { %>
			<% messages.forEach(function(msg) { %>
			  <% const isAdmin = msg.sender_role === 'admin'; %>
			  
			  <div class="flex gap-3 <%= isAdmin ? 'flex-row' : 'flex-row-reverse' %>">
				<!-- Avatar -->
				<div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full shadow-sm <%= isAdmin ? 'bg-indigo-600 text-white dark:bg-indigo-500' : 'bg-slate-200 text-slate-700 dark:bg-slate-700 dark:text-slate-200' %>">
				  <% if (msg.avatar) { %>
					<img src="<%= msg.avatar %>" alt="<%= msg.full_name || msg.username %>" class="h-full w-full rounded-full object-cover">
				  <% } else { %>
					<span class="text-xs font-semibold">
					  <%= (msg.full_name || msg.username || 'U').charAt(0).toUpperCase() %>
					</span>
				  <% } %>
				</div>

				<!-- Message Body Container -->
				<div class="flex max-w-[80%] flex-col <%= isAdmin ? 'items-start' : 'items-end' %>">
				  <div class="mb-1 flex items-center text-xs">
					<h6 class="font-semibold"><%= msg.full_name || msg.username %></h6>
				  </div>

				  <div class="relative rounded-2xl px-4 py-2.5 text-sm leading-relaxed <%= 
					msg.is_internal_note 
					  ? 'bg-amber-50 text-amber-900 border border-amber-200/80 dark:bg-amber-950/30 dark:text-amber-200 dark:border-amber-800/40 rounded-tr-none' 
					  : isAdmin 
						? 'bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-100 rounded-tr-none border border-slate-200/60 dark:border-slate-700/50 rounded-tl-none' 
						: 'bg-indigo-600 text-white dark:bg-indigo-600 rounded-tr-none' 
				  %>">
					<div class="break-words">
					  <%- helpers.escapeHtml(msg.message).replace(/\n/g, '<br>') %>
					</div>
				  </div>

				  <div class="mt-1 flex items-center justify-end gap-1 text-[10px]">
					<% if (msg.is_internal_note) { %>
					  <span class="<%= msg.is_internal_note ? 'text-amber-700/80 dark:text-amber-300/70' : isAdmin ? 'text-indigo-200' : 'text-slate-400 dark:text-slate-500' %>">
						INTERNAL NOTE
					  </span>
					  &middot;
					<% } %>
					<span><%= helpers.timeAgo(msg.created_at) %></span>
				  </div>
				</div>
			  </div>
			<% }); %>
		  <% } else { %>
			<div class="flex flex-col items-center justify-center py-12">
			  <p class="text-sm">No messages yet</p>
			</div>
		  <% } %>
		</div>
    </div>

    <!-- Reply Form -->
    <% if (ticket.status !== 'closed') { %>
      <div class="card p-4">
        <form method="POST" action="/admin/tickets/<%= ticket.id %>/reply">
          <label class="block text-xs font-semibold mb-2">Your Reply</label>
          <textarea name="message" required rows="1" placeholder="Type your reply..." class="bg-form p-2 w-full resize-y text-sm mb-4"></textarea>
          <div class="flex items-center justify-between">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="is_internal_note" value="1" class="rounded">
              <span class="text-xs font-medium">Internal note (not visible to user)</span>
            </label>
            <button type="submit" class="flex items-center gap-2 btn-normal px-3 py-2 rounded-md text-sm font-semibold">
				Reply
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24">
					<path d="M0 0h24v24H0z" fill="none" />
					<path fill="currentColor" d="m21.41 11.09l-18-8c-.37-.16-.8-.09-1.09.19s-.39.7-.25 1.08L3.9 9.25l7.1 2.76l-7.47 3.73l-1.47 3.91c-.14.38-.04.8.25 1.08a1 1 0 0 0 1.1.18l18-8a.998.998 0 0 0 0-1.82" />
				</svg>
			</button>
          </div>
        </form>
      </div>
    <% } %>
  </div>

  <!-- Sidebar Info -->
  <div class="space-y-4">
    <div class="card p-4">
	  <h4 class="text-xs font-semibold uppercase tracking-wider border-b border-gray-200/70 dark:border-gray-800/70 pb-2 mb-2">
		Ticket Details
	  </h4>
      <div class="space-y-3 text-sm">
        <div>
          <span class="text-[10px] uppercase">Created</span>
          <p class="mt-0.5"><%= helpers.formatDate(ticket.created_at, 'datetime') %></p>
        </div>
        <div>
          <span class="text-[10px] uppercase">Last Updated</span>
          <p class="mt-0.5"><%= helpers.timeAgo(ticket.updated_at) %></p>
        </div>
        <% if (ticket.resolved_at) { %>
          <div>
            <span class="text-[10px] uppercase">Resolved</span>
            <p class="mt-0.5"><%= helpers.formatDate(ticket.resolved_at, 'datetime') %></p>
          </div>
        <% } %>
        <div>
          <span class="text-[10px] uppercase">Assigned To</span>
          <p class="mt-0.5"><%= ticket.assigned_name || ticket.assigned_username || 'Unassigned' %></p>
        </div>
      </div>
    </div>

    <% if (ticket.api_endpoint || ticket.error_message) { %>
      <div class="card p-4">
        <h4 class="text-xs font-semibold uppercase tracking-wider border-b border-gray-200/70 dark:border-gray-800/70 pb-2 mb-2">
		  Technical Info
	    </h4>
        <div class="space-y-3 text-sm">
          <% if (ticket.api_endpoint) { %>
            <div>
              <span class="text-[10px] uppercase">Endpoint</span>
              <p class="mt-0.5 font-mono text-xs break-all"><%= ticket.api_endpoint %></p>
            </div>
          <% } %>
          <% if (ticket.error_message) { %>
            <div>
              <span class="text-[10px] uppercase">Error</span>
              <pre class="mt-0.5 max-h-32"><%= ticket.error_message %></pre>
            </div>
          <% } %>
          <% if (ticket.reproduction_steps) { %>
            <div>
              <span class="text-[10px] uppercase">Reproduction Steps</span>
              <p class="mt-0.5 whitespace-pre-wrap"><%= ticket.reproduction_steps %></p>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</div>
