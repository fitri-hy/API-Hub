<!-- My Transactions -->
<div class="card">
  <div class="p-5 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
    <h3 class="text-sm font-bold">My Transactions</h3>
    <div class="flex items-center gap-2">
	  <select onchange="window.location.href='?status='+this.value" class="bg-form px-3 py-2 text-sm rounded-md">
        <option value="">All Status</option>
        <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
        <option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>>Approved</option>
        <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
      </select>
      <a href="/user/credits" class="btn-normal px-3 py-2 text-sm rounded-md">Buy Package</a>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full">
      <thead>
        <tr class="text-xs font-medium uppercase tracking-wider border-b border-gray-200/70 dark:border-gray-800/70">
          <th class="px-4 py-2 text-left">ID</th>
          <th class="px-4 py-2 text-left">Type</th>
          <th class="px-4 py-2 text-center">Credits</th>
          <th class="px-4 py-2 text-center">Rate Limit</th>
          <th class="px-4 py-2 text-right">Price</th>
          <th class="px-4 py-2 text-center">Payment</th>
          <th class="px-4 py-2 text-center">Status</th>
          <th class="px-4 py-2 text-center">Date</th>
          <th class="px-4 py-2 text-right">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200/70 dark:divide-gray-800/70">
        <% if (transactions && transactions.length > 0) { %>
          <% transactions.forEach(function(t) { %>
            <tr>
              <td class="px-4 py-2 text-xs font-mono">#<%= t.id %></td>
              <td class="px-4 py-2 text-xs">
                <span class="px-2 py-0.5 rounded <%= t.type === 'standard_package' ? 'bg-blue-100 text-blue-700' : 'bg-purple-100 text-purple-700' %>">
                  <%= t.type === 'standard_package' ? t.package_name || 'Package' : 'Custom' %>
                </span>
              </td>
              <td class="px-4 py-2 text-xs text-center"><%= t.credits_requested %></td>
              <td class="px-4 py-2 text-xs text-center"><%= t.rate_limit_per_minute %>/min</td>
              <td class="px-4 py-2 text-xs text-right font-mono"><%= helpers.formatRupiah(t.total_price) %></td>
              <td class="px-4 py-2 text-center">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium
                  <%= t.payment_method === 'qris' ? 'bg-emerald-100 text-emerald-700' : 'bg-blue-100 text-blue-700' %>">
                  <%= t.payment_method === 'qris' ? 'QRIS' : 'Transfer' %>
                </span>
              </td>
              <td class="px-4 py-2 text-center">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium
                  <%= t.status === 'pending' ? 'bg-yellow-100 text-yellow-700' :
                      t.status === 'approved' ? 'bg-emerald-100 text-emerald-700' :
                      'bg-rose-100 text-rose-700' %>">
                  <%= t.status %>
                </span>
              </td>
              <td class="px-4 py-2 text-xs text-center"><%= helpers.formatDate(t.created_at, 'short') %></td>
              <td class="px-4 py-2 text-right">
                <a href="/user/transactions/<%= t.id %>" class="link text-xs">Detail</a>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr><td colspan="9" class="px-6 py-12 text-sm text-center">No transactions yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <% if (pagination.totalPages > 1) { %>
    <div class="flex items-center justify-between gap-4 border-t border-gray-200/70 dark:border-gray-800/70 mt-2 p-2">
      <p class="text-xs">Showing <span class="font-medium"><%= (pagination.currentPage - 1) * pagination.perPage + 1 %>-<%= Math.min(pagination.currentPage * pagination.perPage, pagination.total) %></span> from <span class="font-medium"><%= pagination.total %></span></p>
      <nav class="flex items-center gap-1">
        <% pagination.pages.forEach(function(p) { %>
          <% if (p === '...') { %>
            <span class="flex h-8 min-w-8 items-center justify-center px-1 text-xs">...</span>
          <% } else { %>
            <a href="?page=<%= p %>&status=<%= filters.status %>"
              class="flex h-6 min-w-6 items-center justify-center rounded p-1 text-xs font-medium <%= p === pagination.currentPage ? 'bg-blue-500 text-white' : 'bg-gray-200 hover:bg-gray-300 dark:bg-gray-800 dark:hover:bg-gray-700' %>">
              <%= p %>
            </a>
          <% } %>
        <% }); %>
      </nav>
    </div>
  <% } %>
</div>
