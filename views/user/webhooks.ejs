<div class="flex items-center justify-between card px-4 py-3 mb-4 gap-4">
	<div>
		<h2 class="text-sm font-bold mb-1">Webhooks List</h2>
		<p class="text-xs">
			Manage webhook endpoints for your account events
		</p>
	</div>
	<div class="flex items-center gap-4">
		<a href="/user/webhooks/logs" class="link flex items-center gap-2">
			<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2"/><circle cx="12" cy="12" r="10"/></svg>
			<span class="hidden md:flex">Logs</span>
		</a>
		<a href="/user/webhooks/create" class="flex items-center gap-1 btn-normal text-sm px-2 py-2 md:px-4 md:py-2 rounded-md">
			<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
			<span class="hidden md:flex">Create Webhook</span>
		</a>
	</div>
</div>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
  <!-- Total Webhooks -->
  <div data-aos="zoom-in" class="card p-5">
	<div class="flex items-center justify-between mb-3">
	  <p class="text-xs font-semibold uppercase tracking-wider">Total Webhooks</p>
	  <div class="p-2 bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-lg">
		<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
	  </div>
	</div>
	<h4 class="text-2xl font-bold text-blue-600 dark:text-blue-400"><%= stats.total_webhooks || 0 %></h4>
  </div>

  <!-- Active -->
  <div data-aos="zoom-in" class="card p-5">
	<div class="flex items-center justify-between mb-3">
	  <p class="text-xs font-semibold uppercase tracking-wider">Active</p>
	  <div class="p-2 bg-emerald-50 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 rounded-lg">
		<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
	  </div>
	</div>
	<h4 class="text-2xl font-bold text-emerald-600 dark:text-emerald-400"><%= stats.active_webhooks || 0 %></h4>
  </div>

  <!-- Total Deliveries -->
  <div data-aos="zoom-in" class="card p-5">
	<div class="flex items-center justify-between mb-3">
	  <p class="text-xs font-semibold uppercase tracking-wider">Total Deliveries</p>
	  <div class="p-2 bg-purple-50 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 rounded-lg">
		<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 4H6a2 2 0 00-2 2v12a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-2m-4-1v8m0 0l3-3m-3 3L9 8"/></svg>
	  </div>
	</div>
	<h4 class="text-2xl font-bold text-purple-600 dark:text-purple-400"><%= stats.total_deliveries || 0 %></h4>
  </div>

  <!-- Failed -->
  <div data-aos="zoom-in" class="card p-5">
	<div class="flex items-center justify-between mb-3">
	  <p class="text-xs font-semibold uppercase tracking-wider">Failed</p>
	  <div class="p-2 bg-rose-50 dark:bg-rose-900/30 text-rose-500 dark:text-rose-400 rounded-lg">
		<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
	  </div>
	</div>
	<h4 class="text-2xl font-bold text-rose-500 dark:text-rose-400"><%= stats.failed_deliveries || 0 %></h4>
  </div>
</div>

<div data-aos="zoom-in" class="card">
	<form method="GET" class="flex flex-wrap gap-4 items-end p-5">
		<div class="flex-1 min-w-[200px]">
			<label class="block text-[10px] font-semibold uppercase tracking-wider mb-1">Search</label>
			<input type="text" name="search" value="<%= filters.search %>" placeholder="Name or URL..." class="w-full bg-form px-4 py-2 text-sm rounded-md">
		</div>
		<div class="flex items-center gap-2">
			<button type="submit" class="btn-normal p-2 rounded-md">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24">
					<path d="M0 0h24v24H0z" fill="none"></path>
					<path fill="none" stroke="currentColor" stroke-width="1.5" d="M19 3H5C3.58579 3 2.87868 3 2.43934 3.4122C2 3.8244 2 4.48782 2 5.81466V6.50448C2 7.54232 2 8.06124 2.2596 8.49142C2.5192 8.9216 2.99347 9.18858 3.94202 9.72255L6.85504 11.3624C7.49146 11.7206 7.80967 11.8998 8.03751 12.0976C8.51199 12.5095 8.80408 12.9935 8.93644 13.5872C9 13.8722 9 14.2058 9 14.8729L9 17.5424C9 18.452 9 18.9067 9.25192 19.2613C9.50385 19.6158 9.95128 19.7907 10.8462 20.1406C12.7248 20.875 13.6641 21.2422 14.3321 20.8244C15 20.4066 15 19.4519 15 17.5424V14.8729C15 14.2058 15 13.8722 15.0636 13.5872C15.1959 12.9935 15.488 12.5095 15.9625 12.0976C16.1903 11.8998 16.5085 11.7206 17.145 11.3624L20.058 9.72255C21.0065 9.18858 21.4808 8.9216 21.7404 8.49142C22 8.06124 22 7.54232 22 6.50448V5.81466C22 4.48782 22 3.8244 21.5607 3.4122C21.1213 3 20.4142 3 19 3Z"></path>
				</svg>
			</button>
			<a href="/user/webhooks" class="btn-failed p-2 rounded-md">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24">
					<path d="M0 0h24v24H0z" fill="none"></path>
					<g fill="none" stroke="currentColor" stroke-width="1.5">
						<path stroke-linecap="round" d="M20.5001 6H3.5"></path>
						<path stroke-linecap="round" d="M18.8332 8.5L18.3732 15.3991C18.1962 18.054 18.1077 19.3815 17.2427 20.1907C16.3777 21 15.0473 21 12.3865 21H11.6132C8.95235 21 7.62195 21 6.75694 20.1907C5.89194 19.3815 5.80344 18.054 5.62644 15.3991L5.1665 8.5"></path>
						<path d="M6.5 6C6.55588 6 6.58382 6 6.60915 5.99936C7.43259 5.97849 8.15902 5.45491 8.43922 4.68032C8.44784 4.65649 8.45667 4.62999 8.47434 4.57697L8.57143 4.28571C8.65431 4.03708 8.69575 3.91276 8.75071 3.8072C8.97001 3.38607 9.37574 3.09364 9.84461 3.01877C9.96213 3 10.0932 3 10.3553 3H13.6447C13.9068 3 14.0379 3 14.1554 3.01877C14.6243 3.09364 15.03 3.38607 15.2493 3.8072C15.3043 3.91276 15.3457 4.03708 15.4286 4.28571L15.5257 4.57697C15.5433 4.62992 15.5522 4.65651 15.5608 4.68032C15.841 5.45491 16.5674 5.97849 17.3909 5.99936C17.4162 6 17.4441 6 17.5 6"></path>
					</g>
				</svg>
			</a>
		</div>
	</form>
	
	<div class="space-y-2 divide-y divide-gray-200 dark:divide-gray-800">
		<% if (webhooks.length === 0) { %>
			<div class="px-6 py-16 text-center">
				<h3 class="text-lg font-semibold mb-1">No webhooks configured yet</h3>
				<p class="text-sm">Create a webhook to receive notifications when events happen on your account.</p>
			</div>
		<% } else { %>
		<% webhooks.forEach(wh => { %>
		<div>
			<div class="flex items-start justify-between gap-4 p-4">
				<div class="flex-1 min-w-0">
					<div class="flex items-center gap-2 mb-1">
						<h3 class="text-sm font-bold truncate"><%= wh.name %></h3>
						<span class="text-[10px] px-1.5 py-0.5 rounded-full <%= wh.is_active ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400' : 'bg-gray-200 text-gray-700 dark:bg-gray-800 dark:text-gray-200' %>">
							<%= wh.is_active ? 'Active' : 'Inactive' %>
						</span>
					</div>
					<p class="text-xs font-mono truncate mb-2">
						<%= wh.url %>
					</p>
					<div class="flex flex-wrap gap-1 mb-2">
						<% const events = typeof wh.events === 'string' ? JSON.parse(wh.events) : wh.events; %>
						<% events.forEach(ev => { %>
							<span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-50 text-blue-600 dark:bg-blue-900/20 dark:text-blue-400"><%= ev %></span>
						<% }) %>
					</div>
					<div class="flex items-center gap-4 text-[10px]">
						<span>Deliveries: <%= wh.total_deliveries || 0 %></span>
						<span>Success: <%= wh.success_deliveries || 0 %></span>
						<span>Failed: <%= wh.failed_deliveries || 0 %></span>
						<% if (wh.last_triggered_at) { %>
							<span>Last: <%= new Date(wh.last_triggered_at).toLocaleString('id-ID') %></span>
						<% } %>
					</div>
				</div>
				<div class="flex items-center gap-1 shrink-0">
					<a href="/user/webhooks/<%= wh.id %>" class="p-1.5 rounded-md hover:bg-gray-100 dark:hover:bg-gray-800" title="Logs">
						<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
							<path d="M0 0h24v24H0z" fill="none" />
							<path fill="currentColor" d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2M5 19V5h14v14z" />
							<path fill="currentColor" d="M7 7h10v2H7zm0 4h10v2H7zm0 4h10v2H7z" />
						</svg>
					</a>
					<a href="/user/webhooks/<%= wh.id %>/edit" class="p-1.5 rounded-md hover:bg-gray-100 dark:hover:bg-gray-800" title="Edit">
						<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
							<path d="M0 0h24v24H0z" fill="none" />
							<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
								<path d="m16.475 5.408l2.117 2.117m-.756-3.982L12.109 9.27a2.1 2.1 0 0 0-.58 1.082L11 13l2.648-.53c.41-.082.786-.283 1.082-.579l5.727-5.727a1.853 1.853 0 1 0-2.621-2.621" />
								<path d="M19 15v3a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h3" />
							</g>
						</svg>
					</a>
					<form method="POST" action="/user/webhooks/<%= wh.id %>/toggle" class="inline">
						<button type="submit" class="p-1.5 rounded-md hover:bg-gray-100 dark:hover:bg-gray-800" title="<%= wh.is_active ? 'Disable' : 'Enable' %>">
							<% if (wh.is_active) { %>
							<svg class="text-emerald-500" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
								<path d="M0 0h24v24H0z" fill="none" />
								<path fill="currentColor" d="M11.288 11.713Q11 11.425 11 11V3q0-.425.288-.712T12 2t.713.288T13 3v8q0 .425-.288.713T12 12t-.712-.288m-2.8 8.576q-1.638-.713-2.85-1.925t-1.926-2.85T3 12q0-1.525.5-2.963T4.95 6.4q.275-.35.7-.337t.75.337q.275.275.25.675t-.275.75Q5.7 8.725 5.35 9.8T5 12q0 2.925 2.038 4.963T12 19t4.963-2.037T19 12q0-1.15-.337-2.238T17.6 7.775q-.25-.325-.275-.712t.25-.663q.3-.3.725-.312t.7.312q.975 1.2 1.488 2.625T21 12q0 1.875-.712 3.513t-1.925 2.85t-2.85 1.925T12 21t-3.512-.712" />
							</svg>
							<% } else { %>
							<svg class="text-rose-500" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
								<path d="M0 0h24v24H0z" fill="none" />
								<path fill="currentColor" d="M11.288 11.713Q11 11.425 11 11V3q0-.425.288-.712T12 2t.713.288T13 3v8q0 .425-.288.713T12 12t-.712-.288m-2.8 8.576q-1.638-.713-2.85-1.925t-1.926-2.85T3 12q0-1.525.5-2.963T4.95 6.4q.275-.35.7-.337t.75.337q.275.275.25.675t-.275.75Q5.7 8.725 5.35 9.8T5 12q0 2.925 2.038 4.963T12 19t4.963-2.037T19 12q0-1.15-.337-2.238T17.6 7.775q-.25-.325-.275-.712t.25-.663q.3-.3.725-.312t.7.312q.975 1.2 1.488 2.625T21 12q0 1.875-.712 3.513t-1.925 2.85t-2.85 1.925T12 21t-3.512-.712" />
							</svg>	
							<% } %>
						</button>
					</form>
					<form method="POST" action="/user/webhooks/<%= wh.id %>/delete" class="inline" onsubmit="return confirm('Delete this webhook?')">
						<button type="submit" class="text-rose-500 p-1.5 rounded-md hover:bg-rose-50 dark:hover:bg-rose-900/20" title="Delete">
							<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
								<path d="M0 0h24v24H0z" fill="none"></path>
								<g fill="none" stroke="currentColor" stroke-width="1.5">
									<path stroke-linecap="round" d="M20.5001 6H3.5"></path>
									<path stroke-linecap="round" d="M18.8332 8.5L18.3732 15.3991C18.1962 18.054 18.1077 19.3815 17.2427 20.1907C16.3777 21 15.0473 21 12.3865 21H11.6132C8.95235 21 7.62195 21 6.75694 20.1907C5.89194 19.3815 5.80344 18.054 5.62644 15.3991L5.1665 8.5"></path>
									<path d="M6.5 6C6.55588 6 6.58382 6 6.60915 5.99936C7.43259 5.97849 8.15902 5.45491 8.43922 4.68032C8.44784 4.65649 8.45667 4.62999 8.47434 4.57697L8.57143 4.28571C8.65431 4.03708 8.69575 3.91276 8.75071 3.8072C8.97001 3.38607 9.37574 3.09364 9.84461 3.01877C9.96213 3 10.0932 3 10.3553 3H13.6447C13.9068 3 14.0379 3 14.1554 3.01877C14.6243 3.09364 15.03 3.38607 15.2493 3.8072C15.3043 3.91276 15.3457 4.03708 15.4286 4.28571L15.5257 4.57697C15.5433 4.62992 15.5522 4.65651 15.5608 4.68032C15.841 5.45491 16.5674 5.97849 17.3909 5.99936C17.4162 6 17.4441 6 17.5 6"></path>
								</g>
							</svg>
						</button>
					</form>
				</div>
			</div>
		</div>
		<% }) %>
		<% } %>
	</div>
	<% if (pagination && pagination.totalPages > 1) { %>
		<div class="flex items-center justify-between gap-4 border-t border-gray-200/70 dark:border-gray-800/70 mt-2 p-2">
			<p class="text-xs text-gray-500 dark:text-gray-400">
				Showing 
				<span class="font-medium text-gray-900 dark:text-white"><%= (pagination.currentPage - 1) * pagination.perPage + 1 %>-<%= Math.min(pagination.currentPage * pagination.perPage, pagination.total) %></span>
				from
				<span class="font-medium text-gray-900 dark:text-white"><%= pagination.total %></span>
			</p>

			<nav class="flex items-center gap-1">
				<% pagination.pages.forEach(function(p) { %>
					<% if (p === '...') { %>
						<span class="flex h-6 min-w-6 items-center justify-center px-1 text-xs text-gray-400 dark:text-gray-500">...</span>
					<% } else { %>
						<a href="?page=<%= p %>&search=<%= filters.search || '' %>"
							class="flex h-6 min-w-6 items-center justify-center rounded p-1 text-xs font-medium transition-colors
							<%= p === pagination.currentPage
								? 'bg-blue-500 dark:bg-blue-600 text-white'
								: 'bg-gray-200 hover:bg-gray-300 dark:bg-gray-800 dark:hover:bg-gray-700' %>">
							<%= p %>
						</a>
					<% } %>
				<% }); %>
			</nav>
		</div>
	<% } %>
</div>
