<!-- Profile -->
<div data-aos="zoom-in" class="card p-5 mb-4">
  <div class="flex flex-col lg:flex-row gap-5 lg:items-center justify-between mb-4 border-b border-gray-200/70 dark:border-gray-800/70 pb-4">
    <h3 class="text-sm font-bold">Personal Information</h3>
  </div>
  
  <!-- Avatar Section -->
  <div class="mb-6 flex items-center gap-4">
    <div class="relative">
      <% if (userData.avatar) { %>
        <img src="<%= userData.avatar %>" alt="Avatar" class="w-20 h-20 rounded-full object-cover border-2 border-gray-200 dark:border-gray-700">
      <% } else { %>
        <div class="w-20 h-20 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-white text-2xl font-bold">
          <%= (userData.full_name || userData.username || 'U').charAt(0).toUpperCase() %>
        </div>
      <% } %>
    </div>
    <div>
	  <div class="flex items-center gap-1 min-w-0">
        <h2 class="font-semibold">
		  <%= userData.full_name || userData.username %>
	    </h2>
	    <% if (userData.is_verified) { %>
 	      <span class="text-blue-500 flex-shrink-0">
	        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
	          <path d="M0 0h24v24H0z" fill="none" />
	          <path fill="currentColor" d="M19.965 8.521Q20 8.26 20 8c0-2.379-2.143-4.288-4.521-3.965C14.786 2.802 13.466 2 12 2s-2.786.802-3.479 2.035C6.138 3.712 4 5.621 4 8q0 .26.035.521C2.802 9.215 2 10.535 2 12s.802 2.785 2.035 3.479A4 4 0 0 0 4 16c0 2.379 2.138 4.283 4.521 3.965C9.214 21.198 10.534 22 12 22s2.786-.802 3.479-2.035C17.857 20.283 20 18.379 20 16q0-.26-.035-.521C21.198 14.785 22 13.465 22 12s-.802-2.785-2.035-3.479m-9.01 7.895l-3.667-3.714l1.424-1.404l2.257 2.286l4.327-4.294l1.408 1.42z" />
	        </svg>
	      </span>
        <% } %>
	  </div>
      <p class="text-xs">@<%= userData.username %></p>
    </div>
  </div>

  <form method="POST" action="/user/profile" enctype="multipart/form-data" class="space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1.5">Username</label>
        <input type="text" value="<%= userData.username %>" disabled class="w-full bg-form px-4 py-2 cursor-not-allowed opacity-50 pointer-events-none">
        <p class="text-[10px] mt-1">Username cannot be changed</p>
      </div>
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1.5">Full Name</label>
        <input type="text" name="full_name" value="<%= userData.full_name || '' %>" placeholder="Your full name" class="w-full bg-form px-4 py-2">
      </div>
    </div>
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider mb-1.5">Email</label>
      <input type="email" name="email" value="<%= userData.email %>" disabled class="w-full bg-form px-4 py-2">
    </div>
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider mb-1.5">Avatar</label>
      <input type="file" name="avatar" accept="image/*" class="w-full bg-form px-2 py-2 file:bg-gray-200 dark:file:bg-gray-950 file:text-xs file:px-2 file:py-1 file:rounded">
      <p class="text-[10px] mt-1">Max 2MB. Format: JPG, PNG, GIF, WebP</p>
	</div>
    <button type="submit" class="flex items-center gap-1 btn-normal px-4 py-2 rounded-md">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24">
        <path d="M0 0h24v24H0z" fill="none"></path>
        <g fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3.46447 20.5355C4.92893 22 7.28595 22 12 22C16.714 22 19.0711 22 20.5355 20.5355C22 19.0711 22 16.714 22 12C22 11.6585 22 11.4878 21.9848 11.3142C21.9142 10.5049 21.586 9.71257 21.0637 9.09034C20.9516 8.95687 20.828 8.83317 20.5806 8.58578L15.4142 3.41944C15.1668 3.17206 15.0431 3.04835 14.9097 2.93631C14.2874 2.414 13.4951 2.08581 12.6858 2.01515C12.5122 2 12.3415 2 12 2C7.28595 2 4.92893 2 3.46447 3.46447C2 4.92893 2 7.28595 2 12C2 16.714 2 19.0711 3.46447 20.5355Z"></path>
          <path d="M17 22V21C17 19.1144 17 18.1716 16.4142 17.5858C15.8284 17 14.8856 17 13 17H11C9.11438 17 8.17157 17 7.58579 17.5858C7 18.1716 7 19.1144 7 21V22"></path>
          <path stroke-linecap="round" d="M7 8H13"></path>
        </g>
      </svg>
	  Save Changes
    </button>
  </form>
</div>

<!-- Change Password -->
<div data-aos="zoom-in" class="card p-5 mb-4">
  <div class="flex items-center gap-3 border-b border-gray-200/70 dark:border-gray-800/70 pb-4 mb-4">
    <h3 class="text-sm font-bold">Change Password</h3>
  </div>
  <form method="POST" action="/user/profile" class="space-y-4">
    <input type="hidden" name="full_name" value="<%= userData.full_name || '' %>">
    <input type="hidden" name="email" value="<%= userData.email %>">
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider mb-1.5">Current Password</label>
      <input type="password" name="current_password" placeholder="Enter current password" class="w-full lg:w-auto bg-form px-4 py-2">
    </div>
    <div class="w-full lg:w-auto flex flex-col lg:flex-row lg:items-center gap-4">
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1.5">New Password</label>
        <input type="password" name="new_password" placeholder="Enter new password" class="w-full lg:w-auto bg-form px-4 py-2">
      </div>
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1.5">Confirm New Password</label>
        <input type="password" name="confirm_password" placeholder="Confirm new password" class="w-full lg:w-auto bg-form px-4 py-2">
      </div>
    </div>
    <button type="submit" class="flex items-center gap-1 btn-normal px-4 py-2 rounded-md">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24">
        <path d="M0 0h24v24H0z" fill="none"></path>
        <g fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3.46447 20.5355C4.92893 22 7.28595 22 12 22C16.714 22 19.0711 22 20.5355 20.5355C22 19.0711 22 16.714 22 12C22 11.6585 22 11.4878 21.9848 11.3142C21.9142 10.5049 21.586 9.71257 21.0637 9.09034C20.9516 8.95687 20.828 8.83317 20.5806 8.58578L15.4142 3.41944C15.1668 3.17206 15.0431 3.04835 14.9097 2.93631C14.2874 2.414 13.4951 2.08581 12.6858 2.01515C12.5122 2 12.3415 2 12 2C7.28595 2 4.92893 2 3.46447 3.46447C2 4.92893 2 7.28595 2 12C2 16.714 2 19.0711 3.46447 20.5355Z"></path>
          <path d="M17 22V21C17 19.1144 17 18.1716 16.4142 17.5858C15.8284 17 14.8856 17 13 17H11C9.11438 17 8.17157 17 7.58579 17.5858C7 18.1716 7 19.1144 7 21V22"></path>
          <path stroke-linecap="round" d="M7 8H13"></path>
        </g>
      </svg>
	  Update Password
    </button>
  </form>
</div>

<!-- Account Info -->
<div data-aos="zoom-in" class="card p-5 mb-4">
  <div class="flex items-center gap-3 border-b border-gray-200/70 dark:border-gray-800/70 pb-4 mb-4">
	<h3 class="text-sm font-bold">Account Information</h3>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider mb-1">User ID</label>
      <code class="text-xs font-mono bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded"><%= userData.uuid %></code>
    </div>
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Role</label>
      <span class="inline-flex rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider bg-blue-100 dark:bg-blue-900"><%= userData.role %></span>
    </div>
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Package</label>
      <span class="inline-flex rounded-full bg-gray-200 dark:bg-gray-700 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider"><%= userData.package_name || 'Not yet subscribed' %></span>
    </div>
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Status</label>
      <span class="inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs font-medium <%= userData.is_active ? 'bg-emerald-100 dark:bg-emerald-900' : 'bg-rose-100 dark:bg-rose-900' %>">
        <span class="h-1.5 w-1.5 rounded-full <%= userData.is_active ? 'bg-emerald-600' : 'bg-rose-600' %>"></span>
        <%= userData.is_active ? 'Active' : 'Inactive' %>
      </span>
    </div>
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Credit Balance</label>
      <span class="text-sm font-semibold"><%= userData.credit_balance || 0 %> credits</span>
    </div>
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Joined</label>
      <span class="text-sm"><%= helpers.formatDate(userData.created_at, 'date') %></span>
    </div>
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Last Login</label>
      <span class="text-sm"><%= userData.last_login ? helpers.formatDate(userData.last_login, 'datetime') : 'Never' %></span>
    </div>
    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider mb-1">Last IP</label>
      <code class="text-xs font-mono bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded"><%= userData.last_login_ip || '-' %></code>
    </div>
  </div>
</div>

<!-- Email Verification Status -->
<div data-aos="zoom-in" class="card p-5 space-y-4">
  <div class="flex items-center gap-3 border-b border-gray-200/70 dark:border-gray-800/70 pb-4">
    <h3 class="text-sm font-bold text-gray-900 dark:text-gray-100">Email Verification</h3>
  </div>

  <% if (userData.is_verified) { %>
    <div class="flex flex-col md:flex-row items-center gap-3.5 p-4 rounded-md bg-emerald-100/70 dark:bg-emerald-900/70 border border-gray-200/70 dark:border-gray-800/70">
      <div class="p-2 bg-blue-500 text-white rounded-lg shadow-sm shrink-0">
		<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24">
		  <path d="M0 0h24v24H0z" fill="none"></path>
		  <path fill="currentColor" d="M19.965 8.521Q20 8.26 20 8c0-2.379-2.143-4.288-4.521-3.965C14.786 2.802 13.466 2 12 2s-2.786.802-3.479 2.035C6.138 3.712 4 5.621 4 8q0 .26.035.521C2.802 9.215 2 10.535 2 12s.802 2.785 2.035 3.479A4 4 0 0 0 4 16c0 2.379 2.138 4.283 4.521 3.965C9.214 21.198 10.534 22 12 22s2.786-.802 3.479-2.035C17.857 20.283 20 18.379 20 16q0-.26-.035-.521C21.198 14.785 22 13.465 22 12s-.802-2.785-2.035-3.479m-9.01 7.895l-3.667-3.714l1.424-1.404l2.257 2.286l4.327-4.294l1.408 1.42z"></path>
		</svg>
      </div>
      <div class="space-y-1">
        <h6 class="text-sm font-bold text-center md:text-left">Your email is verified</h6>
        <p class="text-xs text-center md:text-left">Your account has a verified badge. Other users will see a blue checkmark next to your name.</p>
      </div>
    </div>

  <% } else { %>
    <div class="flex flex-col md:flex-row items-center gap-3.5 p-4 rounded-md bg-rose-100/70 dark:bg-rose-900/70 border border-gray-200/70 dark:border-gray-800/70">
      <div class="p-2 bg-gray-500 text-white rounded-lg shadow-sm shrink-0">
		<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
		  <rect x="3" y1="11" width="18" height="11" rx="2" ry="2"/>
		  <path d="M7 11V7a5 5 0 0110 0v4"/>
		</svg>
      </div>
      <div class="flex-1 space-y-1">
        <h6 class="text-sm font-bold text-center md:text-left">Email not verified</h6>
        <p class="text-xs text-center md:text-left">Verify your email to get a blue checkmark badge on your profile.</p>
      </div>
      <a href="/user/verify-email" class="shrink-0 flex items-center gap-2 btn-normal px-4 py-2 rounded-md text-sm">
        Verify Now
		<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
			<path d="M0 0h24v24H0z" fill="none" />
			<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h10v10M7 17L17 7" />
		</svg>
      </a>
    </div>
  <% } %>
</div>
