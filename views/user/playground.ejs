<div class="space-y-4">

	<!-- Header Status Bar -->
	<div data-aos="zoom-in" class="card p-5">
		<div class="flex flex-col md:flex-row gap-4 items-start md:items-center justify-between">
			<div class="flex items-center gap-3 flex-1">
				<div class="flex items-center justify-center h-12 w-12 bg-blue-100 dark:bg-blue-900/30 rounded-xl">
					<svg class="h-7 w-7 text-blue-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16">
						<path d="M0 0h16v16H0z" fill="none" />
						<g fill="currentColor" fill-rule="evenodd">
							<path d="M6.364 13.5a.5.5 0 0 0 .5.5H13.5a1.5 1.5 0 0 0 1.5-1.5v-10A1.5 1.5 0 0 0 13.5 1h-10A1.5 1.5 0 0 0 2 2.5v6.636a.5.5 0 1 0 1 0V2.5a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 .5.5v10a.5.5 0 0 1-.5.5H6.864a.5.5 0 0 0-.5.5" />
							<path d="M11 5.5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0 0 1h3.793l-8.147 8.146a.5.5 0 0 0 .708.708L10 6.707V10.5a.5.5 0 0 0 1 0z" />
						</g>
					</svg>
				</div>
				<div>
					<div class="flex items-center gap-2">
						<h3 class="text-lg font-bold">API Playground</h3>
						<span id="session-status" class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-emerald-50 text-emerald-600 dark:bg-emerald-900/20 dark:text-emerald-400 border border-emerald-200/70 dark:border-emerald-500/20">
							<span class="w-2 h-2 rounded-full bg-emerald-500 mr-2 animate-pulse"></span>Initializing
						</span>
					</div>
					<p class="text-xx">Interactive API testing environment</p>
				</div>
			</div>

			<div class="grid grid-cols-2 gap-4 items-between">
				<div class="flex flex-col justify-center">
					<span id="session-timer" class="text-xl font-mono font-semibold text-blue-500 dark:text-blue-400">--:--</span>
					<label class="text-[10px] font-semibold uppercase tracking-wider mb-0.5 block">Session expires</label>
				</div>
				<div class="flex flex-col justify-center gap-1">
					<div class="relative w-[150px] flex items-center">
						<div class="flex-1 h-6 bg-gray-400 dark:bg-gray-600 rounded-full overflow-hidden">
							<div id="rate-progress" class="h-full bg-gradient-to-r from-blue-500 to-indigo-500 transition-all duration-500" style="width: 100%"></div>
						</div>
						<span id="rate-text" class="absolute left-3 top-1/2 -translate-y-1/2 text-white text-xs font-mono font-semibold">20/20</span>
					</div>
					<label class="text-[10px] font-semibold uppercase tracking-wider mb-0.5 block">Rate Limit</label>
				</div>
			</div>
		</div>
	</div>

	<!-- Main Content Grid -->
	<div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
		<!-- Left Panel: API & Request Builder (col-span-5) -->
		<div class="lg:col-span-5 space-y-4">
			<div data-aos="zoom-in" class="card p-4">
				<h4 class="text-xs font-bold uppercase tracking-wider mb-3 border-b border-gray-200/70 dark:border-gray-800/70 pb-3">Select API</h4>
				<select id="api-select" class="w-full bg-form px-4 py-2">
					<option value="">Loading APIs...</option>
				</select>
			</div>
			<div data-aos="zoom-in" class="card p-4">
				<h4 class="text-xs font-bold uppercase tracking-wider mb-3 border-b border-gray-200/70 dark:border-gray-800/70 pb-3">Available Endpoints</h4>
				<div id="routes-list" class="space-y-2 max-h-64 overflow-y-auto">
				<p class="text-xs text-center py-4">No API selected</p>
				</div>
			</div>
			<div data-aos="zoom-in" class="card p-4" id="request-config" style="display:none;">
				<h4 class="text-xs font-bold uppercase tracking-wider mb-3 border-b border-gray-200/70 dark:border-gray-800/70 pb-3">Request Details</h4>
				<div class="flex items-center gap-2">
					<div class="col-span-1">
						<label class="block text-[10px] font-semibold uppercase tracking-wider mb-1">Method</label>
						<select id="method-select" class="bg-form px-4 py-2">
							<option value="GET">GET</option>
							<option value="POST">POST</option>
							<option value="PUT">PUT</option>
							<option value="DELETE">DELETE</option>
							<option value="PATCH">PATCH</option>
						</select>
					</div>
					<div class="w-full flex-1">
						<label class="block text-[10px] font-semibold uppercase tracking-wider mb-1">Path</label>
						<input type="text" id="path-input" placeholder="/endpoint" class="w-full bg-form px-4 py-2 font-mono">
					</div>
				</div>

				<!-- Tabs -->
				<div class="border-b border-gray-200/70 dark:border-gray-800/70 mb-2 mt-4">
					<div class="flex gap-2">
						<button type="button" onclick="window.playgroundApp.showTab('params')" class="tab-btn tab-active text-xs font-medium px-3 py-1.5 rounded-t-md border-b-2 border-blue-500 text-blue-500 dark:text-blue-400" data-tab="params">Params</button>
						<button type="button" onclick="window.playgroundApp.showTab('auth')" class="tab-btn text-xs font-medium px-3 py-1.5 rounded-t-md border-b-2 border-transparent" data-tab="auth">Auth</button>
						<button type="button" onclick="window.playgroundApp.showTab('headers')" class="tab-btn text-xs font-medium px-3 py-1.5 rounded-t-md border-b-2 border-transparent" data-tab="headers">Headers</button>
						<button type="button" onclick="window.playgroundApp.showTab('body')" class="tab-btn text-xs font-medium px-3 py-1.5 rounded-t-md border-b-2 border-transparent" data-tab="body">Body</button>
					</div>
				</div>

				<!-- Params Tab -->
				<div id="params-tab" class="tab-content space-y-2 mb-4">
					<div class="flex gap-2 items-center params-row">
						<input type="text" placeholder="Key" class="w-full flex-1 px-2 py-1.5 text-xs bg-form param-key">
						<input type="text" placeholder="Value" class="w-full flex-1 px-2 py-1.5 text-xs bg-form param-value">
						<button type="button" onclick="window.playgroundApp.removeParam(this)" class="flex p-1 items-center justify-center btn-failed rounded-full">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">
								<path d="M0 0h24v24H0z" fill="none" />
								<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m18 18l-6-6m0 0L6 6m6 6l6-6m-6 6l-6 6" />
							</svg>
						</button>
					</div>
					<button type="button" onclick="window.playgroundApp.addParam()" class="text-xs link">+ Add Parameter</button>
				</div>

				<!-- Auth Tab -->
				<div id="auth-tab" class="tab-content hidden mb-4">
					<div class="flex flex-col gap-3">
						<div class="flex items-center gap-2">
							<label class="block text-[10px] font-semibold uppercase tracking-wider">Auth Type</label>
							<select id="auth-type" class="bg-form px-3 py-1.5 text-xs" onchange="window.playgroundApp.authTypeChanged()">
								<option value="none">No Auth</option>
								<option value="apikey">API Key</option>
								<option value="bearer">Bearer Token</option>
								<option value="basic">Basic Auth</option>
							</select>
						</div>

						<!-- API Key Config -->
						<div id="auth-apikey" class="hidden space-y-2">
							<div class="flex gap-2 items-center">
								<input type="text" id="auth-apikey-name" placeholder="Header / Param name" value="X-API-Key" class="w-full flex-1 px-2 py-1.5 text-xs bg-form">
								<select id="auth-apikey-location" class="bg-form px-2 py-1.5 text-xs">
									<option value="header">Header</option>
									<option value="query">Query Param</option>
								</select>
							</div>
							<input type="text" id="auth-apikey-value" placeholder="Enter API key value" class="w-full px-2 py-1.5 text-xs bg-form font-mono">
						</div>

						<!-- Bearer Token Config -->
						<div id="auth-bearer" class="hidden">
							<input type="text" id="auth-bearer-token" placeholder="Enter bearer token (e.g. eyJhbG...)" class="w-full px-2 py-1.5 text-xs bg-form font-mono">
						</div>

						<!-- Basic Auth Config -->
						<div id="auth-basic" class="hidden space-y-2">
							<input type="text" id="auth-basic-username" placeholder="Username" class="w-full px-2 py-1.5 text-xs bg-form">
							<input type="password" id="auth-basic-password" placeholder="Password" class="w-full px-2 py-1.5 text-xs bg-form">
						</div>

						<p id="auth-hint" class="text-[10px] text-gray-400 mt-1 hidden"></p>
					</div>
				</div>

				<!-- Headers Tab -->
				<div id="headers-tab" class="tab-content hidden space-y-2 mb-4">
					<div class="flex gap-2 items-center header-row">
						<input type="text" placeholder="Key" value="Content-Type" class="w-full flex-1 px-2 py-1.5 text-xs bg-form header-key">
						<input type="text" placeholder="Value" value="application/json" class="w-full flex-1 px-2 py-1.5 text-xs bg-form header-value">
						<button type="button" onclick="this.closest('.header-row').remove()" class="flex p-1 items-center justify-center btn-failed rounded-full">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">
								<path d="M0 0h24v24H0z" fill="none" />
								<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m18 18l-6-6m0 0L6 6m6 6l6-6m-6 6l-6 6" />
							</svg>
						</button>
					</div>
					<button type="button" onclick="window.playgroundApp.addHeader()" class="text-xs link">+ Add Header</button>
				</div>

				<!-- Body Tab -->
				<div id="body-tab" class="tab-content hidden mb-4">
					<div class="flex items-center gap-2 mb-3">
						<label class="block text-[10px] font-semibold uppercase tracking-wider">Body Type</label>
						<select id="body-type" class="bg-form px-3 py-1.5 text-xs" onchange="window.playgroundApp.bodyTypeChanged()">
							<option value="json">JSON</option>
							<option value="formdata">Form Data</option>
						</select>
					</div>

					<!-- JSON Body -->
					<div id="body-json">
						<textarea id="body-input" rows="10" class="w-full px-3 py-2 text-xs font-mono bg-form resize-none"></textarea>
						<p class="text-[10px] mt-1">JSON format supported. Press Ctrl+Enter to send.</p>
					</div>

					<!-- Form Data Body -->
					<div id="body-formdata" class="hidden space-y-2">
						<div id="formdata-fields" class="space-y-2">
							<div class="flex gap-2 items-center formdata-row" data-type="text">
								<select class="bg-form px-2 py-1.5 text-xs formdata-type" onchange="window.playgroundApp.formDataTypeChanged(this)">
									<option value="text">Text</option>
									<option value="file">File</option>
								</select>
								<input type="text" placeholder="Key" class="w-full flex-1 px-2 py-1.5 text-xs bg-form formdata-key">
								<input type="text" placeholder="Value" class="w-full flex-1 px-2 py-1.5 text-xs bg-form formdata-value">
								<button type="button" onclick="window.playgroundApp.removeFormDataField(this)" class="flex p-1 items-center justify-center btn-failed rounded-full">
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M0 0h24v24H0z" fill="none"/><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m18 18l-6-6m0 0L6 6m6 6l6-6m-6 6l-6 6"/></svg>
								</button>
							</div>
						</div>
						<button type="button" onclick="window.playgroundApp.addFormDataField('text')" class="text-xs link">+ Add Field</button>
						<button type="button" onclick="window.playgroundApp.addFormDataField('file')" class="ml-2 text-xs link">+ Add File</button>
						<p class="text-[10px] mt-1">Content-Type: multipart/form-data</p>
					</div>
				</div>

				<!-- Send Button -->
				<div class="flex items-center justify-center lg:justify-end">
					<button type="button" onclick="window.playgroundApp.sendRequest()" id="send-btn" class="lg:max-w-xs py-3 px-4 btn-normal rounded-md flex items-center gap-2 justify-center">
						<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
						</svg>
						Send Request
					</button>
				</div>
			</div>

			<!-- Response Panel -->
			<div class="space-y-4">
				<div data-aos="zoom-in" class="card p-4">
					<div class="flex items-center justify-between mb-3 border-b border-gray-200/70 dark:border-gray-800/70 pb-3">
						<h4 class="text-xs font-bold uppercase tracking-wider">Response</h4>
						<div class="flex items-center gap-2">
							<button type="button" onclick="window.playgroundApp.copyResponse()" id="copy-btn" class="text-xs link" disabled>Copy</button>
							<button type="button" onclick="window.playgroundApp.clearResponse()" id="clear-btn" class="text-xs link-rose" disabled>Clear</button>
						</div>
					</div>

					<div class="flex items-center gap-3 text-xs mb-2 pb-2 border-b border-gray-200/70 dark:border-gray-800/70">
						<div class="flex items-center gap-2">
							<span id="response-status" class="font-mono font-bold">&mdash;</span>
							<span id="status-label" class="font-mono font-bold">Waiting</span>
						</div>
						<span id="response-time" class="font-mono font-bold">&mdash;</span>
						<span class="ml-auto px-2 py-0.5 rounded bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400 text-[10px] font-bold">FREE</span>
					</div>
					<div id="response-body" class="bg-form p-3 overflow-auto" style="min-height: 200px; max-height: calc(100vh - 24rem);">
						<pre id="response-json" class="select-text text-xs font-mono whitespace-pre-wrap m-0"><span>No response yet. Configure your request and click Send.</span></pre>
					</div>
				</div>
			</div>

			<!-- Recent Requests History -->
			<div data-aos="zoom-in" class="card p-4">
				<h4 class="text-xs font-bold uppercase tracking-wider mb-3 border-b border-gray-200/70 dark:border-gray-800/70 pb-3">Recent Requests</h4>
				<div id="request-history" class="flex flex-col gap-2 max-h-80 overflow-y-auto pr-1">
					<p class="text-xs col-span-full text-center py-4">No requests yet</p>
				</div>
			</div>
		</div>

		<!-- Center Panel: Documentation -->
		<div class="lg:col-span-7 space-y-4 self-start sticky top-20">
			<div data-aos="zoom-in" class="card p-4" id="docs-panel" style="display:none;">
				<div id="docs-content" class="prose dark:prose-invert max-w-none select-text space-y-4 max-h-[calc(100vh-10rem)] overflow-y-auto pr-1">
				</div>
			</div>

			<div data-aos="zoom-in" class="card p-4" id="no-route-selected">
				<div class="text-center py-12">
					<h3 class="text-sm font-semibold mb-2">Select an Endpoint</h3>
					<p class="text-xs">
						Choose an API and endpoint from the left panel to see its documentation
					</p>
				</div>
			</div>
		</div>
  </div>

</div>
<%
pageScript = `
<script src="/js/playground.js"></script>

`;
%>
