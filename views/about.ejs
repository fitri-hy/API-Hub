<!-- HERO -->
<section class="container mx-auto px-4 py-12 lg:px-12 lg:py-20">
	<div class="mx-auto max-w-3xl text-center">
		<span class="inline-flex items-center gap-1.5 rounded-full border border-blue-200/20 bg-blue-100/50 px-3 py-1 text-xs font-semibold text-blue-600 dark:border-blue-700/20 dark:bg-blue-950/50 dark:text-sky-400">
			About Us
		</span>
		<h1 class="mt-4 text-4xl font-black tracking-tighter sm:text-5xl">
			<span class="font-serif font-normal italic">Built for Developers</span>
		</h1>
		<p class="mt-4 text-lg">
			We're making API integration simple, reliable, and accessible for everyone.
		</p>
	</div>
</section>

<!-- Mission -->
<section class="container mx-auto px-4 py-12 lg:px-12">
	<div class="mx-auto grid max-w-5xl grid-cols-1 items-center gap-12 lg:grid-cols-2">
		<div class="space-y-6">
			<span class="inline-flex items-center gap-1.5 rounded-full border border-blue-200/20 bg-blue-100/50 px-3 py-1 text-xs font-semibold text-blue-600 dark:border-blue-700/20 dark:bg-blue-950/50 dark:text-sky-400">
				Our Mission
			</span>
			<h2 class="text-3xl font-black tracking-tighter">
				<span class="font-serif font-normal italic">Simplifying API Access</span>
			</h2>
			<p class="leading-relaxed">
				We believe developers shouldn't waste time managing dozens of API integrations.
				Our platform provides a single gateway to hundreds of endpoints — one API key,
				consistent authentication, and a credit-based system that keeps costs transparent.
			</p>
			<p class="leading-relaxed">
				Whether you're building a side project or scaling a production application,
				our infrastructure is designed to handle your workload with reliability and speed.
			</p>
		</div>

		<div class="relative mx-auto w-full max-w-md">
			<div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-sky-500 via-indigo-500 to-emerald-500 opacity-5 blur-2xl dark:opacity-10"></div>
			<div class="relative grid grid-cols-2 gap-4">
				<div class="overflow-hidden card p-5">
					<div class="text-3xl text-center font-black text-blue-600 dark:text-sky-400"><%= stats.apiCount %>+</div>
					<div class="mt-1 text-center text-sm font-medium">APIs Available</div>
				</div>
				<div class="overflow-hidden card p-5">
					<div class="text-3xl text-center font-black text-emerald-600 dark:text-emerald-400">99.9%</div>
					<div class="mt-1 text-center text-sm font-medium">Uptime SLA</div>
				</div>
				<div class="overflow-hidden card p-5">
					<div class="text-3xl text-center font-black text-indigo-600 dark:text-indigo-400"><%= stats.endpointCount %>+</div>
					<div class="mt-1 text-center text-sm font-medium">Endpoints</div>
				</div>
				<div class="overflow-hidden card p-5">
					<div class="text-3xl text-center font-black text-sky-600 dark:text-sky-400">24/7</div>
					<div class="mt-1 text-center text-sm font-medium">Infrastructure</div>
				</div>
			</div>
		</div>
	</div>
</section>

