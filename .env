# ============================================
# Server
# ============================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ============================================
# Session
# ============================================
SESSION_SECRET=0ccafa5ef4e35d05d50a294569689c0e3338694a900f2e3411ff577b6a0222fa73326c0da3c6d21806560a5bdec422e4df21850494b0c2364ff62a3a829407e0=
SESSION_COOKIE_NAME=sgw.sid
SESSION_MAX_AGE=86400000
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ============================================
# Security - Helmet
# ============================================
HELMET_CSP=false
HELMET_CROSS_ORIGIN_EMBEDDER_POLICY=true

# ============================================
# Security - CORS
# ============================================
CORS_ORIGIN=http://localhost:3000
CORS_SOCKET=http://localhost:3000
CORS_CREDENTIALS=true

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ============================================
# Database
# ============================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=saas_gateway

DB_WAIT_FOR_CONNECTIONS=true
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=0
DB_ENABLE_KEEP_ALIVE=true
DB_KEEP_ALIVE_INITIAL_DELAY=0
DB_NAMED_PLACEHOLDERS=true
DB_CHARSET=utf8mb4
DB_TIMEZONE=+07:00
DB_DATE_STRINGS=true

# ============================================
# App
# ============================================
APP_NAME=ApiHub
APP_URL=http://localhost:3000
DEFAULT_CREDIT=100
CREDIT_VALUE_RP=50
NEW_USER_BONUS_ENABLED=true
NEW_USER_BONUS_CREDITS=50

# ============================================
# Script Tools (FFmpeg & yt-dlp)
# ============================================
SCRIPT_FFMPEG_PATH=ffmpeg
SCRIPT_FFPROBE_PATH=ffprobe
SCRIPT_YTDLP_PATH=yt-dlp
SCRIPT_FFMPEG_CONCURRENCY=10
SCRIPT_YTDLP_CONCURRENCY=10
SCRIPT_PUPPETEER_CONCURRENCY=2
SCRIPT_FFMPEG_TIMEOUT=300000
SCRIPT_YTDLP_TIMEOUT=600000
SCRIPT_PUPPETEER_TIMEOUT=120000
SCRIPT_TEMP_DIR=
PUPPETEER_ARGS=

# ============================================
# Temp File TTL & Cleanup
# ============================================
FILE_TTL_MS=60000
TEMP_CLEANUP_MAX_AGE_MS=120000
TEMP_CLEANUP_INTERVAL_MS=300000

# ============================================
# Body Parser
# ============================================
BODY_JSON_LIMIT=1mb
BODY_URLENCODED_LIMIT=1mb
BODY_EXTENDED=true

# ============================================
# Method Override
# ============================================
METHOD_OVERRIDE_KEY=_method