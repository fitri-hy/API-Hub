{
  "name": "api-hub",
  "version": "1.0.0",
  "description": "Professional SaaS API Hub & Gateway",
  "main": "server.js",
  "scripts": {
    "start": "npm run tailwind:build && node server.js",
    "dev": "concurrently \"npm run tailwind:watch\" \"nodemon server.js\"",
    "tailwind:build": "npx @tailwindcss/cli -i ./public/css/input.css -o ./public/css/output.css",
    "tailwind:watch": "npx @tailwindcss/cli -i ./public/css/input.css -o ./public/css/output.css --watch",
    "db:init": "node config/db-init.js",
    "scripts:check": "node script/setup.js check",
    "scripts:setup": "node script/setup.js install",
    "temp:cleanup": "node script/tempCleanup.js",
    "temp:cron:setup": "bash scripts/setup-cron.sh",
    "temp:cron:setup:win": "scripts\\setup-cron.bat"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "canvas": "^3.2.3",
    "cheerio": "^1.2.0",
    "connect-flash": "^0.1.1",
    "cors": "^2.8.5",
    "cron": "^3.2.1",
    "dayjs": "^1.11.23",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsqr": "^1.4.0",
    "marked": "^15.0.12",
    "method-override": "^3.0.0",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.11.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.13",
    "puppeteer": "^25.11.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.7",
    "tailwindcss": "^4.0.0"
  }
}
